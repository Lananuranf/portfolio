---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import MainLayout from '../layouts/MainLayout.astro';
import HeroIsland from '../components/HeroIsland.tsx';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Maulana Nur Anfajm (Lananuranf) | Backend Engineer"
  description="Maulana Nur Anfajm (Lananuranf), Backend Engineer dan mahasiswa Sistem Informasi Gunadarma. Saya membangun REST API dengan Go, Rust, dan PostgreSQL."
  canonicalURL="https://lananuranf.my.id/"
  isHome
>
  <MainLayout />
  <main id="main-content">
    <HeroIsland client:load />
    <AboutSection />
    <SkillsSection />
    <ProjectsSection />
    <BlogTeaser />
    <ContactSection />
  </main>
  <Footer />
</BaseLayout>
