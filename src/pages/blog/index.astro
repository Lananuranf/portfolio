---
// src/pages/blog/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { POSTS } from "../../data/posts";

const ALL_TAGS = [...new Set(POSTS.flatMap((p) => p.tags))].sort((a, b) => a.localeCompare(b));

const blogSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Blog Lananuranf",
    url: "https://lananuranf.my.id/blog/",
    inLanguage: "id",
    author: {
        "@type": "Person",
        name: "Maulana Nur Anfajm",
        alternateName: "Lananuranf",
    },
    blogPost: POSTS.filter((p) => p.published).map((p) => ({
        "@type": "BlogPosting",
        headline: p.title,
        url: `https://lananuranf.my.id${p.slug}`,
        description: p.desc,
        author: { "@type": "Person", name: "Maulana Nur Anfajm" },
    })),
});
---

<BaseLayout
    title="Blog Backend Engineering | Lananuranf"
    description="Catatan teknis Maulana Nur Anfajm (Lananuranf): checkout aman di Go dan PostgreSQL, reservasi Rust tanpa double booking, Laravel, dan benchmark Go Fiber."
    canonicalURL="https://lananuranf.my.id/blog/"
    breadcrumbs={[{ name: "Blog", url: "https://lananuranf.my.id/blog/" }]}
    extraSchema={blogSchema}
>
    <MainLayout />

    <main
        id="main-content" class="pt-24 min-h-screen bg-surface"
    >
        <div class="max-w-4xl mx-auto px-6 py-16">
            <div class="mb-12">
                <a
                    href="/"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted hover:text-rose-deep transition-colors mb-6"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-4 h-4"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
                        />
                    </svg>
                    Kembali ke Portfolio
                </a>
                <p class="text-xs font-semibold tracking-widest text-rose-deep uppercase mb-2">
                    Artikel teknis
                </p>
                <h1 class="text-4xl font-extrabold text-ink">Blog Backend</h1>
                <p class="text-ink-muted mt-2 text-sm max-w-xl">
                    Catatan dan tutorial backend. Langkah di setiap artikel sudah saya coba sendiri.
                </p>
            </div>

            <!-- Pencarian & filter tag (sisi klien) -->
            <div class="blog-tools glass-card rounded-2xl p-4 sm:p-5 mb-8 flex flex-col gap-4" data-reveal>
                <label class="relative block">
                    <span class="sr-only">Cari artikel</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-muted pointer-events-none" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m20 20-3.5-3.5" />
                    </svg>
                    <input id="blog-search" type="search" autocomplete="off" placeholder="Cari judul, isi ringkas, atau tag…"
                        class="w-full min-w-0 h-11 pl-10 pr-4 rounded-xl bg-white/80 ring-1 ring-line text-sm text-ink placeholder:text-ink-muted/80 outline-none focus:ring-2 focus:ring-rose-brand transition-shadow" />
                </label>
                <div class="flex flex-wrap gap-2" role="group" aria-label="Filter berdasarkan tag">
                    <button type="button" data-tag="" aria-pressed="true" class="tag-chip">Semua</button>
                    {ALL_TAGS.map((t) => (
                        <button type="button" data-tag={t} aria-pressed="false" class="tag-chip font-mono">{t}</button>
                    ))}
                </div>
                <p id="blog-count" class="text-xs text-ink-muted" aria-live="polite"></p>
            </div>

            <p id="blog-empty" hidden class="post-pop glass-card rounded-2xl p-8 text-center text-sm text-ink-muted mb-6">
                Tidak ada artikel yang cocok. Coba kata kunci atau tag lain.
            </p>

            <div id="blog-list" class="flex flex-col gap-6">
                {POSTS.map((post) => (
                    <article
                        data-post
                        data-reveal
                        data-tags={post.tags.join("|")}
                        data-search={`${post.title} ${post.desc} ${post.tags.join(" ")}`.toLowerCase()}
                        class={`glass-card rounded-2xl overflow-hidden ${post.published ? "lift" : "opacity-70"}`}
                    >
                        <div class="p-7 flex flex-col md:flex-row gap-5">
                            <div class="flex-1 flex flex-col gap-3">
                                <div class="flex flex-wrap items-center gap-3">
                                    <span
                                        class={`text-xs font-semibold px-2.5 py-1 rounded-full ${post.published ? "bg-pink-soft text-rose-deep border border-pink-brand/50" : "bg-lavender-soft text-lavender-deep border border-lavender"}`}
                                    >
                                        {post.published ? "Terbit" : "Draf"}
                                    </span>
                                    <span class="text-xs text-ink-muted">
                                        {post.date}
                                    </span>
                                    {post.readTime && (
                                        <span class="text-xs text-ink-muted">
                                            · {post.readTime}
                                        </span>
                                    )}
                                    {post.published && (
                                        <span
                                            data-stats-for={post.slug
                                                .split("/")
                                                .filter(Boolean)
                                                .pop()}
                                            hidden
                                            class="text-xs text-ink-muted"
                                        >
                                            ·{" "}
                                            <b
                                                data-v
                                                class="font-semibold text-ink"
                                            >
                                                0
                                            </b>{" "}
                                            kali dibaca · terakhir dibaca{" "}
                                            <b
                                                data-l
                                                class="font-semibold text-ink"
                                            >
                                                —
                                            </b>
                                        </span>
                                    )}
                                </div>
                                <h2 class="text-lg font-bold text-ink leading-snug">
                                    {post.published ? (
                                        <a
                                            href={post.slug}
                                            class="hover:text-rose-deep transition-colors"
                                        >
                                            {post.title}
                                        </a>
                                    ) : (
                                        post.title
                                    )}
                                </h2>
                                <p class="text-ink-muted text-sm leading-relaxed">
                                    {post.desc}
                                </p>
                                <div class="flex flex-wrap gap-1.5">
                                    {post.tags.map((t) => (
                                        <span class="text-xs font-medium font-mono px-2.5 py-1 bg-lavender-soft rounded-full text-lavender-deep">
                                            {t}
                                        </span>
                                    ))}
                                </div>
                            </div>
                            {post.published && (
                                <div class="flex items-center shrink-0">
                                    <a
                                        href={post.slug}
                                        class="flex items-center gap-2 px-5 py-2.5 bg-rose-deep text-white text-sm font-semibold rounded-xl hover:bg-ink transition-colors whitespace-nowrap"
                                    >
                                        Baca →
                                    </a>
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    import { relativeTime } from "../../lib/liveStats";

    // ── Cari & filter tag (sisi klien) ──
    {
        const input = document.getElementById("blog-search") as HTMLInputElement | null;
        const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tag]"));
        const posts = Array.from(document.querySelectorAll<HTMLElement>("[data-post]"));
        const empty = document.getElementById("blog-empty");
        const count = document.getElementById("blog-count");
        let tag = "";
        const apply = () => {
            const q = (input?.value ?? "").trim().toLowerCase();
            const words = q.split(/\s+/).filter(Boolean);
            let n = 0;
            for (const p of posts) {
                const hay = p.dataset.search ?? "";
                const tags = (p.dataset.tags ?? "").split("|");
                const ok = (!tag || tags.includes(tag)) && words.every((w) => hay.includes(w));
                if (ok) {
                    n++;
                    if (p.hidden) {
                        p.hidden = false;
                        p.classList.add("is-in");
                        p.classList.remove("post-pop");
                        void p.offsetWidth;
                        p.classList.add("post-pop");
                    }
                } else {
                    p.hidden = true;
                }
            }
            if (empty) empty.hidden = n > 0;
            if (count) count.textContent = q || tag ? `${n} dari ${posts.length} artikel` : `${posts.length} artikel`;
        };
        input?.addEventListener("input", apply);
        chips.forEach((c) =>
            c.addEventListener("click", () => {
                tag = c.dataset.tag === tag ? "" : (c.dataset.tag ?? "");
                chips.forEach((x) => x.setAttribute("aria-pressed", String((x.dataset.tag ?? "") === tag)));
                apply();
            }),
        );
        apply();
    }

    // Statistik pembaca diperbarui setiap 20 detik selama tab terbuka.
    const els = Array.from(
        document.querySelectorAll<HTMLElement>("[data-stats-for]"),
    );
    const slugs = els.map((e) => e.dataset.statsFor).join(",");
    let last: Record<string, number | null> = {};

    const render = () =>
        els.forEach((e) => {
            const t = last[e.dataset.statsFor!];
            (e.querySelector("[data-l]") as HTMLElement).textContent = t
                ? relativeTime(t)
                : "belum ada";
        });

    const load = async () => {
        if (document.hidden || !slugs) return;
        try {
            const r = await fetch(`/api/views?slugs=${slugs}`);
            const d = await r.json();
            if (!r.ok || !d.enabled) return;
            els.forEach((e) => {
                const st = d.stats[e.dataset.statsFor!];
                if (!st) return;
                (e.querySelector("[data-v]") as HTMLElement).textContent =
                    Number(st.views).toLocaleString("id-ID");
                last[e.dataset.statsFor!] = st.lastRead;
                e.hidden = false;
            });
            render();
        } catch {}
    };

    load();
    setInterval(load, 20000);
    document.addEventListener("visibilitychange", load);
</script>
