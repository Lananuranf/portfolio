---
// src/pages/blog/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import { POSTS } from "../../data/posts";

const blogSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Blog Teknis Lananuranf",
    url: "https://lananuranf.my.id/blog/",
    author: {
        "@type": "Person",
        name: "Maulana Nur Anfajm",
        alternateName: "Lananuranf",
    },
    blogPost: POSTS.filter((p) => p.published).map((p) => ({
        "@type": "BlogPosting",
        headline: p.title,
        url: `https://lananuranf.my.id${p.slug}`,
        description: p.desc,
        author: { "@type": "Person", name: "Maulana Nur Anfajm" },
    })),
});
---

<BaseLayout
    title="Blog Teknis · Maulana Nur Anfajm (Lananuranf) | Tutorial Backend Engineering"
    description="Artikel teknis Maulana Nur Anfajm (Lananuranf): tutorial deploy Go Fiber + Docker ke AWS EC2, benchmark REST API, dan catatan backend lainnya."
    canonicalURL="https://lananuranf.my.id/blog/"
    extraSchema={blogSchema}
>
    <MainLayout />

    <main
        id="main-content" class="pt-24 min-h-screen bg-surface"
    >
        <div class="max-w-4xl mx-auto px-6 py-16">
            <div class="mb-12">
                <a
                    href="/"
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted hover:text-rose-deep transition-colors mb-6"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="w-4 h-4"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
                        />
                    </svg>
                    Kembali ke Portfolio
                </a>
                <p class="text-xs font-semibold tracking-widest text-rose-deep uppercase mb-2">
                    Artikel teknis
                </p>
                <h1 class="text-4xl font-extrabold text-ink">Blog</h1>
                <p class="text-ink-muted mt-2 text-sm max-w-xl">
                    Catatan dan tutorial backend. Langkah di setiap artikel sudah saya coba sendiri.
                </p>
            </div>

            <div class="flex flex-col gap-6">
                {POSTS.map((post) => (
                    <article
                        class={`bg-white rounded-2xl border shadow-sm motion-reduce:transform-none overflow-hidden transition-all duration-200 ${post.published ? "border-line hover:-translate-y-0.5 hover:border-pink-brand hover:shadow-[0_12px_28px_-16px_rgba(217,67,122,0.45)]" : "border-line opacity-70"}`}
                    >
                        <div class="p-7 flex flex-col md:flex-row gap-5">
                            <div class="flex-1 flex flex-col gap-3">
                                <div class="flex flex-wrap items-center gap-3">
                                    <span
                                        class={`text-xs font-semibold px-2.5 py-1 rounded-full ${post.published ? "bg-pink-soft text-rose-deep border border-pink-brand/50" : "bg-lavender-soft text-lavender-deep border border-lavender"}`}
                                    >
                                        {post.published ? "Terbit" : "Draf"}
                                    </span>
                                    <span class="text-xs text-ink-muted">
                                        {post.date}
                                    </span>
                                    {post.readTime && (
                                        <span class="text-xs text-ink-muted">
                                            · {post.readTime}
                                        </span>
                                    )}
                                    {post.published && (
                                        <span
                                            data-stats-for={post.slug
                                                .split("/")
                                                .filter(Boolean)
                                                .pop()}
                                            hidden
                                            class="text-xs text-ink-muted"
                                        >
                                            ·{" "}
                                            <b
                                                data-v
                                                class="font-semibold text-ink"
                                            >
                                                0
                                            </b>{" "}
                                            kali dibaca · terakhir dibaca{" "}
                                            <b
                                                data-l
                                                class="font-semibold text-ink"
                                            >
                                                —
                                            </b>
                                        </span>
                                    )}
                                </div>
                                <h2 class="text-lg font-bold text-ink leading-snug">
                                    {post.published ? (
                                        <a
                                            href={post.slug}
                                            class="hover:text-rose-deep transition-colors"
                                        >
                                            {post.title}
                                        </a>
                                    ) : (
                                        post.title
                                    )}
                                </h2>
                                <p class="text-ink-muted text-sm leading-relaxed">
                                    {post.desc}
                                </p>
                                <div class="flex flex-wrap gap-1.5">
                                    {post.tags.map((t) => (
                                        <span class="text-xs font-medium font-mono px-2.5 py-1 bg-lavender-soft rounded-full text-lavender-deep">
                                            {t}
                                        </span>
                                    ))}
                                </div>
                            </div>
                            {post.published && (
                                <div class="flex items-center shrink-0">
                                    <a
                                        href={post.slug}
                                        class="flex items-center gap-2 px-5 py-2.5 bg-rose-deep text-white text-sm font-semibold rounded-xl hover:bg-ink transition-colors whitespace-nowrap"
                                    >
                                        Baca →
                                    </a>
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </main>
    <Footer />
</BaseLayout>

<script>
    import { relativeTime } from "../../lib/liveStats";

    // Statistik pembaca diperbarui setiap 20 detik selama tab terbuka.
    const els = Array.from(
        document.querySelectorAll<HTMLElement>("[data-stats-for]"),
    );
    const slugs = els.map((e) => e.dataset.statsFor).join(",");
    let last: Record<string, number | null> = {};

    const render = () =>
        els.forEach((e) => {
            const t = last[e.dataset.statsFor!];
            (e.querySelector("[data-l]") as HTMLElement).textContent = t
                ? relativeTime(t)
                : "belum ada";
        });

    const load = async () => {
        if (document.hidden || !slugs) return;
        try {
            const r = await fetch(`/api/views?slugs=${slugs}`);
            const d = await r.json();
            if (!r.ok || !d.enabled) return;
            els.forEach((e) => {
                const st = d.stats[e.dataset.statsFor!];
                if (!st) return;
                (e.querySelector("[data-v]") as HTMLElement).textContent =
                    Number(st.views).toLocaleString("id-ID");
                last[e.dataset.statsFor!] = st.lastRead;
                e.hidden = false;
            });
            render();
        } catch {}
    };

    load();
    setInterval(load, 20000);
    document.addEventListener("visibilitychange", load);
</script>
