---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { POSTS } from '../../data/posts';

const blogSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog Teknis Lananuranf",
  "url": "https://lananuranf.my.id/blog/",
  "author": { "@type": "Person", "name": "Maulana Nur Anfajm", "alternateName": "Lananuranf" },
  "blogPost": POSTS.filter(p => p.published).map(p => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "url": `https://lananuranf.my.id${p.slug}`,
    "description": p.desc,
    "author": { "@type": "Person", "name": "Maulana Nur Anfajm" }
  }))
});
---

<BaseLayout
  title="Blog Teknis — Maulana Nur Anfajm (Lananuranf) | Tutorial Software Engineering"
  description="Artikel teknis Maulana Nur Anfajm (Lananuranf): tutorial deploy fullstack React + Go Fiber ke AWS EC2 dan web development."
  canonicalURL="https://lananuranf.my.id/blog/"
  extraSchema={blogSchema}
>
  <MainLayout />

  <main class="pt-20 min-h-screen" style="background: linear-gradient(155deg,#f0f9ff 0%,#e0f2fe 20%,#f8fafc 55%,#f0fdf4 80%,#dcfce7 100%);">
    <div class="max-w-4xl mx-auto px-6 py-16">

      <div class="mb-12">
        <a href="/" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-800 transition-colors mb-6">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
          Kembali ke Portfolio
        </a>
        <p class="text-xs font-semibold tracking-widest text-slate-400 uppercase mb-2">Artikel teknis</p>
        <h1 class="text-4xl font-extrabold text-slate-900">Blog</h1>
        <p class="text-slate-500 mt-2 text-sm max-w-xl">
          Catatan pengalaman, tutorial, dan studi kasus dari proyek yang pernah saya kerjakan.
          Semuanya berdasarkan praktik langsung.
        </p>
      </div>

      <div class="flex flex-col gap-6">
        {POSTS.map(post => (
          <article class={`bg-white rounded-3xl border shadow-sm overflow-hidden transition-all duration-200 ${post.published ? "border-slate-200 hover:-translate-y-1 hover:shadow-md" : "border-slate-100 opacity-60"}`}>
            <div class="p-7 flex flex-col md:flex-row gap-5">
              <div class="flex-1 flex flex-col gap-3">
                <div class="flex flex-wrap items-center gap-3">
                  <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${post.published ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-50 text-slate-400 border border-slate-200"}`}>
                    {post.published ? "Terbit" : "Draf"}
                  </span>
                  <span class="text-xs text-slate-400">{post.date}</span>
                  {post.readTime && <span class="text-xs text-slate-400">· {post.readTime}</span>}
                  {post.published && (
                    <span data-stats-for={post.slug.split("/").filter(Boolean).pop()} hidden class="text-xs text-slate-400">
                      · <b data-v class="font-semibold text-slate-600">0</b> kali dibaca · terakhir dibaca <b data-l class="font-semibold text-slate-600">—</b>
                    </span>
                  )}
                </div>
                <h2 class="text-lg font-bold text-slate-900 leading-snug">
                  {post.published
                    ? <a href={post.slug} class="hover:text-sky-600 transition-colors">{post.title}</a>
                    : post.title
                  }
                </h2>
                <p class="text-slate-500 text-sm leading-relaxed">{post.desc}</p>
                <div class="flex flex-wrap gap-1.5">
                  {post.tags.map(t => (
                    <span class="text-xs font-medium px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-full text-slate-500">{t}</span>
                  ))}
                </div>
              </div>
              {post.published && (
                <div class="flex items-center flex-shrink-0">
                  <a href={post.slug} class="flex items-center gap-2 px-5 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-xl hover:bg-slate-700 transition-colors whitespace-nowrap">
                    Baca →
                  </a>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

    </div>
  </main>

</BaseLayout>

<script>
  import { relativeTime } from "../../lib/liveStats";

  // Statistik pembaca diperbarui setiap 20 detik selama tab terbuka.
  const els = Array.from(document.querySelectorAll<HTMLElement>("[data-stats-for]"));
  const slugs = els.map((e) => e.dataset.statsFor).join(",");
  let last: Record<string, number | null> = {};

  const render = () => els.forEach((e) => {
    const t = last[e.dataset.statsFor!];
    (e.querySelector("[data-l]") as HTMLElement).textContent = t ? relativeTime(t) : "belum ada";
  });

  const load = async () => {
    if (document.hidden || !slugs) return;
    try {
      const r = await fetch(`/api/views?slugs=${slugs}`);
      const d = await r.json();
      if (!r.ok || !d.enabled) return;
      els.forEach((e) => {
        const st = d.stats[e.dataset.statsFor!];
        if (!st) return;
        (e.querySelector("[data-v]") as HTMLElement).textContent = Number(st.views).toLocaleString("id-ID");
        last[e.dataset.statsFor!] = st.lastRead;
        e.hidden = false;
      });
      render();
    } catch {}
  };

  load();
  setInterval(load, 20000);
  document.addEventListener("visibilitychange", load);
</script>
