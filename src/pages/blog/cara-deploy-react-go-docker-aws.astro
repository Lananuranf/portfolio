---
// src/pages/blog/cara-deploy-react-go-docker-aws.astro
import ArticleLayout from '../../components/blog/ArticleLayout.astro';
import CodeBlock from '../../components/blog/CodeBlock.astro';
import Callout from '../../components/blog/Callout.astro';

const codeSSH = `# Di laptop: batasi izin file kunci agar SSH mau memakainya
chmod 400 kunci-saya.pem

# Masuk ke server (ganti dengan IP publik EC2 kamu)
ssh -i kunci-saya.pem ubuntu@IP_PUBLIK_EC2`;

const codeDocker = `# 1. Perbarui daftar paket
sudo apt-get update

# 2. Pasang Docker dengan skrip resmi dari Docker
curl -fsSL https://get.docker.com | sudo sh

# 3. Izinkan user "ubuntu" menjalankan docker tanpa sudo
sudo usermod -aG docker ubuntu`;

const codeDockerCheck = `docker --version
docker compose version
docker run --rm hello-world`;

const codeTree = `letta-school/
├── backend/            # kode Go Fiber
│   ├── Dockerfile
│   └── ...
├── frontend/           # kode React (Vite)
│   ├── Dockerfile
│   ├── nginx-frontend.conf
│   └── ...
├── nginx/
│   └── nginx.conf      # reverse proxy + HTTPS
├── docker-compose.yml
└── .env                # rahasia — JANGAN di-commit`;

const codeDockerfileBackend = `# Tahap 1: kompilasi kode Go menjadi satu file program
FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o server ./cmd/main.go

# Tahap 2: image akhir yang kecil, hanya berisi program jadi
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/server .
ENV TZ=Asia/Jakarta
EXPOSE 8080
CMD ["./server"]`;

const codeDockerfileFrontend = `# Tahap 1: build React menjadi file statis (HTML, CSS, JS)
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Tahap 2: sajikan file statis dengan Nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80`;

const codeNginxFrontend = `server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Semua URL diarahkan ke index.html agar React Router berfungsi
    location / {
        try_files $uri $uri/ /index.html;
    }
}`;

const codeCompose = `services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: \${DB_USER}
      POSTGRES_PASSWORD: \${DB_PASSWORD}
      POSTGRES_DB: \${DB_NAME}
    volumes:
      - postgres_data:/var/lib/postgresql/data   # data tetap aman walau container dihapus
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \${DB_USER}"]
      interval: 10s
      retries: 5

  backend:
    build: ./backend
    restart: unless-stopped
    environment:
      DB_HOST: db                 # nama service, bukan "localhost"
      DB_PORT: 5432
      DB_USER: \${DB_USER}
      DB_PASSWORD: \${DB_PASSWORD}
      DB_NAME: \${DB_NAME}
      JWT_SECRET: \${JWT_SECRET}
    depends_on:
      db:
        condition: service_healthy   # tunggu database siap dulu

  frontend:
    build: ./frontend
    restart: unless-stopped

  nginx:
    image: nginx:alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    depends_on:
      - frontend
      - backend

volumes:
  postgres_data:`;

const codeEnv = `DB_USER=letta_user
DB_PASSWORD=ganti-dengan-password-yang-panjang
DB_NAME=letta_school
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter`;

const codeCertbot = `# Pasang certbot
sudo apt-get install -y certbot

# Minta sertifikat. Port 80 harus kosong (belum ada container yang jalan).
sudo certbot certonly --standalone -d domainkamu.com -d www.domainkamu.com`;

const codeNginxConf = `events {}

http {
    # 1) Semua akses HTTP diarahkan ke HTTPS
    server {
        listen 80;
        server_name domainkamu.com www.domainkamu.com;
        return 301 https://$host$request_uri;
    }

    # 2) Situs utama lewat HTTPS
    server {
        listen 443 ssl;
        http2 on;
        server_name domainkamu.com www.domainkamu.com;

        ssl_certificate     /etc/letsencrypt/live/domainkamu.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/domainkamu.com/privkey.pem;

        # Halaman web -> container frontend
        location / {
            proxy_pass http://frontend:80;
            proxy_set_header Host $host;
        }

        # Permintaan /api/... -> container backend (awalan /api dibuang)
        location /api/ {
            proxy_pass http://backend:8080/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}`;

const codeFirstDeploy = `# Ambil kode dari GitHub
cd ~
git clone https://github.com/username/letta-school.git
cd letta-school

# Buat file .env lalu isi seperti contoh di Langkah 5
nano .env

# Build dan jalankan semua container di latar belakang
docker compose up --build -d

# Pastikan keempat service berstatus "running"
docker compose ps`;

const codeLogs = `# Lihat log backend secara langsung (Ctrl+C untuk keluar)
docker compose logs -f backend`;

const codeGHActions = `name: Deploy ke EC2

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy lewat SSH
        uses: appleboy/ssh-action@v1
        with:
          host: \${{ secrets.EC2_HOST }}
          username: ubuntu
          key: \${{ secrets.EC2_SSH_KEY }}
          script: |
            cd ~/letta-school
            git pull origin main
            docker compose up --build -d
            docker image prune -f`;

const codeRenew = `# Buka crontab milik root
sudo crontab -e

# Tambahkan baris ini: setiap tanggal 1 jam 03.00, perpanjang sertifikat.
# Nginx dihentikan sebentar agar port 80 bisa dipakai certbot.
0 3 1 * * certbot renew --quiet --pre-hook "docker compose -f /home/ubuntu/letta-school/docker-compose.yml stop nginx" --post-hook "docker compose -f /home/ubuntu/letta-school/docker-compose.yml start nginx"`;
---

<ArticleLayout
  slug="cara-deploy-react-go-docker-aws"
  file="src/pages/blog/cara-deploy-react-go-docker-aws.astro"
  title="Cara Deploy Aplikasi React + Go Fiber ke AWS EC2 dengan Docker"
  desc="Panduan langkah demi langkah untuk pemula: menyiapkan server EC2, menjalankan aplikasi dengan Docker Compose, memasang HTTPS, sampai deploy otomatis setiap push ke GitHub."
  datePublished="2026-04-28"
  dateModified="2026-11-08"
  dateLabel="28 April 2026 · diperbarui 8 November 2026"
  category="Tutorial"
  tags={["React","Go Fiber","PostgreSQL","Docker","AWS EC2","Nginx","GitHub Actions"]}
  keywords="deploy react go fiber aws ec2 docker compose nginx https github actions tutorial pemula indonesia"
>
  <h2>Apa yang akan kita buat?</h2>
  <p>
    Di akhir panduan ini, aplikasi web kamu (frontend React, backend Go Fiber, database PostgreSQL)
    bisa diakses siapa saja lewat domain sendiri dengan HTTPS. Setiap kali kamu <code>push</code> ke
    branch <code>main</code>, server akan memperbarui aplikasinya sendiri.
  </p>
  <p>Panduan ini saya tulis dari pengalaman men-deploy <a href="https://school.lananuranf.my.id/">Letta School</a>. Alur permintaannya seperti ini:</p>
  <ol>
    <li><strong>Pengunjung</strong> membuka <code>https://domainkamu.com</code>.</li>
    <li><strong>Nginx</strong> menerima permintaan itu, lalu meneruskannya ke container yang tepat.</li>
    <li>Halaman web dilayani container <strong>frontend</strong>; permintaan <code>/api/...</code> dilayani container <strong>backend</strong>.</li>
    <li>Backend membaca dan menyimpan data di container <strong>PostgreSQL</strong>.</li>
  </ol>

  <Callout type="info" title="Sebelum mulai">
    <ul>
      <li>Akun AWS. Instance <code>t2.micro</code>/<code>t3.micro</code> termasuk free tier selama 12 bulan pertama.</li>
      <li>Domain yang sudah kamu miliki (diperlukan untuk HTTPS).</li>
      <li>Repository GitHub berisi kode frontend dan backend.</li>
      <li>Bisa menjalankan perintah dasar di terminal (<code>cd</code>, <code>ls</code>, <code>nano</code>).</li>
    </ul>
    <p>Perkiraan waktu: 1–2 jam untuk pertama kali.</p>
  </Callout>

  <h2>Langkah 1: Membuat server di AWS EC2</h2>
  <p>EC2 adalah komputer virtual milik AWS yang menyala 24 jam. Di sinilah aplikasi kita akan berjalan.</p>
  <ol>
    <li>Buka AWS Console, pilih <strong>EC2</strong>, lalu klik <strong>Launch instance</strong>.</li>
    <li>Pilih sistem operasi <strong>Ubuntu Server 24.04 LTS</strong>.</li>
    <li>Pilih tipe instance <code>t2.micro</code> atau <code>t3.micro</code>.</li>
    <li>Pada <strong>Key pair</strong>, buat kunci baru dan unduh file <code>.pem</code>. Simpan baik-baik, file ini tidak bisa diunduh ulang.</li>
    <li>Pada <strong>Network settings</strong>, izinkan tiga port berikut:
      <ul>
        <li><code>22</code> (SSH): pilih <em>My IP</em> agar hanya kamu yang bisa masuk.</li>
        <li><code>80</code> (HTTP) dan <code>443</code> (HTTPS): dari mana saja (<em>Anywhere</em>).</li>
      </ul>
    </li>
    <li>Klik <strong>Launch instance</strong>, lalu catat <strong>Public IPv4 address</strong>-nya.</li>
  </ol>
  <p>Sekarang masuk ke server dari terminal laptop:</p>
  <CodeBlock code={codeSSH} label="Terminal (laptop)" />
  <Callout type="check">
    <p>Tampilan terminal berubah menjadi <code>ubuntu@ip-...:~$</code>. Artinya kamu sudah berada di dalam server.</p>
  </Callout>

  <h2>Langkah 2: Memasang Docker di server</h2>
  <p>Docker membuat setiap bagian aplikasi berjalan di "kotak" (container) masing-masing, sehingga hasilnya sama persis di laptop maupun di server.</p>
  <CodeBlock code={codeDocker} label="Terminal (server)" />
  <p>Keluar dari server (<code>exit</code>), lalu masuk lagi dengan perintah SSH di Langkah 1 agar izin grup <code>docker</code> berlaku. Setelah itu jalankan:</p>
  <CodeBlock code={codeDockerCheck} label="Terminal (server)" />
  <Callout type="check">
    <p>Muncul nomor versi Docker dan Docker Compose, serta pesan <code>Hello from Docker!</code>.</p>
  </Callout>

  <h2>Langkah 3: Menyiapkan struktur proyek</h2>
  <p>Agar semua file mudah ditemukan, susun repository seperti ini:</p>
  <CodeBlock code={codeTree} label="Struktur folder" />

  <h2>Langkah 4: Membuat Dockerfile</h2>
  <p>
    Dockerfile adalah "resep" untuk membuat image. Kita memakai <strong>multi-stage build</strong>:
    tahap pertama memakai image besar untuk mengompilasi kode, tahap kedua hanya menyalin hasil jadinya.
    Hasilnya, image backend yang awalnya ratusan MB bisa menjadi hanya belasan MB.
  </p>
  <h3>Backend (Go Fiber)</h3>
  <p>Sesuaikan <code>./cmd/main.go</code> dengan lokasi file <code>main</code> di proyekmu.</p>
  <CodeBlock code={codeDockerfileBackend} label="backend/Dockerfile" />
  <h3>Frontend (React)</h3>
  <p>React di-build menjadi file statis, lalu disajikan oleh Nginx. Cara ini memakai memori jauh lebih kecil daripada menjalankan server development React di produksi.</p>
  <CodeBlock code={codeDockerfileFrontend} label="frontend/Dockerfile" />
  <CodeBlock code={codeNginxFrontend} label="frontend/nginx-frontend.conf" />
  <Callout type="tip">
    <p>Di frontend, panggil API dengan alamat relatif seperti <code>/api/users</code>. Nginx akan meneruskannya ke backend. Alamat <code>http://localhost:8080</code> hanya berlaku di laptopmu dan akan gagal di browser pengunjung.</p>
  </Callout>

  <h2>Langkah 5: Menyatukan semuanya dengan Docker Compose</h2>
  <p>Docker Compose menjalankan keempat container sekaligus dengan satu perintah dan menghubungkan mereka dalam satu jaringan. Di dalam jaringan itu, setiap container bisa dipanggil memakai nama service-nya, misalnya <code>db</code> atau <code>backend</code>.</p>
  <CodeBlock code={codeCompose} label="docker-compose.yml" />
  <p>Nilai rahasia seperti password disimpan terpisah di file <code>.env</code>, di folder yang sama:</p>
  <CodeBlock code={codeEnv} label=".env" />
  <Callout type="warn">
    <p>Tambahkan <code>.env</code> ke <code>.gitignore</code>. File ini hanya dibuat langsung di server dan tidak boleh masuk ke GitHub.</p>
  </Callout>

  <h2>Langkah 6: Mengarahkan domain dan memasang HTTPS</h2>
  <p>Di pengelola DNS domainmu, buat dua <strong>A record</strong>: <code>@</code> dan <code>www</code>, keduanya mengarah ke IP publik EC2. Tunggu beberapa menit sampai aktif, lalu minta sertifikat gratis dari Let's Encrypt:</p>
  <CodeBlock code={codeCertbot} label="Terminal (server)" />
  <p>Setelah sertifikat terbit, buat konfigurasi Nginx utama. Ganti <code>domainkamu.com</code> dengan domainmu.</p>
  <CodeBlock code={codeNginxConf} label="nginx/nginx.conf" />

  <h2>Langkah 7: Deploy pertama kali</h2>
  <CodeBlock code={codeFirstDeploy} label="Terminal (server)" />
  <Callout type="check">
    <p>Buka <code>https://domainkamu.com</code> di browser. Halaman aplikasi tampil dan ada ikon gembok di address bar.</p>
  </Callout>
  <p>Jika ada yang belum berjalan, lihat log service yang bermasalah:</p>
  <CodeBlock code={codeLogs} label="Terminal (server)" />

  <h2>Langkah 8: Deploy otomatis dengan GitHub Actions</h2>
  <p>Supaya tidak perlu masuk ke server setiap kali ada perubahan, kita minta GitHub yang melakukannya.</p>
  <ol>
    <li>Di repository GitHub, buka <strong>Settings → Secrets and variables → Actions</strong>.</li>
    <li>Tambahkan <code>EC2_HOST</code> berisi IP publik server.</li>
    <li>Tambahkan <code>EC2_SSH_KEY</code> berisi seluruh isi file <code>.pem</code>.</li>
    <li>Buat file workflow berikut, lalu commit dan push.</li>
  </ol>
  <CodeBlock code={codeGHActions} label=".github/workflows/deploy.yml" />
  <Callout type="warn">
    <p>Karena port 22 hanya terbuka untuk IP kamu, GitHub tidak akan bisa masuk. Untuk percobaan, kamu bisa membuka port 22 ke <em>Anywhere</em>; untuk jangka panjang, pertimbangkan cara yang lebih aman seperti AWS Systems Manager.</p>
    <p>Jika repository bersifat private, server juga perlu izin untuk <code>git pull</code>, misalnya dengan menambahkan <em>deploy key</em> di pengaturan repository.</p>
  </Callout>
  <Callout type="check">
    <p>Buka tab <strong>Actions</strong> di GitHub. Workflow berwarna hijau, dan perubahanmu muncul di website dalam beberapa menit.</p>
  </Callout>

  <h2>Langkah 9: Perawatan rutin</h2>
  <p>Sertifikat Let's Encrypt berlaku 90 hari. Atur agar diperpanjang otomatis setiap bulan:</p>
  <CodeBlock code={codeRenew} label="Terminal (server)" />
  <ul>
    <li><strong>Cadangkan database</strong> secara berkala, misalnya dengan <code>pg_dump</code>.</li>
    <li><strong>Pantau sisa disk</strong> dengan <code>df -h</code>; image lama dibersihkan oleh <code>docker image prune</code> di workflow.</li>
  </ul>

  <h2>Masalah yang sering muncul</h2>
  <ul>
    <li><strong><code>permission denied</code> saat menjalankan docker</strong>: kamu belum keluar lalu masuk ulang ke server setelah Langkah 2.</li>
    <li><strong>Backend gagal terhubung ke database</strong>: pastikan <code>DB_HOST</code> bernilai <code>db</code>. Nilai <code>localhost</code> merujuk ke container backend itu sendiri.</li>
    <li><strong>Certbot gagal</strong>: DNS belum mengarah ke server, atau port 80 sedang dipakai container lain.</li>
    <li><strong>Halaman React 404 saat di-refresh</strong>: periksa baris <code>try_files</code> di <code>nginx-frontend.conf</code>.</li>
    <li><strong>Server kehabisan memori saat build</strong>: RAM 1 GB cukup sempit untuk build, jadi tambahkan swap 1–2 GB.</li>
  </ul>

  <h2>Ringkasan</h2>
  <p>
    Alur akhirnya: kamu <code>push</code> ke <code>main</code> → GitHub Actions masuk ke server →
    <code>git pull</code> → <code>docker compose up --build -d</code> → aplikasi versi terbaru langsung aktif.
    Semua bagian aplikasi berjalan terpisah di container, rahasia disimpan di <code>.env</code>,
    dan pengunjung selalu terhubung lewat HTTPS.
  </p>
</ArticleLayout>
