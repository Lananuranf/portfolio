---
// src/pages/projects/capstone-hi.astro — Studi kasus backend Hii Stranger (proyek capstone tim, Go).
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import { techIcon } from "../../lib/icons";

const TECH = ["Go", "PostgreSQL", "pgx", "JWT"];

const STATS = [
  { value: "18", label: "migrasi SQL, masing-masing dengan down" },
  { value: "20", label: "file test Go" },
  { value: "12", label: "package fitur di backend" },
  { value: "6", label: "status order, termasuk batal" },
];
const SHOTS_SHOP = [
  { src: "/projects/capstone/beranda.webp", w: 1169, h: 784, alt: "Beranda Hii Stranger dengan banner Kaos Oversize Stranger Hitam, kartu kategori, dan produk terbaru", caption: "Beranda: banner yang bisa diganti dari panel admin, kartu kategori, dan daftar produk terbaru." },
  { src: "/projects/capstone/katalog.webp", w: 1169, h: 720, alt: "Halaman katalog Hii Stranger dengan banner, filter kategori, dan foto produk hoodie serta kaos dari klien", caption: "Katalog dengan banner dan filter kategori, kini memakai foto produk asli dari klien. Produk pre-order diberi label sendiri." },
  { src: "/projects/capstone/detail-produk.webp", w: 1169, h: 720, alt: "Detail produk Hii Stranger Kaos Oversize Stranger Hitam dengan galeri foto dan pilihan ukuran L, M, dan XL", caption: "Di halaman detail, pembeli melihat galeri foto, memilih ukuran dan warna, dan stok tiap ukuran ikut tampil." },
  { src: "/projects/capstone/checkout.webp", w: 1169, h: 784, alt: "Formulir pemesanan Hii Stranger langkah 2 dari 4 dengan data penerima dan alamat pengiriman bertingkat", caption: "Checkout punya empat langkah: keranjang, formulir pemesanan, pembayaran QRIS, lalu status pesanan. Ini langkah kedua. Alamatnya dipilih bertingkat dari provinsi sampai kelurahan." },
];
const SHOTS_ADMIN = [
  { src: "/projects/capstone/admin-dashboard.webp", w: 1300, h: 784, alt: "Dashboard ringkasan admin Hii Stranger dengan kartu angka dan daftar pesanan terbaru", caption: "Dashboard admin: pembayaran yang menunggu diperiksa, pesanan yang perlu dikirim, pesanan hari ini, dan stok yang habis." },
  { src: "/projects/capstone/admin-produk.webp", w: 1300, h: 784, alt: "Halaman daftar produk dan kategori di panel admin Hii Stranger", caption: "Daftar produk dan kategori. Tiap produk berstatus Ready Stock atau Pre-Order dan bisa dinyalakan atau dimatikan." },
  { src: "/projects/capstone/admin-stok.webp", w: 1300, h: 784, alt: "Halaman stok dan varian produk di panel admin, varian L, M, dan XL dengan stok masing-masing", caption: "Stok dicatat per ukuran dan warna. Kaos Oversize Hitam punya tiga varian (L, M, XL) dengan stok sendiri-sendiri." },
  { src: "/projects/capstone/admin-pembayaran.webp", w: 1300, h: 784, alt: "Halaman validasi pembayaran di panel admin dengan bukti unggahan yang diburamkan, total, kode unik, dan tombol validasi", caption: "Validasi pembayaran: admin melihat bukti yang diunggah, total, kode unik, dan nominal yang harus cocok, lalu memilih validasi, tolak, atau tunda. Gambar buktinya sengaja saya buramkan." },
  { src: "/projects/capstone/admin-banner.webp", w: 1300, h: 784, alt: "Halaman kelola banner di panel admin dengan daftar banner dan form banner baru", caption: "Kelola banner: tiap banner punya penempatan (hero, utama, katalog), urutan, tautan tujuan, dan saklar aktif." },
];
const FEATURES = [
  { group: "Pelanggan", items: ["Katalog dengan pencarian dan filter kategori", "Detail produk: galeri foto, pilihan ukuran dan warna, stok per ukuran", "Label pre-order dan ready stock", "Keranjang", "Formulir pemesanan dengan wilayah dan cek ongkir RajaOngkir", "Bayar lewat QRIS dengan kode unik, lalu unggah bukti", "Halaman Pesanan Saya dengan status order dan nomor resi", "Profil, dan email resi saat pesanan dikirim"] },
  { group: "Admin dan pemilik", items: ["Dashboard ringkasan", "Kelola produk, kategori, stok, dan varian", "Atur ready stock atau pre-order", "Daftar pesanan masuk dan ubah status", "Validasi pembayaran: setujui atau tolak bukti", "Kelola banner: penempatan Hero, Main, atau Catalog, urutan, tautan, dan jadwal tayang", "Laporan pendapatan"] },
  { group: "Sprint 3", items: ["Mode maintenance dan pengaturan situs", "Verifikasi email", "Reset kata sandi"] },
  { group: "Keamanan dan kualitas", items: ["Total dan ongkir dihitung ulang di server", "Rate limit per user", "CI dengan govulncheck, gosec, gitleaks, dan CodeQL"] },
];
const SPRINTS = [
  { name: "Sprint 1 · minggu 9", desc: "Fitur dasar: seluruh 15 use case prioritas Must dan tabel inti database." },
  { name: "Sprint 2 · minggu 10", desc: "Fitur lanjutan: empat use case prioritas Should, salah satunya banner beranda." },
  { name: "Sprint 3 · minggu 12", desc: "Pelengkap prioritas Could: pengaturan situs dengan mode maintenance, verifikasi email, dan reset password." },
];

const PACKAGES = [
  { name: "auth, user", desc: "Register, login, reset password, profil, dan kelola user oleh admin." },
  { name: "category, product", desc: "Kategori, produk, varian (ukuran/warna dengan stok sendiri), dan gambar produk." },
  { name: "cart, order", desc: "Keranjang dan checkout. Saat checkout, varian dikunci, stok dikurangi, dan ongkir dihitung ulang di server." },
  { name: "payment, shipment", desc: "Tagihan dengan kode unik transfer, unggah bukti, verifikasi admin, lalu kurir dan nomor resi." },
  { name: "ongkir", desc: "Data wilayah dan cek ongkir dari RajaOngkir." },
  { name: "banner, sitesetting, upload", desc: "Banner beranda, mode maintenance, dan unggah gambar oleh admin." },
];

const ORDER_FLOW = [
  { title: "Checkout", desc: "POST /orders mengunci baris keranjang dan varian dengan SELECT … FOR UPDATE, lalu mengecek stok dan membuat order berstatus pending_payment. Wilayah dan ongkir dihitung ulang di server, sebab angka dari browser bisa diubah siapa saja." },
  { title: "Tagihan dan bukti transfer", desc: "Pelanggan dapat tagihan dengan kode unik 1–999 rupiah, jadi transfernya gampang dicocokkan. Setelah itu ia mengunggah bukti bayar." },
  { title: "Verifikasi admin", desc: "Admin menyetujui atau menolak bukti. Kalau disetujui, order dikunci dulu sebelum statusnya jadi paid." },
  { title: "Proses dan kirim", desc: "Admin mengubah status ke processing, lalu shipped. Nomor resi wajib diisi saat shipped, dan pelanggan dapat email berisi resi." },
  { title: "Selesai atau batal", desc: "Order ditutup sebagai completed. Sebelum shipped, order masih bisa dibatalkan dan stok varian dikembalikan." },
];

const ENDPOINTS = [
  { group: "Auth & profil", items: ["POST /auth/register", "POST /auth/login", "POST /auth/password/forgot", "GET /users/me"] },
  { group: "Katalog", items: ["GET /products", "GET /products/{productId}", "GET /categories", "GET /banners"] },
  { group: "Ongkir", items: ["GET /regions/provinces", "GET /regions/districts/{id}/subdistricts", "GET /shipping/costs"] },
  { group: "Order & bayar", items: ["POST /orders", "POST /orders/{orderId}/cancel", "POST /orders/{orderId}/payment", "PUT /orders/{orderId}/payment/proof"] },
  { group: "Admin", items: ["GET /admin/payments", "POST /admin/payments/{paymentId}/review", "PUT /admin/orders/{orderId}/status", "POST /admin/uploads/images"] },
];

const projectSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Hii Stranger API",
  description: "Backend toko online streetwear untuk proyek capstone tim: Go (net/http + pgx), PostgreSQL, dan pembayaran transfer dengan verifikasi admin.",
  programmingLanguage: ["Go", "SQL", "TypeScript"],
  url: "https://lananuranf.my.id/projects/capstone-hi/",
  image: "https://lananuranf.my.id/og-image.png",
  inLanguage: "id",
  dateModified: "2026-11-22",
  author: { "@type": "Person", name: "Maulana Nur Anfajm", alternateName: "Lananuranf", url: "https://lananuranf.my.id/" },
});
---

<BaseLayout
  title="Hii Stranger: Backend Toko Online dengan Go | Lananuranf"
  description="Studi kasus backend toko online Hii Stranger (capstone tim): Go, PostgreSQL, dan checkout dengan penguncian stok."
  canonicalURL="https://lananuranf.my.id/projects/capstone-hi/"
  breadcrumbs={[{ name: "Hii Stranger", url: "https://lananuranf.my.id/projects/capstone-hi/" }]}
  extraSchema={projectSchema}
>
  <MainLayout />

  <main class="pt-20 min-h-screen text-ink glass-scene scene-sky">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 py-14">
      <a href="/#projects" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-rose-deep transition-colors mb-8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
        Kembali ke Proyek
      </a>

      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-pink-soft text-rose-deep border border-line">Backend API</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Go</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Proyek capstone tim</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Scrum, 3 sprint</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-3">
          Hii Stranger API: <span class="text-gradient-brand">backend toko online</span>
        </h1>
        <p class="text-ink-muted text-base leading-relaxed">
          Hii Stranger adalah toko online streetwear yang kami buat untuk proyek capstone kampus. Kliennya nyata, yaitu pemilik brand Hii Stranger sendiri. Repositorinya satu monorepo yang isinya backend Go dan frontend Next.js. Kami bekerja dengan Scrum selama tiga sprint. Bagian saya backend Go, terutama penguncian stok saat checkout. {/* TODO(peran): halaman ini sebelumnya menyebut juga arsitektur per fitur, migrasi, pencarian pembayaran admin, dan panel admin responsif. Dihapus supaya tidak melebihi "stok locking saat checkout"; kembalikan bila memang bagian Anda. */}
        </p>
        <a href="https://github.com/y40368976-svg/hii-stranger" target="_blank" rel="noopener"
          class="glass-card group mt-6 flex items-center gap-4 rounded-2xl p-4 hover:border-rose-brand transition-colors">
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold">Repositori publik di GitHub</p>
            <p class="text-xs text-ink-muted break-all">github.com/y40368976-svg/hii-stranger</p>
          </div>
          <span class="text-xs font-semibold text-ink-muted group-hover:text-rose-deep whitespace-nowrap">Buka repo →</span>
        </a>
      </header>

      <ul class="glass-card flex flex-wrap gap-2 mb-8 p-4 rounded-2xl" aria-label="Teknologi">
        {TECH.map((label) => {
          const icon = techIcon(label);
          return (
            <li class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 bg-surface border border-line rounded-full">
              {icon && <span class="w-3.5 h-3.5 shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={icon.svg} />}
              {label}
            </li>
          );
        })}
      </ul>

      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        {STATS.map((s) => (
          <div class="glass-card rounded-2xl p-4">
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-2xl font-extrabold text-gradient-brand leading-none">{s.value}</dd>
            <dd class="text-xs text-ink-muted mt-2 leading-snug">{s.label}</dd>
          </div>
        ))}
      </dl>

      <div class="flex flex-col gap-12">
        <section aria-labelledby="tampilan">
          <h2 id="tampilan" class="text-xl font-bold mb-3">Tampilan toko dan panel admin</h2>
          <h3 class="text-sm font-semibold text-lavender-deep uppercase tracking-wide mb-2">Sisi pembeli</h3>
          <div class="grid gap-4">
            {SHOTS_SHOP.map((s) => (
              <figure class="glass-card rounded-2xl overflow-hidden">
                <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" class="block w-full h-auto" />
                <figcaption class="px-4 py-3 text-xs text-ink-muted leading-relaxed">{s.caption}</figcaption>
              </figure>
            ))}
          </div>
          <h3 class="text-sm font-semibold text-lavender-deep uppercase tracking-wide mt-8 mb-2">Panel admin</h3>
          <div class="grid gap-4">
            {SHOTS_ADMIN.map((s) => (
              <figure class="glass-card rounded-2xl overflow-hidden">
                <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" class="block w-full h-auto" />
                <figcaption class="px-4 py-3 text-xs text-ink-muted leading-relaxed">{s.caption}</figcaption>
              </figure>
            ))}
          </div>
          <p class="text-xs text-ink-muted mt-3">Semua diambil dari aplikasi yang berjalan di lokal dengan data uji. Foto produk dari klien.</p>
        </section>
        <section aria-labelledby="fitur">
          <h2 id="fitur" class="text-xl font-bold mb-3">Fitur</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Yang sudah jalan di aplikasinya, dari sisi pembeli dan sisi pemilik toko.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {FEATURES.map((g) => (
              <div class="glass-card rounded-2xl p-4">
                <p class="text-xs font-semibold text-lavender-deep uppercase tracking-wide mb-2">{g.group}</p>
                <ul class="list-disc pl-5 flex flex-col gap-1 text-sm text-ink-muted leading-relaxed">
                  {g.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="masalah">
          <h2 id="masalah" class="text-xl font-bold mb-3">Masalah</h2>
          <div class="glass-card rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Toko online kecil yang menerima transfer bank biasanya mencocokkan pembayaran dengan tangan. Tanpa sistem, admin susah tahu order mana yang sudah dibayar, mana yang harus dikirim, dan stok tinggal berapa.</p>
            <p>Di sisi backend, bagian paling rawan ada di checkout. Dua pelanggan bisa saja membeli varian terakhir di detik yang sama. Ongkir dan total dari browser juga tidak boleh langsung dipercaya.</p>
          </div>
        </section>
        <section aria-labelledby="sprint">
          <h2 id="sprint" class="text-xl font-bold mb-3">Cara kerja tim</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Backlog kami ambil dari use case di dokumen SDD, lalu dibagi ke tiga sprint menurut prioritas Must, Should, dan Could. Tiap sprint mulai dengan rencana dan selesai dengan demo serta retrospektif, lalu hasilnya kami catat di dokumen implementasi per sprint.</p>
          <div class="grid sm:grid-cols-3 gap-3">
            {SPRINTS.map((s) => (
              <div class="glass-card rounded-2xl p-4">
                <p class="text-sm font-semibold text-rose-deep">{s.name}</p>
                <p class="text-sm text-ink-muted leading-relaxed mt-1">{s.desc}</p>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="arsitektur">
          <h2 id="arsitektur" class="text-xl font-bold mb-3">Arsitektur</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Satu binary Go memakai <code class="font-mono text-ink">net/http</code> dan <code class="font-mono text-ink">pgx</code>, tanpa framework web. Setiap fitur punya package sendiri dengan pola yang sama: <code class="font-mono text-ink">model.go</code>, <code class="font-mono text-ink">repository.go</code> (query), <code class="font-mono text-ink">service.go</code> (aturan bisnis), dan <code class="font-mono text-ink">handler.go</code> (request dan response). Semua route berawalan <code class="font-mono text-ink">/api/v1</code> dan kontraknya ditulis di <code class="font-mono text-ink">openapi.yaml</code>.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {PACKAGES.map((p) => (
              <div class="glass-card rounded-2xl p-4">
                <p class="font-mono text-sm font-semibold text-rose-deep">{p.name}</p>
                <p class="text-sm text-ink-muted leading-relaxed mt-1">{p.desc}</p>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="order">
          <h2 id="order" class="text-xl font-bold mb-3">Alur order</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Status order: pending_payment → paid → processing → shipped → completed, atau cancelled selama barang belum dikirim.</p>
          <ol class="flex flex-col gap-3">
            {ORDER_FLOW.map((f, i) => (
              <li class="glass-card flex gap-4 rounded-2xl p-4">
                <span class="w-7 h-7 shrink-0 rounded-full bg-pink-soft text-rose-deep text-sm font-bold flex items-center justify-center">{i + 1}</span>
                <div>
                  <p class="font-semibold text-sm">{f.title}</p>
                  <p class="text-sm text-ink-muted leading-relaxed mt-1">{f.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
        <section aria-labelledby="endpoint">
          <h2 id="endpoint" class="text-xl font-bold mb-3">Endpoint utama</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Semua di bawah prefix <code class="font-mono text-ink">/api/v1</code>. Ini sebagian dari puluhan route untuk pelanggan dan admin.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {ENDPOINTS.map((g) => (
              <div class="glass-card rounded-2xl p-4">
                <p class="text-xs font-semibold text-lavender-deep uppercase tracking-wide mb-2">{g.group}</p>
                <ul class="flex flex-col gap-1">
                  {g.items.map((e) => {
                    const [method, ...rest] = e.split(" ");
                    return (
                      <li class="font-mono text-[12px] leading-relaxed break-all">
                        <span class={method === "GET" ? "text-lavender-deep font-bold" : "text-rose-deep font-bold"}>{method}</span>{" "}
                        <span class="text-ink">{rest.join(" ")}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="pengujian">
          <h2 id="pengujian" class="text-xl font-bold mb-3">Pengujian</h2>
          <div class="glass-card rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Sebelum push, kami menjalankan <code class="font-mono text-ink">gofmt -l .</code>, <code class="font-mono text-ink">go vet ./...</code>, <code class="font-mono text-ink">go test ./...</code>, dan <code class="font-mono text-ink">go build ./...</code>. Test-nya mencakup middleware (termasuk cache) dan aturan bisnis di service.</p>
            <p>Uji tim pada 5 November 2026 memakai server asli dan PostgreSQL lokal. Hasilnya 130 dari 130 skenario lolos. Skenario itu menyentuh 55 endpoint di 14 kelompok fitur, dengan respons rata-rata 37 ms. Unit test di 10 package juga lolos.</p>
            <p>Benchmark dengan bombardier (64 koneksi, 10 detik per endpoint, laptop 4 core, 2.000 produk) hasilnya daftar produk naik dari 299 ke 28.001 req/s dibanding kode awal, dan p99 turun dari 55 ke 7 ms. Tanpa cache, naiknya dari 753 ke 3.305 req/s.</p>
          </div>
        </section>

        <section aria-labelledby="ci">
          <h2 id="ci" class="text-xl font-bold mb-3">CI dan alur kerja</h2>
          <div class="glass-card rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Perubahan masuk lewat branch dan pull request, dan baru di-merge setelah CI di GitHub Actions hijau. CI juga jalan di tiap push ke <code class="font-mono text-ink">main</code> dan tiap Senin, supaya dependency yang baru kena CVE ketahuan.</p>
            <ul class="list-disc pl-5 flex flex-col gap-1">
              <li><span class="font-semibold text-ink">Kualitas kode:</span> go vet, go test, dan test integrasi keranjang dengan PostgreSQL 17 dan Redis 7. Frontend dicek dengan lint, pengecekan tipe, dan test.</li>
              <li><span class="font-semibold text-ink">Keamanan:</span> govulncheck dan gosec menggagalkan build kalau ada temuan. Lalu ada gitleaks untuk rahasia yang bocor, pnpm audit, CodeQL, dan Dependabot mingguan.</li>
              <li><span class="font-semibold text-ink">Build:</span> image Docker backend dibuild untuk mengecek Dockerfile. Tag versi <code class="font-mono text-ink">v*</code> memicu rilis image ke GHCR.</li>
            </ul>
            <p>Proyek ini belum di-deploy.</p>
          </div>
          <figure class="glass-card mt-4 rounded-2xl overflow-hidden">
            <img src="/projects/capstone/ci-github-actions.webp" alt="Daftar workflow run GitHub Actions dengan centang hijau" width="1262" height="520" loading="lazy" decoding="async" class="block w-full h-auto" />
            <figcaption class="px-4 py-3 text-xs text-ink-muted leading-relaxed">Riwayat GitHub Actions di repositori. Tiap pull request dan merge ke main menjalankan CI.</figcaption>
          </figure>
        </section>

      </div>

      <div class="glass-card mt-12 p-6 rounded-2xl text-center">
        <p class="font-bold mb-1">Mau bahas proyek ini?</p>
        <p class="text-sm text-ink-muted mb-4">Detail implementasinya bisa saya jelaskan lewat email. Saya sedang mencari magang dan proyek freelance di bidang backend.</p>
        <div class="flex justify-center gap-3 flex-wrap">
          <a href="mailto:lananuranf@gmail.com" class="px-5 py-2.5 bg-ink text-white font-semibold rounded-xl text-sm hover:bg-lavender-deep transition-colors">Kirim Email</a>

          <a href="/#projects" class="px-5 py-2.5 border border-line bg-white text-ink font-semibold rounded-xl text-sm hover:border-rose-brand transition-colors">Proyek lain</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
