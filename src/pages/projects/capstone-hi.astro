---
// src/pages/projects/capstone-hi.astro — Studi kasus backend Hii Stranger (proyek capstone tim, Go).
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import { techIcon } from "../../lib/icons";

const TECH = ["Go", "PostgreSQL", "pgx", "JWT"];

const STATS = [
  { value: "18", label: "migrasi SQL, masing-masing dengan down" },
  { value: "20", label: "file test Go" },
  { value: "12", label: "package fitur di backend" },
  { value: "6", label: "status order, termasuk batal" },
];

const PACKAGES = [
  { name: "auth, user", desc: "Register, login, reset password, profil, dan kelola user oleh admin." },
  { name: "category, product", desc: "Kategori, produk, varian (ukuran/warna dengan stok sendiri), dan gambar produk." },
  { name: "cart, order", desc: "Keranjang dan checkout. Checkout mengunci varian, mengurangi stok, dan menghitung ulang ongkir di server." },
  { name: "payment, shipment", desc: "Tagihan dengan kode unik transfer, unggah bukti, verifikasi admin, lalu kurir dan nomor resi." },
  { name: "ongkir", desc: "Data wilayah dan cek ongkir dari RajaOngkir." },
  { name: "banner, sitesetting, upload", desc: "Banner beranda, mode maintenance, dan unggah gambar admin." },
];

const ORDER_FLOW = [
  { title: "Checkout", desc: "POST /orders mengunci baris keranjang dan varian dengan SELECT … FOR UPDATE, memeriksa stok, lalu membuat order berstatus pending_payment. Wilayah dan ongkir dihitung ulang di server, bukan dipercaya dari client." },
  { title: "Tagihan dan bukti transfer", desc: "Pelanggan mendapat tagihan dengan kode unik 1–999 rupiah supaya transfer mudah dicocokkan, lalu mengunggah bukti bayar." },
  { title: "Verifikasi admin", desc: "Admin menyetujui atau menolak bukti. Saat disetujui, order dikunci dulu sebelum statusnya berubah menjadi paid." },
  { title: "Proses dan kirim", desc: "Admin mengubah status ke processing, lalu shipped. Nomor resi wajib diisi saat shipped, dan pelanggan menerima email berisi resi." },
  { title: "Selesai atau batal", desc: "Order ditutup sebagai completed. Selama belum shipped, order masih bisa dibatalkan dan stok varian dikembalikan." },
];

const ENDPOINTS = [
  { group: "Auth & profil", items: ["POST /auth/register", "POST /auth/login", "POST /auth/password/forgot", "GET /users/me"] },
  { group: "Katalog", items: ["GET /products", "GET /products/{productId}", "GET /categories", "GET /banners"] },
  { group: "Ongkir", items: ["GET /regions/provinces", "GET /regions/districts/{id}/subdistricts", "GET /shipping/costs"] },
  { group: "Order & bayar", items: ["POST /orders", "POST /orders/{orderId}/cancel", "POST /orders/{orderId}/payment", "PUT /orders/{orderId}/payment/proof"] },
  { group: "Admin", items: ["GET /admin/payments", "POST /admin/payments/{paymentId}/review", "PUT /admin/orders/{orderId}/status", "POST /admin/uploads/images"] },
];

const projectSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Hii Stranger API",
  description: "Backend toko online streetwear untuk proyek capstone tim: Go (net/http + pgx), PostgreSQL, dan pembayaran transfer dengan verifikasi admin.",
  programmingLanguage: ["Go", "SQL", "TypeScript"],
  url: "https://lananuranf.my.id/projects/capstone-hi/",
  image: "https://lananuranf.my.id/og-image.png",
  inLanguage: "id",
  dateModified: "2026-11-12",
  author: { "@type": "Person", name: "Maulana Nur Anfajm", alternateName: "Lananuranf", url: "https://lananuranf.my.id/" },
});
---

<BaseLayout
  title="Hii Stranger: Backend Toko Online dengan Go | Lananuranf"
  description="Studi kasus backend toko online Hii Stranger (capstone tim): Go, PostgreSQL, dan checkout dengan penguncian stok."
  canonicalURL="https://lananuranf.my.id/projects/capstone-hi/"
  breadcrumbs={[{ name: "Hii Stranger", url: "https://lananuranf.my.id/projects/capstone-hi/" }]}
  extraSchema={projectSchema}
>
  <MainLayout />

  <main class="pt-20 min-h-screen bg-surface text-ink">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 py-14">
      <a href="/#projects" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-rose-deep transition-colors mb-8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
        Kembali ke Proyek
      </a>

      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-pink-soft text-rose-deep border border-line">Backend API</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Go</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Proyek capstone tim</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-3">
          Hii Stranger API: <span class="text-gradient-brand">backend toko online</span>
        </h1>
        <p class="text-ink-muted text-base leading-relaxed">
          Hii Stranger adalah toko online pakaian streetwear yang kami buat sebagai proyek capstone kampus. Repositorinya monorepo: backend Go dan frontend Next.js. Ini proyek tim. Bagian yang saya kerjakan terutama backend (merapikan arsitektur per fitur, migrasi database, pencarian di daftar pembayaran admin) dan tampilan responsif panel admin.
        </p>
        <p class="mt-6 flex items-center gap-2 rounded-2xl border border-line bg-white p-4 text-xs text-ink-muted">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 shrink-0 text-lavender-deep" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
          Repositori dipegang akun anggota tim, jadi tidak ditautkan di sini.
        </p>
      </header>

      <ul class="flex flex-wrap gap-2 mb-8 p-4 bg-white rounded-2xl border border-line" aria-label="Teknologi">
        {TECH.map((label) => {
          const icon = techIcon(label);
          return (
            <li class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 bg-surface border border-line rounded-full">
              {icon && <span class="w-3.5 h-3.5 shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={icon.svg} />}
              {label}
            </li>
          );
        })}
      </ul>

      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        {STATS.map((s) => (
          <div class="rounded-2xl bg-white border border-line p-4">
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-2xl font-extrabold text-gradient-brand leading-none">{s.value}</dd>
            <dd class="text-xs text-ink-muted mt-2 leading-snug">{s.label}</dd>
          </div>
        ))}
      </dl>

      <div class="flex flex-col gap-12">
        <section aria-labelledby="masalah">
          <h2 id="masalah" class="text-xl font-bold mb-3">Masalah</h2>
          <div class="bg-white border border-line rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Toko online kecil yang menerima transfer bank harus mencocokkan pembayaran secara manual. Tanpa sistem, admin sulit tahu order mana yang sudah dibayar, mana yang perlu dikirim, dan berapa stok yang tersisa.</p>
            <p>Dari sisi backend, risiko utamanya ada di checkout. Dua pelanggan bisa membeli varian terakhir pada saat yang sama, dan ongkir atau total yang dikirim dari browser tidak boleh dipercaya begitu saja.</p>
          </div>
        </section>
        <section aria-labelledby="arsitektur">
          <h2 id="arsitektur" class="text-xl font-bold mb-3">Arsitektur</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Satu binary Go memakai <code class="font-mono text-ink">net/http</code> dan <code class="font-mono text-ink">pgx</code>, tanpa framework web. Setiap fitur punya package sendiri dengan pola yang sama: <code class="font-mono text-ink">model.go</code>, <code class="font-mono text-ink">repository.go</code> (query), <code class="font-mono text-ink">service.go</code> (aturan bisnis), dan <code class="font-mono text-ink">handler.go</code> (request dan response). Semua route berawalan <code class="font-mono text-ink">/api/v1</code> dan kontraknya ditulis di <code class="font-mono text-ink">openapi.yaml</code>.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {PACKAGES.map((p) => (
              <div class="bg-white border border-line rounded-2xl p-4">
                <p class="font-mono text-sm font-semibold text-rose-deep">{p.name}</p>
                <p class="text-sm text-ink-muted leading-relaxed mt-1">{p.desc}</p>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="order">
          <h2 id="order" class="text-xl font-bold mb-3">Alur order</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Status order: pending_payment → paid → processing → shipped → completed, atau cancelled selama barang belum dikirim.</p>
          <ol class="flex flex-col gap-3">
            {ORDER_FLOW.map((f, i) => (
              <li class="flex gap-4 bg-white border border-line rounded-2xl p-4">
                <span class="w-7 h-7 shrink-0 rounded-full bg-pink-soft text-rose-deep text-sm font-bold flex items-center justify-center">{i + 1}</span>
                <div>
                  <p class="font-semibold text-sm">{f.title}</p>
                  <p class="text-sm text-ink-muted leading-relaxed mt-1">{f.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
        <section aria-labelledby="endpoint">
          <h2 id="endpoint" class="text-xl font-bold mb-3">Endpoint utama</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Semua di bawah prefix <code class="font-mono text-ink">/api/v1</code>. Ini sebagian dari puluhan route untuk pelanggan dan admin.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {ENDPOINTS.map((g) => (
              <div class="bg-white border border-line rounded-2xl p-4">
                <p class="text-xs font-semibold text-lavender-deep uppercase tracking-wide mb-2">{g.group}</p>
                <ul class="flex flex-col gap-1">
                  {g.items.map((e) => {
                    const [method, ...rest] = e.split(" ");
                    return (
                      <li class="font-mono text-[12px] leading-relaxed break-all">
                        <span class={method === "GET" ? "text-lavender-deep font-bold" : "text-rose-deep font-bold"}>{method}</span>{" "}
                        <span class="text-ink">{rest.join(" ")}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </section>
        <section aria-labelledby="pengujian">
          <h2 id="pengujian" class="text-xl font-bold mb-3">Pengujian</h2>
          <div class="bg-white border border-line rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Perintah rutin sebelum push: <code class="font-mono text-ink">gofmt -l .</code>, <code class="font-mono text-ink">go vet ./...</code>, <code class="font-mono text-ink">go test ./...</code>, dan <code class="font-mono text-ink">go build ./...</code>. Test mencakup middleware (termasuk cache) dan aturan bisnis di service.</p>
          </div>
        </section>

      </div>

      <div class="mt-12 p-6 bg-white border border-line rounded-2xl text-center">
        <p class="font-bold mb-1">Mau bahas proyek ini lebih jauh?</p>
        <p class="text-sm text-ink-muted mb-4">Saya senang menjelaskan detail implementasinya, atau membicarakan peluang magang dan kerja di bidang backend.</p>
        <div class="flex justify-center gap-3 flex-wrap">
          <a href="mailto:lananuranf@gmail.com" class="px-5 py-2.5 bg-ink text-white font-semibold rounded-xl text-sm hover:bg-lavender-deep transition-colors">Kirim Email</a>

          <a href="/#projects" class="px-5 py-2.5 border border-line bg-white text-ink font-semibold rounded-xl text-sm hover:border-rose-brand transition-colors">Proyek lain</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
