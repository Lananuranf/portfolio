---
// src/pages/projects/letta-school.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getRepoProof, formatBulanTahun, GITHUB_USER } from "../../lib/github";

const proof = await getRepoProof("letta-school");
const sejak = formatBulanTahun(proof.createdAt);

const projectSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Letta School",
    description:
        "Sistem manajemen sekolah dengan login JWT dan hak akses per peran. React + Go Fiber + PostgreSQL + Docker + AWS EC2.",
    url: "https://school.lananuranf.my.id/",
    applicationCategory: "WebApplication",
    programmingLanguage: [
        "React",
        "TypeScript",
        "Go Fiber",
        "PostgreSQL",
        "Docker",
    ],
    author: {
        "@type": "Person",
        name: "Maulana Nur Anfajm",
        alternateName: "Lananuranf",
        url: "https://lananuranf.my.id/",
    },
});
---

<BaseLayout
    title="Letta School: Sistem Manajemen Sekolah | Maulana Nur Anfajm (Lananuranf)"
    description="Studi kasus sistem manajemen sekolah dengan React, Go Fiber, PostgreSQL, Docker, dan AWS EC2, lengkap dengan login JWT dan hak akses per peran. Dibuat oleh Maulana Nur Anfajm (Lananuranf)."
    canonicalURL="https://lananuranf.my.id/projects/letta-school/"
    extraSchema={projectSchema}
>
    <MainLayout />

    <main class="pt-20 min-h-screen bg-slate-50">
        <article class="max-w-4xl mx-auto px-6 py-14">
            <!-- Back -->
            <a
                href="/#projects"
                class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-800 transition-colors mb-8"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-4 h-4"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
                    />
                </svg>
                Kembali ke Proyek
            </a>

            <!-- Header -->
            <header class="mb-10">
                <div class="flex flex-wrap gap-2 mb-4">
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-cyan-50 text-cyan-700 border border-cyan-200">
                        Fullstack
                    </span>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-sky-50 text-sky-700 border border-sky-200">
                        AWS EC2
                    </span>
                </div>
                <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-3">
                    Letta School: Sistem Manajemen Sekolah
                </h1>
                <p class="text-slate-500 text-base leading-relaxed">
                    Sistem manajemen sekolah dengan login JWT, pembagian hak
                    akses per peran, dan deploy otomatis setiap kali ada push ke
                    branch main.
                </p>
                <!-- Bukti pembuat (data asli dari GitHub, diambil saat build) -->
                <a
                    href={proof.commitsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group mt-6 flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 hover:border-slate-900 transition-colors"
                >
                    <img
                        src={`https://github.com/${GITHUB_USER}.png?size=96`}
                        alt={`Avatar GitHub ${GITHUB_USER}`}
                        width="44"
                        height="44"
                        class="w-11 h-11 rounded-full border border-slate-200 shrink-0"
                    />
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-semibold text-slate-900">
                            Dibuat oleh @{GITHUB_USER}
                            {proof.sharePct !== null && (
                                <span class="ml-1 text-emerald-600 font-medium">
                                    · {proof.sharePct}% commit
                                </span>
                            )}
                        </p>
                        <p class="text-xs text-slate-500 truncate">
                            {[
                                sejak && `Sejak ${sejak}`,
                                proof.myCommits !== null &&
                                    `${proof.myCommits} commit`,
                                `github.com/${GITHUB_USER}/${proof.repo}`,
                            ]
                                .filter(Boolean)
                                .join(" · ")}
                        </p>
                    </div>
                    <span class="hidden sm:inline text-xs font-semibold text-slate-500 group-hover:text-slate-900 whitespace-nowrap">
                        Riwayat commit →
                    </span>
                </a>
            </header>

            <!-- Tech stack -->
            <div class="flex flex-wrap gap-2 mb-10 p-4 bg-white rounded-2xl border border-slate-200">
                <span class="text-xs font-semibold text-slate-500 w-full mb-1">
                    Teknologi:
                </span>
                {[
                    "React",
                    "TypeScript",
                    "Tailwind CSS",
                    "Go Fiber",
                    "GORM",
                    "PostgreSQL",
                    "JWT",
                    "RBAC",
                    "Docker",
                    "Docker Compose",
                    "AWS EC2",
                    "GitHub Actions",
                    "Nginx",
                ].map((t) => (
                    <span class="text-xs font-medium px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-full text-slate-600">
                        {t}
                    </span>
                ))}
            </div>

            <!-- Case Study -->
            <div class="flex flex-col gap-8">
                <section>
                    <h2 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
                        <span class="w-7 h-7 rounded-lg bg-rose-100 flex items-center justify-center text-sm">
                            🔴
                        </span>
                        Masalah
                    </h2>
                    <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 text-slate-600 text-sm leading-relaxed">
                        <p>
                            Sekolah Letta mengelola data siswa, guru, absensi,
                            jadwal, dan laporan akademik secara manual di
                            spreadsheet. Data mudah salah ketik, tidak aman, dan
                            sulit dibuka beberapa orang sekaligus.
                        </p>
                        <p class="mt-2">
                            Sistem baru juga harus membedakan tiga jenis
                            pengguna: admin dengan akses penuh, guru yang
                            mengelola kelas dan nilai, dan siswa yang hanya bisa
                            melihat data pribadinya.
                        </p>
                    </div>
                </section>

                <section>
                    <h2 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
                        <span class="w-7 h-7 rounded-lg bg-emerald-100 flex items-center justify-center text-sm">
                            🟢
                        </span>
                        Solusi
                    </h2>
                    <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-5 text-slate-600 text-sm leading-relaxed">
                        <p>
                            Saya membangun aplikasi web fullstack dengan React +
                            TypeScript di frontend, Go Fiber di backend, dan
                            PostgreSQL sebagai database. TypeScript menangkap
                            kesalahan tipe data sebelum kode dijalankan. Go
                            Fiber saya pilih karena ringan dan cepat untuk REST
                            API; perbandingannya dengan Express.js saya tulis di{" "}
                            <a
                                href="/blog/go-fiber-vs-nodejs-performa/"
                                class="font-semibold text-slate-800 underline underline-offset-2 hover:text-slate-950"
                            >
                                artikel benchmark ini
                            </a>
                            .
                        </p>
                        <p class="mt-2">
                            Hak akses diatur di middleware Go Fiber. Setiap
                            endpoint API memeriksa token JWT dan peran pengguna
                            sebelum memberi akses. Ada tiga peran:{" "}
                            <strong>admin</strong> (menambah, mengubah, dan
                            menghapus semua data), <strong>guru</strong>{" "}
                            (mengelola kelas, absensi, dan nilai), dan{" "}
                            <strong>siswa</strong> (melihat data pribadi dan
                            jadwal).
                        </p>
                    </div>
                </section>

                <section>
                    <h2 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2">
                        <span class="w-7 h-7 rounded-lg bg-amber-100 flex items-center justify-center text-sm">
                            ⚡
                        </span>
                        Infrastruktur
                    </h2>
                    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 text-slate-600 text-sm leading-relaxed">
                        <p>
                            Aplikasi berjalan di AWS EC2 (Ubuntu 22.04 LTS)
                            dengan Docker Compose. Nginx bertugas sebagai
                            reverse proxy: menangani SSL, mengalihkan HTTP ke
                            HTTPS, menyajikan file statis, dan meneruskan
                            request ke container yang tepat.
                        </p>
                        <p class="mt-2">
                            Deploy berjalan otomatis lewat GitHub Actions.
                            Setiap ada merge ke main, workflow masuk ke EC2
                            lewat SSH, menjalankan <code>git pull</code> dan{" "}
                            <code>docker compose up --build -d</code>, lalu
                            versi baru aktif dalam 2–3 menit.
                        </p>
                    </div>
                </section>
            </div>

            <!-- CTA -->
            <div class="mt-12 p-6 bg-linear-to-r from-cyan-50 to-blue-50 border border-cyan-200 rounded-3xl text-center">
                <p class="font-bold text-slate-900 mb-1">
                    Tertarik dengan proyek ini?
                </p>
                <p class="text-sm text-slate-500 mb-4">
                    Saya senang membahas cara kerjanya lebih dalam, atau
                    membicarakan peluang magang dan kerja.
                </p>
                <div class="flex justify-center gap-3 flex-wrap">
                    <a
                        href="mailto:lananuranf@gmail.com"
                        class="px-5 py-2.5 bg-sky-500 text-white font-semibold rounded-xl text-sm hover:bg-sky-600 transition-colors"
                    >
                        Kirim Email
                    </a>
                    <a
                        href="/#projects"
                        class="px-5 py-2.5 border border-slate-200 bg-white text-slate-700 font-semibold rounded-xl text-sm hover:bg-slate-50 transition-colors"
                    >
                        Lihat Proyek Lain
                    </a>
                </div>
            </div>
        </article>
    </main>
</BaseLayout>
