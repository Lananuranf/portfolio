---
// src/pages/projects/letta-school.astro — Studi kasus backend Letta School (Go Fiber).
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import { getRepoProof, formatBulanTahun, GITHUB_USER } from "../../lib/github";
import { techIcon } from "../../lib/icons";

const proof = await getRepoProof("letta-school");
const sejak = formatBulanTahun(proof.createdAt);

const TECH = ["Go Fiber", "GORM", "PostgreSQL", "JWT", "Docker", "Docker Compose", "Nginx", "AWS EC2", "Ubuntu", "GitHub Actions"];

const ROLES = [
  { role: "Admin", desc: "Menambah, mengubah, dan menghapus semua data: siswa, guru, kelas, jadwal." },
  { role: "Guru", desc: "Mengelola kelas yang diampu, absensi, dan nilai." },
  { role: "Siswa", desc: "Hanya membaca data pribadi dan jadwalnya sendiri." },
];

const PIPELINE = [
  "Push / merge ke branch main",
  "GitHub Actions masuk ke EC2 lewat SSH",
  "git pull di server",
  "docker compose up --build -d",
  "Versi baru aktif dalam 2–3 menit",
];

const projectSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Letta School",
  description: "REST API sistem manajemen sekolah dengan Go Fiber, PostgreSQL, JWT, dan hak akses per peran. Berjalan di AWS EC2 dengan Docker Compose dan deploy otomatis GitHub Actions.",
  url: "https://school.lananuranf.my.id/",
  applicationCategory: "WebApplication",
  programmingLanguage: ["Go", "SQL"],
  author: { "@type": "Person", name: "Maulana Nur Anfajm", alternateName: "Lananuranf", url: "https://lananuranf.my.id/" },
});
---

<BaseLayout
  title="Letta School API: Backend Manajemen Sekolah dengan Go Fiber | Maulana Nur Anfajm (Lananuranf)"
  description="Studi kasus backend Letta School: REST API Go Fiber dengan PostgreSQL, login JWT, hak akses per peran, Docker Compose di AWS EC2, dan deploy otomatis lewat GitHub Actions. Dibuat oleh Maulana Nur Anfajm (Lananuranf)."
  canonicalURL="https://lananuranf.my.id/projects/letta-school/"
  extraSchema={projectSchema}
>
  <MainLayout />

  <main class="pt-20 min-h-screen bg-surface text-ink">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 py-14">
      <a href="/#projects" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-rose-deep transition-colors mb-8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
        Kembali ke Proyek
      </a>

      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-pink-soft text-rose-deep border border-line">Backend API</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Go</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">AWS EC2</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-3">
          Letta School API: <span class="text-gradient-brand">backend manajemen sekolah</span>
        </h1>
        <p class="text-ink-muted text-base leading-relaxed">
          REST API untuk mengelola data siswa, guru, absensi, dan nilai, dengan login JWT dan hak akses per peran. Berjalan di AWS EC2 dan ter-deploy otomatis setiap ada push ke branch main.
        </p>

        <a href={proof.commitsUrl} target="_blank" rel="noopener noreferrer"
          class="group mt-6 flex items-center gap-4 rounded-2xl border border-line bg-white p-4 hover:border-rose-brand transition-colors">
          <img src={`https://github.com/${GITHUB_USER}.png?size=96`} alt="" width="44" height="44" class="w-11 h-11 rounded-full border border-line shrink-0" />
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold">
              Dibuat oleh @{GITHUB_USER}
              {proof.sharePct !== null && <span class="ml-1 text-lavender-deep font-medium">· {proof.sharePct}% commit</span>}
            </p>
            <p class="text-xs text-ink-muted truncate">
              {[sejak && `Sejak ${sejak}`, proof.myCommits !== null && `${proof.myCommits} commit`, `github.com/${GITHUB_USER}/${proof.repo}`].filter(Boolean).join(" · ")}
            </p>
          </div>
          <span class="hidden sm:inline text-xs font-semibold text-ink-muted group-hover:text-rose-deep whitespace-nowrap">Riwayat commit →</span>
        </a>
      </header>

      <ul class="flex flex-wrap gap-2 mb-12 p-4 bg-white rounded-2xl border border-line" aria-label="Teknologi">
        {TECH.map((label) => {
          const icon = techIcon(label);
          return (
            <li class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 bg-surface border border-line rounded-full">
              {icon && <span class="w-3.5 h-3.5 shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={icon.svg} />}
              {label}
            </li>
          );
        })}
      </ul>

      <div class="flex flex-col gap-12">
        <section aria-labelledby="masalah">
          <h2 id="masalah" class="text-xl font-bold mb-3">Masalah</h2>
          <div class="bg-white border border-line rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Sekolah Letta mengelola data siswa, guru, absensi, jadwal, dan laporan akademik secara manual di spreadsheet. Data mudah salah ketik, tidak punya kontrol akses, dan sulit dibuka beberapa orang sekaligus.</p>
            <p>Sistem penggantinya harus membedakan tiga jenis pengguna dengan hak yang berbeda, dan cukup murah untuk dijalankan di satu server.</p>
          </div>
        </section>

        <section aria-labelledby="backend">
          <h2 id="backend" class="text-xl font-bold mb-3">Cara kerja backend</h2>
          <div class="bg-white border border-line rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>REST API ditulis dengan Go Fiber, dengan GORM untuk akses ke PostgreSQL. Fiber saya pilih karena ringan dan cepat untuk REST API; perbandingannya dengan Express.js saya tulis di <a href="/blog/go-fiber-vs-nodejs-performa/" class="font-semibold text-rose-deep underline underline-offset-2 hover:text-ink">artikel benchmark ini</a>. Antarmuka web (React) memakai API ini, tetapi tulisan ini fokus ke sisi server.</p>
            <p>Hak akses diatur di middleware. Setiap request ke endpoint yang dilindungi melewati dua pemeriksaan. Token JWT harus valid, lalu peran pengguna harus sesuai dengan route yang diminta. Handler hanya berjalan kalau kedua pemeriksaan lolos.</p>
          </div>

          <div class="mt-4 bg-white border border-line rounded-2xl p-5">
            <p class="font-semibold text-sm mb-3">Alur request</p>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 text-xs sm:text-sm text-center">
              <span class="rounded-xl border border-line bg-surface px-3 py-2">Request + <code class="font-mono">Authorization: Bearer</code></span>
              <span class="text-rose-brand" aria-hidden="true">→</span>
              <span class="rounded-xl border-2 border-rose-brand bg-pink-soft/50 px-3 py-2 font-semibold">Middleware JWT</span>
              <span class="text-rose-brand" aria-hidden="true">→</span>
              <span class="rounded-xl border-2 border-lavender bg-lavender-soft px-3 py-2 font-semibold">Cek peran</span>
              <span class="text-rose-brand" aria-hidden="true">→</span>
              <span class="rounded-xl border border-line bg-surface px-3 py-2">Handler → GORM → PostgreSQL</span>
            </div>
            <p class="text-xs text-ink-muted mt-3">Token tidak valid ditolak sebelum menyentuh database; peran yang tidak cocok ditolak sebelum handler dijalankan.</p>
          </div>

          <div class="grid sm:grid-cols-3 gap-3 mt-4">
            {ROLES.map((r) => (
              <div class="bg-white border border-line rounded-2xl p-4">
                <p class="text-sm font-bold text-rose-deep">{r.role}</p>
                <p class="text-sm text-ink-muted leading-relaxed mt-1">{r.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <section aria-labelledby="infra">
          <h2 id="infra" class="text-xl font-bold mb-3">Infrastruktur dan deploy</h2>
          <div class="bg-white border border-line rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Aplikasi berjalan di AWS EC2 (Ubuntu 22.04 LTS) dengan Docker Compose. Nginx menjadi reverse proxy. Tugasnya menangani SSL, mengalihkan HTTP ke HTTPS, menyajikan file statis, dan meneruskan request ke container yang tepat.</p>
          </div>
          <ol class="mt-4 flex flex-col gap-2">
            {PIPELINE.map((step, i) => (
              <li class="flex items-center gap-3 bg-white border border-line rounded-2xl px-4 py-3 text-sm">
                <span class="w-7 h-7 rounded-full bg-gradient-brand text-white text-xs font-bold flex items-center justify-center shrink-0" aria-hidden="true">{i + 1}</span>
                <span class={i === 3 ? "font-mono text-ink" : "text-ink"}>{step}</span>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <div class="mt-12 p-6 bg-white border border-line rounded-2xl text-center">
        <p class="font-bold mb-1">Mau bahas proyek ini lebih jauh?</p>
        <p class="text-sm text-ink-muted mb-4">Saya senang menjelaskan cara kerjanya, atau membicarakan peluang magang dan kerja di bidang backend.</p>
        <div class="flex justify-center gap-3 flex-wrap">
          <a href="mailto:lananuranf@gmail.com" class="px-5 py-2.5 bg-ink text-white font-semibold rounded-xl text-sm hover:bg-lavender-deep transition-colors">Kirim Email</a>
          <a href="/projects/ruang-rasa/" class="px-5 py-2.5 border border-line bg-white text-ink font-semibold rounded-xl text-sm hover:border-rose-brand transition-colors">Studi kasus Ruang Rasa</a>
          <a href="/#projects" class="px-5 py-2.5 border border-line bg-white text-ink font-semibold rounded-xl text-sm hover:border-rose-brand transition-colors">Proyek lain</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
