---
// src/pages/projects/ruang-rasa.astro — Studi kasus backend Ruang Rasa (Rust).
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import { getRepoProof, formatBulanTahun, GITHUB_USER } from "../../lib/github";
import { techIcon } from "../../lib/icons";

const proof = await getRepoProof("ruang-rasa-app");
const sejak = formatBulanTahun(proof.createdAt);

const TECH = ["Rust", "Axum", "Tokio", "SQLx", "PostgreSQL", "PostGIS", "WebSocket", "JWT", "Docker", "Docker Compose", "Caddy", "Ubuntu", "Firebase Cloud Messaging", "Cloudflare R2", "MinIO"];

const STATS = [
  { value: "4", label: "crate Rust: api, domain, infra, shared" },
  { value: "11", label: "migrasi SQL, masing-masing dengan down" },
  { value: "252", label: "test; 89 integrasi ke Postgres sungguhan" },
  { value: "1/50", label: "request paralel lolos untuk kursi terakhir" },
];

const CRATES = [
  { name: "api", desc: "Router Axum, DTO, ekstraktor auth, otorisasi per peran, WebSocket chat. Handler dibuat tipis." },
  { name: "domain", desc: "Aturan bisnis murni tanpa I/O: slot & jam buka, state machine reservasi, kebijakan OTP, skor feed, cursor pagination." },
  { name: "infra", desc: "Query SQLx, hub chat LISTEN/NOTIFY, presign S3, pengirim FCM & OTP, kripto, job latar." },
  { name: "shared", desc: "Tipe error bersama yang dirender sebagai application/problem+json (RFC 9457)." },
];

const ENDPOINTS = [
  { group: "Auth", items: ["POST /auth/otp/request", "POST /auth/otp/verify", "POST /auth/refresh", "POST /auth/logout"] },
  { group: "Discovery", items: ["GET /restaurants/nearby", "GET /restaurants/search", "GET /restaurants/map", "GET /restaurants/{id}/eta", "GET /feed"] },
  { group: "Reservasi", items: ["GET /restaurants/{id}/availability", "POST /reservations", "POST /reservations/{id}/cancel", "POST /merchant/restaurants/{rid}/reservations/{id}/confirm", "POST /merchant/restaurants/{rid}/reservations/check-in"] },
  { group: "Chat", items: ["GET /chat/ws (upgrade WebSocket)", "POST /chat/conversations", "POST /chat/conversations/{id}/read"] },
  { group: "Mitra & media", items: ["POST /merchant/restaurants", "POST /merchant/restaurants/{rid}/submit", "POST /merchant/restaurants/{rid}/media/presign"] },
  { group: "Admin", items: ["POST /admin/merchants/{id}/approve", "POST /admin/reports/{id}/resolve", "GET /admin/audit-logs"] },
];

const FLOW = [
  { title: "Klaim Idempotency-Key", desc: "Kunci dari header disimpan di tabel idempotency_keys bersama hash body. Key yang sama dengan body sama mengembalikan respons lama; body berbeda ditolak." },
  { title: "Kunci baris area", desc: "SELECT … FROM dining_areas … FOR UPDATE. Request lain untuk area yang sama menunggu giliran di sini sebelum sampai ke INSERT." },
  { title: "Validasi kebijakan", desc: "Slot dicek terhadap jam buka (termasuk jam lewat tengah malam), lead time, batas hari ke depan, dan jumlah tamu maksimal." },
  { title: "Hitung ulang kursi", desc: "SUM(party_size) reservasi aktif yang waktunya beririsan. Kalau sisa kursi kurang, transaksi berhenti dengan RSV_SLOT_UNAVAILABLE." },
  { title: "Simpan & kabari", desc: "INSERT reservasi (PENDING, atau langsung CONFIRMED bila kebijakan resto mengizinkan), notifikasi, dan pesan SYSTEM di chat." },
  { title: "Commit", desc: "Respons disimpan ke idempotency_keys. NOTIFY chat ikut terkirim saat commit, jadi tidak ada notifikasi untuk transaksi yang batal." },
];

const STATES = [
  { from: "PENDING", to: ["CONFIRMED", "REJECTED", "CANCELLED", "EXPIRED"] },
  { from: "CONFIRMED", to: ["CHECKED_IN", "NO_SHOW", "CANCELLED"] },
  { from: "CHECKED_IN", to: ["COMPLETED"] },
];

const projectSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Ruang Rasa API",
  description: "Backend reservasi dan discovery restoran dengan Rust (Axum, Tokio, SQLx), PostgreSQL + PostGIS, chat WebSocket, dan deploy Docker Compose.",
  codeRepository: "https://github.com/Lananuranf/ruang-rasa-app",
  programmingLanguage: ["Rust", "SQL"],
  author: { "@type": "Person", name: "Maulana Nur Anfajm", alternateName: "Lananuranf", url: "https://lananuranf.my.id/" },
});
---

<BaseLayout
  title="Ruang Rasa API: Backend Reservasi Restoran dengan Rust | Maulana Nur Anfajm (Lananuranf)"
  description="Studi kasus backend Ruang Rasa: Rust (Axum, SQLx), PostgreSQL + PostGIS, reservasi tanpa overbooking, chat WebSocket dengan LISTEN/NOTIFY, dan deploy Docker Compose. Dibuat oleh Maulana Nur Anfajm (Lananuranf)."
  canonicalURL="https://lananuranf.my.id/projects/ruang-rasa/"
  extraSchema={projectSchema}
>
  <MainLayout />

  <main class="pt-20 min-h-screen bg-surface text-ink">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 py-14">
      <a href="/#projects" class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-rose-deep transition-colors mb-8">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
        Kembali ke Proyek
      </a>

      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-pink-soft text-rose-deep border border-line">Backend API</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Rust</span>
          <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-lavender-soft text-lavender-deep border border-line">Proyek solo</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-3">
          Ruang Rasa API: <span class="text-gradient-brand">backend reservasi restoran</span>
        </h1>
        <p class="text-ink-muted text-base leading-relaxed">
          Ini backend untuk aplikasi Android Ruang Rasa. Di aplikasinya, pengguna melihat suasana dan menu restoran lewat feed, mencari tempat terdekat, memesan meja, lalu chat dengan restorannya. Restoran mendaftar sendiri lewat mode mitra, dan admin menyetujuinya. Tulisan ini membahas sisi server saja.
        </p>

        <a href={proof.commitsUrl} target="_blank" rel="noopener noreferrer"
          class="group mt-6 flex items-center gap-4 rounded-2xl border border-line bg-white p-4 hover:border-rose-brand transition-colors">
          <img src={`https://github.com/${GITHUB_USER}.png?size=96`} alt="" width="44" height="44" class="w-11 h-11 rounded-full border border-line shrink-0" />
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold">
              Dibuat oleh @{GITHUB_USER}
              {proof.sharePct !== null && <span class="ml-1 text-lavender-deep font-medium">· {proof.sharePct}% commit</span>}
            </p>
            <p class="text-xs text-ink-muted truncate">
              {[sejak && `Sejak ${sejak}`, proof.myCommits !== null && `${proof.myCommits} commit`, `github.com/${GITHUB_USER}/${proof.repo}`].filter(Boolean).join(" · ")}
            </p>
          </div>
          <span class="hidden sm:inline text-xs font-semibold text-ink-muted group-hover:text-rose-deep whitespace-nowrap">Riwayat commit →</span>
        </a>
      </header>

      <ul class="flex flex-wrap gap-2 mb-8 p-4 bg-white rounded-2xl border border-line" aria-label="Teknologi">
        {TECH.map((label) => {
          const icon = techIcon(label);
          return (
            <li class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 bg-surface border border-line rounded-full">
              {icon && <span class="w-3.5 h-3.5 shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={icon.svg} />}
              {label}
            </li>
          );
        })}
      </ul>

      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-12">
        {STATS.map((s) => (
          <div class="rounded-2xl bg-white border border-line p-4">
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-2xl font-extrabold text-gradient-brand leading-none">{s.value}</dd>
            <dd class="text-xs text-ink-muted mt-2 leading-snug">{s.label}</dd>
          </div>
        ))}
      </dl>

      <div class="flex flex-col gap-12">
        <section aria-labelledby="masalah">
          <h2 id="masalah" class="text-xl font-bold mb-3">Masalah</h2>
          <div class="bg-white border border-line rounded-2xl p-5 text-ink-muted text-sm leading-relaxed flex flex-col gap-2">
            <p>Reservasi lewat chat gampang bentrok. Dua orang bisa mendapat meja yang sama di jam yang sama, dan aplikasi di HP yang mengulang request saat sinyal putus-putus bisa membuat pesanan ganda.</p>
            <p>Di atas itu, satu backend harus melayani feed foto, pencarian berbasis lokasi, chat real-time antara pengunjung dan restoran, upload media, notifikasi, dan moderasi admin. Anggarannya kecil dan dikerjakan sendiri, jadi jumlah komponen yang harus dirawat perlu ditekan.</p>
          </div>
        </section>

        <section aria-labelledby="arsitektur">
          <h2 id="arsitektur" class="text-xl font-bold mb-3">Arsitektur</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Satu proses Rust, satu database. PostgreSQL menangani data relasional, lokasi (PostGIS), pencarian teks (pg_trgm), antrean event chat (LISTEN/NOTIFY), dan cache ETA. Aplikasi mengunggah file media langsung ke storage memakai presigned URL, jadi file tidak melewati API.</p>

          <figure class="bg-white border border-line rounded-2xl p-4 sm:p-6" aria-label="Diagram arsitektur Ruang Rasa">
            <div class="flex flex-col items-stretch gap-2 text-center text-xs sm:text-sm">
              <div class="rounded-xl border border-line bg-surface px-4 py-3 font-semibold">Aplikasi Android <span class="font-normal text-ink-muted">(HTTPS + WebSocket)</span></div>
              <div class="text-rose-brand leading-none" aria-hidden="true">▼</div>
              <div class="rounded-xl border border-line bg-surface px-4 py-3"><span class="font-semibold">Caddy</span> <span class="text-ink-muted">· TLS otomatis, kompresi zstd/gzip, reverse proxy</span></div>
              <div class="text-rose-brand leading-none" aria-hidden="true">▼</div>
              <div class="rounded-xl border-2 border-rose-brand bg-pink-soft/50 p-3">
                <p class="font-bold mb-2">API Rust · Axum + Tokio <span class="font-normal text-ink-muted">(/api/v1)</span></p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  <span class="rounded-lg bg-white border border-line px-2 py-1.5 font-mono">api</span>
                  <span class="rounded-lg bg-white border border-line px-2 py-1.5 font-mono">domain</span>
                  <span class="rounded-lg bg-white border border-line px-2 py-1.5 font-mono">infra</span>
                  <span class="rounded-lg bg-white border border-line px-2 py-1.5 font-mono">shared</span>
                </div>
                <p class="text-[11px] text-ink-muted mt-2">Job latar: reservasi tiap 60 detik, bersih-bersih cache ETA tiap 30 menit</p>
              </div>
              <div class="text-rose-brand leading-none" aria-hidden="true">▼ ▲</div>
              <div class="rounded-xl border-2 border-lavender bg-lavender-soft px-4 py-3"><span class="font-semibold">PostgreSQL 16 + PostGIS + pg_trgm</span> <span class="text-ink-muted">· LISTEN/NOTIFY untuk chat</span></div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mt-3 pt-3 border-t border-dashed border-line">
                <div class="rounded-xl border border-dashed border-line px-3 py-2"><span class="font-semibold">Cloudflare R2 / MinIO</span><br /><span class="text-ink-muted text-[11px]">upload langsung via presigned URL</span></div>
                <div class="rounded-xl border border-dashed border-line px-3 py-2"><span class="font-semibold">Firebase Cloud Messaging</span><br /><span class="text-ink-muted text-[11px]">push notifikasi & pengingat</span></div>
                <div class="rounded-xl border border-dashed border-line px-3 py-2"><span class="font-semibold">Google Routes</span><br /><span class="text-ink-muted text-[11px]">ETA on-demand, di-cache di tabel eta_cache</span></div>
              </div>
            </div>
            <figcaption class="text-[11px] text-ink-muted mt-4 text-center">Kotak bertepi putus-putus adalah layanan luar. Di mode dev semuanya bisa jalan lokal. MinIO menggantikan storage, push hanya ditulis ke log, OTP memakai kode tetap, dan ETA memakai estimasi haversine bila tidak ada API key.</figcaption>
          </figure>

          <div class="grid sm:grid-cols-2 gap-3 mt-4">
            {CRATES.map((c) => (
              <div class="bg-white border border-line rounded-2xl p-4">
                <p class="font-mono text-sm font-bold text-rose-deep">crates/{c.name}</p>
                <p class="text-sm text-ink-muted leading-relaxed mt-1">{c.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <section aria-labelledby="reservasi">
          <h2 id="reservasi" class="text-xl font-bold mb-3">Alur reservasi tanpa overbooking</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Semua langkah <code class="font-mono text-ink">POST /reservations</code> berjalan dalam satu transaksi. Bagian terpenting ada di langkah 2. Baris area dikunci, sehingga permintaan untuk area yang sama diproses bergiliran dan hitungan kursi di langkah 4 selalu melihat data terbaru.</p>
          <ol class="flex flex-col gap-3">
            {FLOW.map((step, i) => (
              <li class="flex gap-4 bg-white border border-line rounded-2xl p-4">
                <span class="w-8 h-8 rounded-full bg-gradient-brand text-white text-sm font-bold flex items-center justify-center shrink-0" aria-hidden="true">{i + 1}</span>
                <div>
                  <p class="font-semibold text-sm">{step.title}</p>
                  <p class="text-sm text-ink-muted leading-relaxed mt-0.5">{step.desc}</p>
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-5 bg-white border border-line rounded-2xl p-5">
            <p class="font-semibold text-sm mb-3">Status reservasi</p>
            <div class="flex flex-col gap-2">
              {STATES.map((st) => (
                <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                  <span class="px-2 py-1 rounded-md bg-pink-soft text-rose-deep font-semibold">{st.from}</span>
                  <span class="text-ink-muted" aria-label="bisa menjadi">→</span>
                  {st.to.map((t) => <span class="px-2 py-1 rounded-md bg-lavender-soft text-lavender-deep">{t}</span>)}
                </div>
              ))}
            </div>
            <p class="text-xs text-ink-muted leading-relaxed mt-3">Transisi ditulis sebagai fungsi murni di crate domain, lengkap dengan aturan waktu: pembatalan ditutup sesuai batas yang diatur restoran, check-in dibuka sesaat sebelum jadwal, dan no-show baru bisa ditandai setelah masa tenggang. Job latar tiap 60 detik menangani EXPIRED, NO_SHOW, COMPLETED, serta pengingat push H-1 pukul 10.00 dan 2 jam sebelum jadwal.</p>
          </div>

          <div class="mt-5 rounded-2xl border-2 border-rose-brand bg-white p-5">
            <p class="text-xs font-semibold text-rose-deep uppercase tracking-wide mb-1">Dibuktikan lewat test</p>
            <p class="text-sm leading-relaxed">Test <code class="font-mono">tc_rsv_03_parallel_overbooking_only_one_wins</code> mengirim 50 request bersamaan untuk kursi yang sama. Hasilnya sesuai harapan. Satu request berhasil, 49 ditolak dengan kode <code class="font-mono">RSV_SLOT_UNAVAILABLE</code>, dan total kursi terpakai tetap dalam kapasitas.</p>
          </div>
        </section>

        <section aria-labelledby="keputusan">
          <h2 id="keputusan" class="text-xl font-bold mb-3">Keputusan teknis lain</h2>
          <div class="grid gap-3">
            <div class="bg-white border border-line rounded-2xl p-5">
              <p class="font-semibold text-sm">Chat real-time tanpa Redis</p>
              <p class="text-sm text-ink-muted leading-relaxed mt-1">Satu koneksi WebSocket per pengguna menerima event dari semua percakapannya. Pesan baru disimpan, lalu <code class="font-mono text-ink">pg_notify</code> mengirim payload kecil ke hub yang mendengarkan lewat <code class="font-mono text-ink">PgListener</code>. Hub mencari penerima dari database dan meneruskan lewat channel Tokio. Karena NOTIFY ikut transaksi, pesan yang gagal disimpan tidak pernah tersiar. Redis atau broker pesan baru perlu kalau API dijalankan lebih dari satu instance dengan beban tinggi.</p>
            </div>
            <div class="bg-white border border-line rounded-2xl p-5">
              <p class="font-semibold text-sm">Lokasi dan pencarian di database</p>
              <p class="text-sm text-ink-muted leading-relaxed mt-1">Kolom <code class="font-mono text-ink">geography(Point, 4326)</code> dengan <code class="font-mono text-ink">ST_DWithin</code> untuk radius dan <code class="font-mono text-ink">ST_Distance</code> untuk jarak. Pencarian nama dan kota memakai operator <code class="font-mono text-ink">%</code> dari pg_trgm dengan index GIN, jadi salah ketik ringan tetap ketemu. ETA dari Google Routes hanya dihitung saat diminta dan disimpan sementara di tabel cache untuk menekan biaya API.</p>
            </div>
            <div class="bg-white border border-line rounded-2xl p-5">
              <p class="font-semibold text-sm">Login OTP dan sesi yang bisa dicabut</p>
              <p class="text-sm text-ink-muted leading-relaxed mt-1">OTP dibatasi jumlah permintaan per nomor dan per IP, serta jumlah percobaan. Refresh token disimpan sebagai hash dan dirotasi setiap dipakai; kalau token yang sudah dicabut dipakai lagi, seluruh family token itu ikut dicabut. Nomor HP disimpan terenkripsi AES-256-GCM dan dicari lewat hash HMAC.</p>
            </div>
            <div class="bg-white border border-line rounded-2xl p-5">
              <p class="font-semibold text-sm">Error yang konsisten</p>
              <p class="text-sm text-ink-muted leading-relaxed mt-1">Semua error memakai format <code class="font-mono text-ink">application/problem+json</code> (RFC 9457) dengan kode stabil seperti <code class="font-mono text-ink">RSV_SLOT_UNAVAILABLE</code>, sehingga aplikasi bisa menampilkan pesan yang tepat tanpa membaca teks error.</p>
            </div>
          </div>
        </section>

        <section aria-labelledby="endpoint">
          <h2 id="endpoint" class="text-xl font-bold mb-3">Endpoint utama</h2>
          <p class="text-sm text-ink-muted leading-relaxed mb-4">Semua di bawah prefix <code class="font-mono text-ink">/api/v1</code>. Ini sebagian; total ada puluhan route untuk pengunjung, mitra restoran, dan admin.</p>
          <div class="grid sm:grid-cols-2 gap-3">
            {ENDPOINTS.map((g) => (
              <div class="bg-white border border-line rounded-2xl p-4">
                <p class="text-xs font-semibold text-lavender-deep uppercase tracking-wide mb-2">{g.group}</p>
                <ul class="flex flex-col gap-1">
                  {g.items.map((e) => {
                    const [method, ...rest] = e.split(" ");
                    return (
                      <li class="font-mono text-[12px] leading-relaxed break-all">
                        <span class={method === "GET" ? "text-lavender-deep font-bold" : "text-rose-deep font-bold"}>{method}</span>{" "}
                        <span class="text-ink">{rest.join(" ")}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section aria-labelledby="deploy">
          <h2 id="deploy" class="text-xl font-bold mb-3">Deploy dan pengujian</h2>
          <div class="bg-white border border-line rounded-2xl p-5 text-sm text-ink-muted leading-relaxed flex flex-col gap-2">
            <p>Image API dibangun dengan Dockerfile multi-stage (<code class="font-mono text-ink">rust:1-bookworm</code> untuk build, <code class="font-mono text-ink">debian:bookworm-slim</code> untuk runtime). Skrip PowerShell membangun image di laptop, mengirimnya ke server lewat <code class="font-mono text-ink">scp</code>, lalu menjalankan <code class="font-mono text-ink">docker compose up -d</code>. Server menjalankan tiga container (PostGIS, API, dan Caddy) dengan rotasi log. Hanya Caddy yang membuka port ke luar; database dan API berada di jaringan internal Docker.</p>
            <p>Server Ubuntu 24.04 disiapkan sekali lewat skrip. Firewall ufw hanya membuka SSH, 80, dan 443, dan login SSH wajib memakai key.</p>
            <p>Test integrasi memakai <code class="font-mono text-ink">#[sqlx::test]</code>. Setiap test mendapat database Postgres baru yang sudah dimigrasi, jadi race condition diuji ke database asli. Selain overbooking, ada test untuk verifikasi OTP bersamaan, refresh token yang dipakai dua kali, like bersamaan, dan pembuatan restoran bersamaan dengan slug unik.</p>
          </div>
        </section>
      </div>

      <div class="mt-12 p-6 bg-white border border-line rounded-2xl text-center">
        <p class="font-bold mb-1">Mau bahas proyek ini lebih jauh?</p>
        <p class="text-sm text-ink-muted mb-4">Saya senang menjelaskan detail implementasinya, atau membicarakan peluang magang dan kerja di bidang backend.</p>
        <div class="flex justify-center gap-3 flex-wrap">
          <a href="mailto:lananuranf@gmail.com" class="px-5 py-2.5 bg-ink text-white font-semibold rounded-xl text-sm hover:bg-lavender-deep transition-colors">Kirim Email</a>
          {proof.createdAt && <a href={proof.url} target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 border border-line bg-white text-ink font-semibold rounded-xl text-sm hover:border-rose-brand transition-colors">Lihat repo</a>}
          <a href="/#projects" class="px-5 py-2.5 border border-line bg-white text-ink font-semibold rounded-xl text-sm hover:border-rose-brand transition-colors">Proyek lain</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
