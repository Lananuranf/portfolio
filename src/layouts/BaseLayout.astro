    <slot />

    <script>
      const root = document.documentElement;

      // Lepas overlay intro setelah animasinya selesai (cadangan: timeout)
      const intro = document.getElementById('intro');
      if (intro && root.classList.contains('intro-on')) {
        let finished = false;
        const done = () => {
          if (finished) return;
          finished = true;
          intro.remove();
          root.classList.remove('intro-on', 'intro-short');
          window.dispatchEvent(new CustomEvent('intro:done'));
        };
        intro.addEventListener('animationend', (e) => { if (e.target === intro) done(); });
        setTimeout(done, root.classList.contains('intro-short') ? 1600 : 2600);
      } else {
        intro?.remove();
      }

      // Scroll reveal (bertahap per kelompok saudara)
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (root.classList.contains('js-reveal')) {
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const en of entries) {
              if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
            }
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.01 });
          for (const el of els) {
            const sibs = el.parentElement ? Array.from(el.parentElement.children).filter((c) => c.hasAttribute('data-reveal')) : [el];
            el.style.setProperty('--rd', Math.min(sibs.indexOf(el), 6) * 90 + 'ms');
            io.observe(el);
          }
        } else {
          els.forEach((el) => el.classList.add('is-in'));
        }
      }

      // Sorot kursor + tilt ringan pada kartu kaca (hanya pointer halus & tanpa reduced-motion)
      const fine = window.matchMedia('(pointer: fine)').matches;
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine) {
        document.querySelectorAll<HTMLElement>('.glass-card').forEach((card) => {
          const tilt = !calm && card.hasAttribute('data-tilt');
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
            card.style.setProperty('--mx', x * 100 + '%');
            card.style.setProperty('--my', y * 100 + '%');
            if (tilt) card.style.transform = 'perspective(900px) rotateX(' + ((0.5 - y) * 5).toFixed(2) + 'deg) rotateY(' + ((x - 0.5) * 6).toFixed(2) + 'deg) translateY(-4px)';
          });
          card.addEventListener('pointerleave', () => { if (tilt) card.style.transform = ''; });
        });
      }
    </script>
  </body>
