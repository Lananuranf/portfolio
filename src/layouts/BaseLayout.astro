    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Portfolio Lananuranf" />
    <meta property="og:locale" content="id_ID" />
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && (modifiedTime || publishedTime) && <meta property="article:modified_time" content={modifiedTime || publishedTime} />}
    {ogType === "article" && <meta property="article:author" content="https://lananuranf.my.id/" />}

