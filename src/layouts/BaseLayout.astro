---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  extraSchema?: string;
}

const {
  title = "Maulana Nur Anfajm (Lananuranf) — Software Engineer",
  description = "Portfolio Maulana Nur Anfajm alias Lananuranf, software engineer dan mahasiswa Sistem Informasi Universitas Gunadarma semester 7. Membangun aplikasi web dengan React, TypeScript, Go, dan PostgreSQL. Open for internship & freelance.",
  canonicalURL = Astro.url.href,
  ogImage = "/og-image.png",
  extraSchema = "",
} = Astro.props;

const ogImageFull = new URL(ogImage, Astro.site).href;

const schemaPerson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Maulana Nur Anfajm",
  "alternateName": ["Lananuranf", "lananur.anf", "Maulana Anfajm"],
  "url": "https://lananuranf.my.id/",
  "image": "https://lananuranf.my.id/og-image.png",
  "jobTitle": "Software Engineer",
  "description": "Software engineer dan mahasiswa Sistem Informasi semester 7 Universitas Gunadarma Jakarta. Membangun aplikasi web dengan React, TypeScript, Go, dan PostgreSQL.",
  "email": "lananuranf@gmail.com",
  "telephone": "+6285960235008",
  "address": { "@type": "PostalAddress", "addressLocality": "Jakarta", "addressCountry": "ID" },
  "sameAs": [
    "https://github.com/Lananuranf",
    "https://www.linkedin.com/in/maulana-nur-anfajm-759a633b4/",
    "https://www.instagram.com/lananur.anf/"
  ],
  "knowsAbout": [
    "Software Engineering","React","TypeScript","JavaScript","Tailwind CSS","Astro",
    "Go","Go Fiber","Go Gin","REST API","PostgreSQL","GORM","Git","Docker","AWS EC2","Linux"
  ],
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "Universitas Gunadarma", "url": "https://www.gunadarma.ac.id/" }
});

const schemaWebsite = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Portfolio Maulana Nur Anfajm — Lananuranf",
  "alternateName": ["Lananuranf Portfolio","Portfolio Lananuranf","Maulana Nur Anfajm Portfolio"],
  "url": "https://lananuranf.my.id/",
  "description": "Portfolio resmi Maulana Nur Anfajm (Lananuranf) — software engineer dan mahasiswa Sistem Informasi dari Jakarta."
});

const schemaFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Siapa Lananuranf?",
      "acceptedAnswer": { "@type": "Answer", "text": "Lananuranf adalah nama online dari Maulana Nur Anfajm, mahasiswa Sistem Informasi Universitas Gunadarma semester 7 yang berperan sebagai software engineer, fokus membangun aplikasi web frontend dan backend." }
    },
    {
      "@type": "Question",
      "name": "Apa saja proyek Lananuranf?",
      "acceptedAnswer": { "@type": "Answer", "text": "Proyek utama Lananuranf: Letta School, sistem manajemen sekolah (React + Go Fiber + PostgreSQL); toko online dengan Docker (React + Go Gin + PostgreSQL); dan website portfolio ini (Astro + React)." }
    },
    {
      "@type": "Question",
      "name": "Teknologi apa saja yang dipakai Maulana Nur Anfajm?",
      "acceptedAnswer": { "@type": "Answer", "text": "Teknologi utama: React, TypeScript, Tailwind CSS, Go Fiber, Go Gin, PostgreSQL, GORM, Git, Docker, dan AWS EC2." }
    },
    {
      "@type": "Question",
      "name": "Apakah Lananuranf terbuka untuk tawaran kerja?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ya, Maulana Nur Anfajm (Lananuranf) terbuka untuk peluang kerja sebagai Software Engineer. Hubungi via email lananuranf@gmail.com atau LinkedIn." }
    }
  ]
});
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Maulana Nur Anfajm, Lananuranf, portofolio lananuranf, portfolio lananuranf, project lananuranf, blog lananuranf, maulana nur anfajm portfolio, maulana anfajm developer, lananuranf github, Software Engineer, React Developer, Go Fiber Backend, Go Gin, PostgreSQL, Docker, AWS EC2, Sistem Informasi, Universitas Gunadarma, software engineer jakarta, web developer indonesia, portfolio developer indonesia" />
    <meta name="author" content="Maulana Nur Anfajm (Lananuranf)" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Geo -->
    <meta name="geo.region" content="ID-JK" />
    <meta name="geo.placename" content="Jakarta, Indonesia" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageFull} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portfolio Maulana Nur Anfajm (Lananuranf) — Software Engineer Jakarta" />
    <meta property="og:site_name" content="Portfolio Lananuranf" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageFull} />
    <meta name="twitter:image:alt" content="Portfolio Maulana Nur Anfajm (Lananuranf)" />

    <!-- PWA -->
    <meta name="theme-color" content="#f0f9ff" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={schemaPerson} />
    <script type="application/ld+json" set:html={schemaWebsite} />
    <script type="application/ld+json" set:html={schemaFAQ} />
    {extraSchema && <script type="application/ld+json" set:html={extraSchema} />}
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <slot />
  </body>
</html>
