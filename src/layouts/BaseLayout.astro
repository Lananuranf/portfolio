---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  extraSchema?: string;
}

const {
  title = "Maulana Nur Anfajm (Lananuranf) | Backend Engineer",
  description = "Portfolio Maulana Nur Anfajm alias Lananuranf, Backend Engineer dan mahasiswa Sistem Informasi Universitas Gunadarma semester 7. Membangun REST API dan layanan backend dengan Go, Rust, PostgreSQL, dan Docker. Terbuka untuk magang dan proyek freelance.",
  canonicalURL = Astro.url.href,
  ogImage = "/og-image.png",
  extraSchema = "",
} = Astro.props;

const ogImageFull = new URL(ogImage, Astro.site).href;

const schemaPerson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Maulana Nur Anfajm",
  "alternateName": ["Lananuranf", "lananur.anf", "Maulana Anfajm"],
  "url": "https://lananuranf.my.id/",
  "image": "https://lananuranf.my.id/og-image.png",
  "jobTitle": "Backend Engineer",
  "description": "Backend Engineer dan mahasiswa Sistem Informasi semester 7 Universitas Gunadarma Jakarta. Membangun REST API dan layanan backend dengan Go, Rust, PostgreSQL, dan Docker.",
  "email": "lananuranf@gmail.com",
  "telephone": "+6285960235008",
  "address": { "@type": "PostalAddress", "addressLocality": "Jakarta", "addressCountry": "ID" },
  "sameAs": [
    "https://github.com/Lananuranf",
    "https://www.linkedin.com/in/maulana-nur-anfajm-759a633b4/",
    "https://www.instagram.com/lananur.anf/"
  ],
  "knowsAbout": [
    "Backend Engineering","Go","Go Fiber","Go Gin","Rust","Axum","REST API",
    "PostgreSQL","PostGIS","GORM","Docker","Docker Compose","Nginx","Linux","Git","GitHub Actions"
  ],
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "Universitas Gunadarma", "url": "https://www.gunadarma.ac.id/" }
});

const schemaWebsite = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Portfolio Maulana Nur Anfajm (Lananuranf)",
  "alternateName": ["Lananuranf Portfolio","Portfolio Lananuranf","Maulana Nur Anfajm Portfolio"],
  "url": "https://lananuranf.my.id/",
  "description": "Portfolio resmi Maulana Nur Anfajm (Lananuranf), Backend Engineer dan mahasiswa Sistem Informasi dari Jakarta."
});

const schemaFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Siapa Lananuranf?",
      "acceptedAnswer": { "@type": "Answer", "text": "Lananuranf adalah nama online dari Maulana Nur Anfajm, mahasiswa Sistem Informasi Universitas Gunadarma semester 7 yang berperan sebagai Backend Engineer, fokus membangun REST API, database, dan deployment server." }
    },
    {
      "@type": "Question",
      "name": "Apa saja proyek Lananuranf?",
      "acceptedAnswer": { "@type": "Answer", "text": "Proyek utama Lananuranf: Ruang Rasa, backend aplikasi reservasi restoran (Rust Axum + PostgreSQL/PostGIS); Letta School, sistem manajemen sekolah (Go Fiber + PostgreSQL); toko online dengan Docker (Go Gin + PostgreSQL); dan website portfolio ini (Astro)." }
    },
    {
      "@type": "Question",
      "name": "Teknologi apa saja yang dipakai Maulana Nur Anfajm?",
      "acceptedAnswer": { "@type": "Answer", "text": "Teknologi utama: Go (Fiber, Gin), Rust (Axum), PostgreSQL, GORM, Docker, Nginx, Linux, dan Git." }
    },
    {
      "@type": "Question",
      "name": "Apakah Lananuranf terbuka untuk tawaran kerja?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ya, Maulana Nur Anfajm (Lananuranf) terbuka untuk peluang kerja sebagai Backend Engineer. Hubungi via email lananuranf@gmail.com atau LinkedIn." }
    }
  ]
});
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Maulana Nur Anfajm, Lananuranf, portofolio lananuranf, portfolio lananuranf, project lananuranf, blog lananuranf, maulana nur anfajm portfolio, maulana anfajm developer, lananuranf github, Backend Engineer, Go Backend Developer, Rust Axum, Go Fiber, Go Gin, PostgreSQL, Docker, Sistem Informasi, Universitas Gunadarma, Backend Engineer jakarta, web developer indonesia, portfolio developer indonesia" />
    <meta name="author" content="Maulana Nur Anfajm (Lananuranf)" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Geo -->
    <meta name="geo.region" content="ID-JK" />
    <meta name="geo.placename" content="Jakarta, Indonesia" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageFull} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portfolio Maulana Nur Anfajm (Lananuranf), Backend Engineer Jakarta" />
    <meta property="og:site_name" content="Portfolio Lananuranf" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageFull} />
    <meta name="twitter:image:alt" content="Portfolio Maulana Nur Anfajm (Lananuranf)" />

    <!-- PWA -->
    <meta name="theme-color" content="#FA699E" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={schemaPerson} />
    <script type="application/ld+json" set:html={schemaWebsite} />
    <script type="application/ld+json" set:html={schemaFAQ} />
    {extraSchema && <script type="application/ld+json" set:html={extraSchema} />}
  </head>
  <body class="bg-surface text-ink font-sans antialiased">
    <slot />
  </body>
</html>
