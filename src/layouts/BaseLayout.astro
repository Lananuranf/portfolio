// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Crumb { name: string; url: string; }
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** "article" untuk artikel blog (memunculkan article:published_time). */
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  /** Person, WebSite, dan FAQ hanya dipasang di beranda. */
  isHome?: boolean;
  /** Jejak halaman untuk BreadcrumbList (tanpa Beranda, ditambahkan otomatis). */
  breadcrumbs?: Crumb[];
  extraSchema?: string;
  /** true untuk halaman yang tidak boleh diindeks (mis. 404). */
  noindex?: boolean;
}

const {
  title = "Maulana Nur Anfajm (Lananuranf) | Backend Engineer",
  description = "Portfolio Maulana Nur Anfajm (Lananuranf), Backend Engineer dari Jakarta. Membangun REST API dengan Go, Rust, PostgreSQL, dan Docker.",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = "/og-image.png",
  ogImageAlt = "Portfolio Maulana Nur Anfajm (Lananuranf), Backend Engineer",
  ogType = "website",
  publishedTime,
  modifiedTime,
  isHome = false,
  breadcrumbs = [],
  extraSchema = "",
  noindex = false,
} = Astro.props;

const schemaBreadcrumb = breadcrumbs.length
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Beranda", url: "https://lananuranf.my.id/" }, ...breadcrumbs].map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    })
  : "";

const ogImageFull = new URL(ogImage, Astro.site).href;

const schemaPerson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://lananuranf.my.id/#person",
  "name": "Maulana Nur Anfajm",
  "alternateName": ["Lananuranf","lananur.anf","lananur anf","Lananur","Lananuranf Maulana","Lananuran","Lanannuranf","Lananuranff","Lanan Nur Anf","Maulana Anfajm","Maulana Nur Anfajm","Maulana Nur Anfaj","Maulana Nur Anfajim","Maulana Nur Anfazm","Maulana Nur Anfam","Maulana Nur Anfajn","Maulana Nur Anpajm"],
  "url": "https://lananuranf.my.id/",
  "image": "https://lananuranf.my.id/og-image.png",
  "jobTitle": "Backend Engineer",
  "description": "Backend Engineer dan mahasiswa Sistem Informasi semester 7 Universitas Gunadarma Jakarta. Membangun REST API dan layanan backend dengan Go, Rust, PostgreSQL, dan Docker.",
  "email": "lananuranf@gmail.com",
  "address": { "@type": "PostalAddress", "addressLocality": "Jakarta", "addressCountry": "ID" },
  "sameAs": [
    "https://github.com/Lananuranf",
    "https://www.linkedin.com/in/maulana-nur-anfajm-759a633b4/",
    "https://www.instagram.com/lananur.anf/"
  ],
  "knowsAbout": [
    "Backend Engineering","Go","Go Fiber","Go Gin","Rust","Axum","REST API",
    "PostgreSQL","PostGIS","GORM","Docker","Docker Compose","Nginx","Linux","Git","GitHub Actions"
  ],
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "Universitas Gunadarma", "url": "https://www.gunadarma.ac.id/" }
});

const schemaWebsite = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://lananuranf.my.id/#website",
  "inLanguage": "id",
  "author": { "@id": "https://lananuranf.my.id/#person" },
  "name": "Portfolio Maulana Nur Anfajm (Lananuranf)",
  "alternateName": ["Lananuranf Portfolio","Portfolio Lananuranf","Lananur Portfolio","lananuranf.my.id","Maulana Nur Anfajm Portfolio","Maulana Anfajm Portfolio"],
  "url": "https://lananuranf.my.id/",
  "description": "Portfolio resmi Maulana Nur Anfajm (Lananuranf), Backend Engineer dan mahasiswa Sistem Informasi dari Jakarta."
});

const schemaFAQ = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Siapa Lananuranf?",
      "acceptedAnswer": { "@type": "Answer", "text": "Lananuranf adalah nama online dari Maulana Nur Anfajm, mahasiswa Sistem Informasi Universitas Gunadarma semester 7 yang berperan sebagai Backend Engineer, fokus membangun REST API, database, dan deployment server." }
    },
    {
      "@type": "Question",
      "name": "Apa saja proyek Lananuranf?",
      "acceptedAnswer": { "@type": "Answer", "text": "Proyek utama Lananuranf: Ruang Rasa, backend aplikasi reservasi restoran (Rust Axum + PostgreSQL/PostGIS); Hii Stranger, backend toko online untuk proyek capstone tim (Go + PostgreSQL); Laundry Lastri, API manajemen laundry untuk Penulisan Ilmiah (Laravel 12); dan website portfolio ini (Astro)." }
    },
    {
      "@type": "Question",
      "name": "Teknologi apa saja yang dipakai Maulana Nur Anfajm?",
      "acceptedAnswer": { "@type": "Answer", "text": "Teknologi utama: Go (Fiber, Gin), Rust (Axum), PostgreSQL, GORM, Docker, Nginx, Linux, dan Git." }
    },
    {
      "@type": "Question",
      "name": "Apakah Lananur, Lananuran, atau Maulana Anfajm itu sama dengan Lananuranf?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ya. Lananur, Lananuran, lananur.anf, Maulana Anfajm, dan Maulana Nur Anfajm merujuk pada orang yang sama, yaitu Backend Engineer dari Jakarta dengan situs resmi https://lananuranf.my.id/." }
    },
    {
      "@type": "Question",
      "name": "Apakah Lananuranf terbuka untuk tawaran kerja?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ya, Maulana Nur Anfajm (Lananuranf) terbuka untuk peluang kerja sebagai Backend Engineer. Hubungi via email lananuranf@gmail.com atau LinkedIn." }
    }
  ]
});
