    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Intro & scroll-reveal: diputuskan sebelum paint (tanpa JS / crawler = halaman normal) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (/bot|crawl|spider|lighthouse|headless/i.test(navigator.userAgent)) return;
          d.classList.add('js-reveal');
          // sekali per sesi untuk tiap halaman (beranda, indeks blog, tiap artikel)
          var p = location.pathname.replace(/\/+$/, '') || '/';
          var k = 'intro-seen:' + p;
          if (!sessionStorage.getItem(k)) {
            sessionStorage.setItem(k, '1');
            d.classList.add('intro-on');
            // versi singkat di blog agar tidak menunda membaca
            if (/^\/blog(\/|$)/.test(p)) d.classList.add('intro-short');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />

    <!-- Schema.org -->
    {isHome && <script type="application/ld+json" set:html={schemaPerson} />}
    {isHome && <script type="application/ld+json" set:html={schemaWebsite} />}
    {isHome && <script type="application/ld+json" set:html={schemaFAQ} />}
    {schemaBreadcrumb && <script type="application/ld+json" set:html={schemaBreadcrumb} />}
    {extraSchema && <script type="application/ld+json" set:html={extraSchema} />}
