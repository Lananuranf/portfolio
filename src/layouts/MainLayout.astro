---
// src/layouts/MainLayout.astro — Navbar mengambang (pill) dengan shadow, zero JS framework
const LINKS = [
  { label: "Beranda",  href: "/#home"     },
  { label: "Tentang",  href: "/#about"    },
  { label: "Keahlian", href: "/#skills"   },
  { label: "Proyek",   href: "/#projects" },
  { label: "Blog",     href: "/blog/"     },
  { label: "Kontak",   href: "/#contact"  },
];
---

<header class="fixed inset-x-0 top-3 z-50 px-4" >
  <nav
    id="navbar"
    aria-label="Navigasi utama"
    class="relative max-w-5xl mx-auto h-12 pl-5 pr-2 flex items-center justify-between rounded-full
           bg-white/80 backdrop-blur-md ring-1 ring-slate-900/5
           shadow-[0_4px_20px_-6px_rgba(15,23,42,0.15)] transition-shadow duration-300"
  >
    <a href="/" class="text-lg font-bold tracking-tight text-slate-900 hover:opacity-80 transition-opacity">
      Lananuranf
    </a>

    <!-- Desktop -->
    <div class="hidden md:flex items-center gap-1 text-sm font-medium">
      {LINKS.map((link) => (
        <a href={link.href} data-nav-link
          class="nav-link px-3.5 py-1.5 rounded-full text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-all duration-200">
          {link.label}
        </a>
      ))}
    </div>

    <!-- Tombol CTA desktop -->
    <a href="/#contact"
      class="hidden md:inline-flex items-center px-4 py-1.5 rounded-full bg-slate-900 text-white text-sm font-medium
             shadow-md shadow-slate-900/20 hover:bg-slate-800 hover:shadow-lg hover:-translate-y-px transition-all duration-200">
      Hubungi
    </a>

    <!-- Hamburger -->
    <button type="button" id="menu-btn" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-menu"
      class="md:hidden flex flex-col justify-center items-center w-9 h-9 gap-1.5 rounded-full hover:bg-slate-100 transition-colors">
      <span id="bar1" class="block w-4.5 h-0.5 bg-slate-800 rounded-full transition-all duration-300 origin-center"></span>
      <span id="bar2" class="block w-4.5 h-0.5 bg-slate-800 rounded-full transition-all duration-300"></span>
      <span id="bar3" class="block w-4.5 h-0.5 bg-slate-800 rounded-full transition-all duration-300 origin-center"></span>
    </button>

    <!-- Mobile menu -->
    <div id="mobile-menu"
      class="md:hidden hidden absolute top-full left-0 right-0 mt-2 p-2 rounded-2xl bg-white/95 backdrop-blur-md
             ring-1 ring-slate-900/5 shadow-[0_12px_32px_-8px_rgba(15,23,42,0.25)]">
      {LINKS.map((link) => (
        <a href={link.href} data-nav-link
          class="mobile-link nav-link block px-4 py-3 rounded-xl text-slate-600 font-medium hover:bg-slate-100 hover:text-slate-900 transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .nav-link.is-active {
    color: rgb(15 23 42);
    background-color: rgb(241 245 249);
    box-shadow: inset 0 0 0 1px rgb(15 23 42 / 0.06), 0 1px 2px rgb(15 23 42 / 0.08);
  }
</style>

<script>
  const navbar = document.getElementById('navbar')!;
  const btn    = document.getElementById('menu-btn')!;
  const menu   = document.getElementById('mobile-menu')!;
  const bar1   = document.getElementById('bar1')!;
  const bar2   = document.getElementById('bar2')!;
  const bar3   = document.getElementById('bar3')!;
  let isOpen   = false;

  // Shadow lebih tegas saat halaman di-scroll
  const updateNav = () => {
    const scrolled = window.scrollY > 20;
    navbar.classList.toggle('shadow-[0_8px_30px_-8px_rgba(15,23,42,0.28)]', scrolled);
    navbar.classList.toggle('bg-white/90', scrolled);
  };
  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();

  // Tandai link aktif
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const setActive = (href: string) => {
    links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === href));
  };
  if (location.pathname.startsWith('/blog')) {
    setActive('/blog/');
  } else if (location.pathname === '/') {
    const ids = ['home', 'about', 'skills', 'projects', 'contact'];
    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive('/#' + e.target.id); });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => observer.observe(s));
  }

  // Mobile toggle
  const setMenu = (open: boolean) => {
    isOpen = open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    menu.classList.toggle('hidden', !open);
    bar1.classList.toggle('translate-y-2',  open);
    bar1.classList.toggle('rotate-45',      open);
    bar2.classList.toggle('opacity-0',      open);
    bar3.classList.toggle('-translate-y-2', open);
    bar3.classList.toggle('-rotate-45',     open);
  };
  btn.addEventListener('click', () => setMenu(!isOpen));
  document.querySelectorAll('.mobile-link').forEach((l) => l.addEventListener('click', () => setMenu(false)));
  document.addEventListener('click', (e) => { if (isOpen && !navbar.contains(e.target as Node)) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) setMenu(false); });
</script>
