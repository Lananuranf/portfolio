---
// src/layouts/MainLayout.astro — Navbar "liquid glass": pill atas (desktop: link teks) + bar ikon bawah (<1024px)
const ICONS = {
  user: '<circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  layers: '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/>',
  briefcase: '<rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  book: '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  download: '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
};
const LINKS = [
  { label: "Tentang",  href: "/#about",    icon: ICONS.user,      hint: "Tentang saya" },
  { label: "Keahlian", href: "/#skills",   icon: ICONS.layers,    hint: "Keahlian" },
  { label: "Proyek",   href: "/#projects", icon: ICONS.briefcase, hint: "Proyek" },
  { label: "Blog",     href: "/blog/",     icon: ICONS.book,      hint: "Blog" },
  { label: "Kontak",   href: "/#contact",  icon: ICONS.mail,      hint: "Kontak" },
];
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:rounded-full focus:bg-ink focus:text-white focus:text-sm"
>
  Lompat ke konten
</a>

<header class="fixed inset-x-0 top-3 z-50 px-3 sm:px-4 pointer-events-none">
  <nav
    id="navbar"
    aria-label="Navigasi utama"
    class="nav-glass pointer-events-auto relative w-fit lg:w-auto max-w-5xl mx-auto h-11 lg:h-14 px-4 lg:pl-5 lg:pr-1.5 flex items-center justify-between gap-2 rounded-full"
  >
    <a href="/" class="shrink-0 font-mono text-sm lg:text-base font-semibold tracking-tight text-ink hover:text-rose-deep transition-colors">
      lananuranf<span class="text-rose-deep" aria-hidden="true">_</span>
    </a>

    <!-- Desktop (>=1024px): link teks -->
    <ul class="hidden lg:flex items-center gap-1 text-sm font-medium" role="list">
      {LINKS.map((link) => (
        <li>
          <a href={link.href} data-nav-link
            class="nav-pill block px-4 py-2 rounded-full text-ink transition-colors duration-200">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Satu-satunya tombol Unduh CV di situs (desktop); tablet/HP memakai ikon di bar bawah -->
    <a href="/cv.pdf" download
      class="hidden lg:inline-flex shrink-0 items-center gap-1.5 h-11 px-5 rounded-full bg-rose-deep text-white text-sm font-semibold
             shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_6px_16px_-8px_rgba(190,45,101,0.7)]
             hover:bg-ink transition-colors duration-200">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.download} />
      Unduh CV
    </a>
  </nav>
</header>

<!-- Tablet & ponsel (<1024px): bar ikon mengambang di bawah -->
<nav aria-label="Navigasi cepat" class="nav-dock lg:hidden fixed inset-x-0 bottom-0 z-50 px-3 pointer-events-none">
  <ul role="list" class="nav-glass pointer-events-auto mx-auto w-fit max-w-full flex items-center gap-0.5 p-1.5 rounded-full">
    {LINKS.map((link) => (
      <li>
        <a href={link.href} data-nav-link aria-label={link.hint} title={link.hint}
          class="nav-pill nav-icon flex items-center justify-center w-11 h-11 rounded-full text-ink">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={link.icon} />
        </a>
      </li>
    ))}
    <li aria-hidden="true" class="w-px h-6 mx-0.5 bg-ink/15"></li>
    <li>
      <a href="/cv.pdf" download aria-label="Unduh CV (PDF)" title="Unduh CV"
        class="nav-icon flex items-center justify-center w-11 h-11 rounded-full bg-rose-deep text-white hover:bg-ink transition-colors
               shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_6px_16px_-8px_rgba(190,45,101,0.7)]">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.download} />
      </a>
    </li>
  </ul>
</nav>

<script>
  const navbar = document.getElementById('navbar')!;

  // Kaca lebih pekat + bayangan lebih tegas saat halaman di-scroll
  const updateNav = () => navbar.classList.toggle('is-scrolled', window.scrollY > 20);
  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();

  // Tandai link aktif (scrollspy ringan) — berlaku untuk link teks desktop & ikon bar bawah
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const setActive = (href: string) => {
    links.forEach((a) => {
      const on = a.getAttribute('href') === href;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', href.startsWith('/#') ? 'location' : 'page');
      else a.removeAttribute('aria-current');
    });
  };
  if (location.pathname.startsWith('/blog')) {
    setActive('/blog/');
  } else if (location.pathname === '/') {
    const ids = ['home', 'about', 'skills', 'projects', 'blog', 'contact'];
    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = e.target.id;
        setActive(id === 'home' ? '' : id === 'blog' ? '/blog/' : '/#' + id);
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => observer.observe(s));
  }
</script>
