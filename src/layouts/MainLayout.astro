---
// src/layouts/MainLayout.astro — Navbar "liquid glass" mengambang (pill), tanpa JS framework
const LINKS = [
  { label: "Tentang",  href: "/#about"    },
  { label: "Keahlian", href: "/#skills"   },
  { label: "Proyek",   href: "/#projects" },
  { label: "Blog",     href: "/blog/"     },
  { label: "Kontak",   href: "/#contact"  },
];
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:rounded-full focus:bg-ink focus:text-white focus:text-sm"
>
  Lompat ke konten
</a>

<header class="fixed inset-x-0 top-3 z-50 px-3 sm:px-4">
  <nav
    id="navbar"
    aria-label="Navigasi utama"
    class="nav-glass relative max-w-5xl mx-auto h-14 pl-4 sm:pl-5 pr-1.5 flex items-center justify-between gap-2 rounded-full"
  >
    <a href="/" class="shrink-0 font-mono text-base font-semibold tracking-tight text-ink hover:text-rose-deep transition-colors">
      lananuranf<span class="text-rose-deep" aria-hidden="true">_</span>
    </a>

    <!-- Desktop (>=1024px) -->
    <ul class="hidden lg:flex items-center gap-1 text-sm font-medium" role="list">
      {LINKS.map((link) => (
        <li>
          <a href={link.href} data-nav-link
            class="nav-pill block px-4 py-2 rounded-full text-ink transition-colors duration-200">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1.5 shrink-0">
      <!-- Unduh CV: tampil mulai 640px; di ponsel ada di panel menu -->
      <a href="/cv.pdf" download
        class="hidden sm:inline-flex items-center gap-1.5 h-11 px-5 rounded-full bg-rose-deep text-white text-sm font-semibold
               shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_6px_16px_-8px_rgba(190,45,101,0.7)]
               hover:bg-ink transition-colors duration-200">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
        Unduh CV
      </a>

      <!-- Hamburger (<1024px) -->
      <button type="button" id="menu-btn" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-menu"
        class="nav-pill lg:hidden flex flex-col justify-center items-center w-11 h-11 gap-1.5 rounded-full">
        <span class="nav-bar nav-bar-1 block w-[18px] h-0.5 bg-ink rounded-full"></span>
        <span class="nav-bar nav-bar-2 block w-[18px] h-0.5 bg-ink rounded-full"></span>
        <span class="nav-bar nav-bar-3 block w-[18px] h-0.5 bg-ink rounded-full"></span>
      </button>
    </div>

    <!-- Panel menu (<1024px) -->
    <div id="mobile-menu" hidden
      class="nav-glass nav-panel lg:hidden absolute top-full left-0 right-0 mt-2 p-2 rounded-3xl overflow-y-auto">
      <ul role="list" class="flex flex-col gap-1">
        {LINKS.map((link) => (
          <li>
            <a href={link.href} data-nav-link
              class="mobile-link nav-pill flex items-center min-h-12 px-4 rounded-2xl text-ink text-base font-medium transition-colors">
              {link.label}
            </a>
          </li>
        ))}
        <li class="sm:hidden pt-1">
          <a href="/cv.pdf" download
            class="mobile-link flex items-center justify-center gap-2 min-h-12 px-4 rounded-2xl bg-rose-deep text-white font-semibold hover:bg-ink transition-colors">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            Unduh CV
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const navbar = document.getElementById('navbar')!;
  const btn    = document.getElementById('menu-btn') as HTMLButtonElement;
  const menu   = document.getElementById('mobile-menu')!;
  let isOpen   = false;

  // Kaca lebih pekat + bayangan lebih tegas saat halaman di-scroll
  const updateNav = () => navbar.classList.toggle('is-scrolled', window.scrollY > 20);
  window.addEventListener('scroll', updateNav, { passive: true });
  updateNav();

  // Tandai link aktif (scrollspy ringan)
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const setActive = (href: string) => {
    links.forEach((a) => {
      const on = a.getAttribute('href') === href;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', href.startsWith('/#') ? 'location' : 'page');
      else a.removeAttribute('aria-current');
    });
  };
  if (location.pathname.startsWith('/blog')) {
    setActive('/blog/');
  } else if (location.pathname === '/') {
    const ids = ['home', 'about', 'skills', 'projects', 'blog', 'contact'];
    const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const id = e.target.id;
        setActive(id === 'home' ? '' : id === 'blog' ? '/blog/' : '/#' + id);
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => observer.observe(s));
  }

  // Menu ponsel/tablet
  const focusables = () =>
    [btn, ...Array.from(menu.querySelectorAll<HTMLElement>('a[href]'))].filter((el) => el.offsetParent !== null);

  const setMenu = (open: boolean, returnFocus = false) => {
    if (open === isOpen) return;
    isOpen = open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    menu.hidden = !open;
    navbar.classList.toggle('is-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.querySelector<HTMLElement>('a[href]')?.focus();
    else if (returnFocus) btn.focus();
  };

  btn.addEventListener('click', () => setMenu(!isOpen));
  menu.querySelectorAll('.mobile-link').forEach((l) => l.addEventListener('click', () => setMenu(false)));
  document.addEventListener('click', (e) => { if (isOpen && !navbar.contains(e.target as Node)) setMenu(false); });
  document.addEventListener('keydown', (e) => {
    if (!isOpen) return;
    if (e.key === 'Escape') { e.preventDefault(); setMenu(false, true); return; }
    if (e.key === 'Tab') {
      // Jebak fokus di tombol + panel selama menu terbuka
      const items = focusables();
      const first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  // Tutup otomatis saat layar dilebarkan ke desktop
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });
</script>
