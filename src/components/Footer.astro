---

<footer class="bg-slate-950 text-slate-400 px-6 pt-14 pb-8" aria-label="Footer">
  <div class="max-w-5xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-start justify-between gap-10">
      <div class="max-w-sm">
        <a href="/" class="text-xl font-extrabold text-white tracking-tight">Lananuranf</a>
        <p class="text-sm mt-3 leading-relaxed">
          Maulana Nur Anfajm — mahasiswa Sistem Informasi Universitas Gunadarma
          yang suka membangun aplikasi web dan mengolah data.
        </p>
        <a href="/cv.pdf" download="CV_Maulana_Nur_Anfajm.pdf"
          class="inline-flex items-center gap-2 mt-5 text-sm font-medium text-white border border-slate-700 rounded-lg px-4 py-2 hover:border-slate-400 transition-colors">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
          Unduh CV
        </a>
      </div>

      <nav aria-label="Navigasi footer" class="grid grid-cols-2 sm:grid-cols-3 gap-x-10 gap-y-2 text-sm">
        {NAV.map((l) => (
          <a href={l.href} class="hover:text-white transition-colors">{l.label}</a>
        ))}
      </nav>

      <div class="flex gap-2">
        {SOCIAL.map((s) => (
          <a href={s.href} target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer"
            aria-label={s.label} title={s.label}
            class="w-9 h-9 grid place-items-center rounded-lg border border-slate-800 hover:border-slate-500 hover:text-white transition-colors">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true"><path d={s.d} /></svg>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
      <p>
        &copy; {year} <span class="text-slate-200 font-medium">Maulana Nur Anfajm</span>. Hak cipta dilindungi.
      </p>
      <div class="flex items-center gap-4">
        <span class="text-slate-500">Dibuat dengan Astro &amp; Tailwind CSS</span>
        <a href="#top" class="inline-flex items-center gap-1 hover:text-white transition-colors" aria-label="Kembali ke atas">
          Ke atas
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0-6 6m6-6 6 6" /></svg>
        </a>
      </div>
    </div>

  </div>
</footer>
