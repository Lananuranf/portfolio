---
// src/components/ContactSection.astro
// Ikon brand dari paket pihak ketiga, di-inline saat build (tanpa JS di browser):
// - simple-icons: Gmail, GitHub
// - Font Awesome Free Brands: LinkedIn (simple-icons tidak lagi menyediakan logo LinkedIn)
import { siGmail, siGithub } from "simple-icons";
import { faLinkedin } from "@fortawesome/free-brands-svg-icons";

const [liW, liH, , , liPath] = faLinkedin.icon;

const CONTACTS = [
    {
        name: "Email",
        value: "lananuranf@gmail.com",
        href: "mailto:lananuranf@gmail.com",
        hex: `#${siGmail.hex}`,
        viewBox: "0 0 24 24",
        path: siGmail.path,
        external: false,
    },
    {
        name: "GitHub",
        value: "@Lananuranf",
        href: "https://github.com/Lananuranf",
        hex: `#${siGithub.hex}`,
        viewBox: "0 0 24 24",
        path: siGithub.path,
        external: true,
    },
    {
        name: "LinkedIn",
        value: "Maulana Nur Anfajm",
        href: "https://www.linkedin.com/in/maulana-nur-anfajm-759a633b4/",
        hex: "#0A66C2",
        viewBox: `0 0 ${liW} ${liH}`,
        path: String(liPath),
        external: true,
    },
];
---

<section id="contact" class="glass-scene scene-sky px-5 md:px-12 py-20 md:py-28 bg-white border-t border-line" aria-labelledby="contact-heading">
    <div class="max-w-5xl mx-auto grid gap-10 md:grid-cols-[1fr_1.2fr] md:items-center">
        <div data-reveal>
            <p class="text-xs font-semibold tracking-widest uppercase text-rose-deep mb-2">Kontak</p>
            <h2 id="contact-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink">
                Mari ngobrol
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-ink-muted">
                Saya terbuka untuk magang dan proyek freelance di bidang backend. Kalau ingin diskusi soal
                Go, Rust, atau PostgreSQL, kirim pesan lewat salah satu kanal berikut.
            </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2">
            {CONTACTS.map((c) => (
                <li data-reveal>
                    <a
                        href={c.href}
                        target={c.external ? "_blank" : undefined}
                        rel={c.external ? "noopener noreferrer" : undefined}
                        aria-label={`${c.name}: ${c.value}${c.external ? " (tab baru)" : ""}`}
                        class="glass-card lift group flex items-center gap-4 rounded-2xl p-4"
                    >
                        <span
                            class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-line bg-surface"
                            aria-hidden="true"
                        >
                            <svg viewBox={c.viewBox} class="h-6 w-6" fill={c.hex}>
                                <path d={c.path} />
                            </svg>
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block text-sm font-semibold text-ink">{c.name}</span>
                            <span class="block truncate text-sm text-ink-muted">{c.value}</span>
                        </span>
                        <svg
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true"
                            class="h-5 w-5 shrink-0 text-ink-muted transition-colors group-hover:text-rose-deep"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02z"
                                clip-rule="evenodd"
                            />
                        </svg>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
