---
// src/components/AboutSection.astro — HTML statis (tanpa JS), mudah dibaca mesin pencari.
const FACTS = [
    { label: "Pendidikan", value: "S1 Sistem Informasi, Universitas Gunadarma (semester 7)" },
    { label: "Domisili", value: "Jakarta, Indonesia" },
    { label: "Sedang dikerjakan", value: "Ruang Rasa, backend reservasi restoran" },
];

const WAYS = [
    {
        title: "Urai masalahnya dulu",
        desc: "Sebelum menulis kode, saya cari tahu dulu data apa yang dibutuhkan dan siapa yang boleh mengaksesnya. Kodenya saya pisah ke handler, service, dan repository supaya tiap bagian tetap kecil.",
        d: "M9.5 3h5M12 3v3m-6.4 2.6L4 7m14.4 1.6L20 7M12 21a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15zm0-11v4l2.5 2",
    },
    {
        title: "Belajar mandiri",
        desc: "Go dan Rust saya pelajari sendiri dari dokumentasi resmi, lalu langsung saya pakai di proyek. Awalnya memang lebih lambat. Tapi dengan begitu saya paham alasan di balik tiap pilihan.",
        d: "M12 6.5C10.3 5 7.9 4.5 4 4.5v13c3.9 0 6.3.5 8 2 1.7-1.5 4.1-2 8-2v-13c-3.9 0-6.3.5-8 2zm0 0v13",
    },
    {
        title: "Menulis supaya bisa diulang",
        desc: "Langkah setup dan deploy saya catat di README supaya proyeknya bisa dijalankan ulang tanpa menebak. Sebagian catatan itu kemudian saya kembangkan jadi artikel di blog ini.",
        d: "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5zm0 0v5h5M9 13h6M9 17h4",
    },
    {
        title: "Terbiasa kerja per sprint",
        desc: "Capstone Hii Stranger kami kerjakan dengan Scrum dalam tiga sprint, masing-masing ditutup dengan demo dan retrospektif. Commit saya buat kecil dengan pesan yang jelas, dan untuk deploy saya sedang belajar GitHub Actions.",
        d: "M9 12.5l2 2 4-4.5M12 3l7 3v5.5c0 4.3-2.9 8-7 9.5-4.1-1.5-7-5.2-7-9.5V6l7-3z",
    },
];
---

<section id="about" class="lazy-section glass-scene scene-sky px-5 md:px-12 py-20 md:py-28" aria-labelledby="about-heading">
    <div class="max-w-5xl mx-auto grid gap-12 md:grid-cols-[18rem_1fr] md:gap-14">
        <!-- Foto + fakta singkat -->
        <div class="flex flex-col gap-5" data-reveal>
            <div class="relative w-full max-w-sm mx-auto md:max-w-none md:mx-0">
                <img
                    src="/about.png"
                    alt="Foto setengah badan Maulana Nur Anfajm"
                    class="block w-full aspect-[4/3] object-cover object-top rounded-2xl border border-line bg-white"
                    width="586"
                    height="426"
                    loading="lazy"
                    decoding="async"
                />
                <!-- coretan tangan: murni dekorasi, statis (tanpa animasi supaya scroll tetap ringan), menghindari area wajah -->
                <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 400 300" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <g stroke="#FA699E" stroke-width="3">
                        <path d="M38 24c0 11-6 17-17 17 11 0 17 6 17 17 0 -11 6-17 17-17-11 0-17-6-17-17z" fill="#FFE4EF" />
                        <path d="M16 262c12-12 22 10 34-2s22 10 34-2" />
                        <path d="M338 218c-8-14-30-6-24 9 5 12 24 18 24 18s19-6 24-18c6-15-16-23-24-9z" fill="#FFE4EF" transform="translate(6 10) rotate(8 338 230)" />
                    </g>
                    <g stroke="#7B5FA6" stroke-width="3">
                        <path d="M338 30c-26-14-52 10-38 32 14 21 52 12 52-14 0-24-36-34-58-14" />
                        <path d="M34 86c10 4 14 14 10 24" />
                        <path d="M350 132c-18 6-34 2-42-10m0 0l4 14m-4-14l14-3" />
                        <path d="M366 262l8-12 8 12 8-12" />
                    </g>
                    <g stroke="#E8A020" stroke-width="3">
                        <path d="M372 96l0 14m-7-7l14 0" />
                        <path d="M78 36l0 10m-5-5l10 0" />
                        <circle cx="26" cy="140" r="3" fill="#FFD66B" />
                        <circle cx="378" cy="180" r="3" fill="#FFD66B" />
                    </g>
                    <text x="22" y="190" font-family="JetBrains Mono, monospace" font-size="22" font-weight="600" fill="#BE2D65" stroke="none" transform="rotate(-10 22 190)">&lt;/&gt;</text>
                    <text x="330" y="282" font-family="JetBrains Mono, monospace" font-size="20" font-weight="600" fill="#7B5FA6" stroke="none" transform="rotate(7 330 282)">&#123; &#125;</text>
                </svg>
            </div>
            <dl class="glass-card rounded-2xl p-5 flex flex-col gap-4 text-sm">
                {FACTS.map((f) => (
                    <div>
                        <dt class="font-mono text-xs uppercase tracking-wider text-ink-muted">{f.label}</dt>
                        <dd class="mt-1 font-medium text-ink">{f.value}</dd>
                    </div>
                ))}
            </dl>
        </div>

        <!-- Teks -->
        <div class="flex flex-col gap-6">
            <div data-reveal>
                <p class="text-xs font-semibold tracking-widest uppercase text-rose-deep mb-2">Tentang saya</p>
                <h2 id="about-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink">
                    Senang di balik layar aplikasi
                </h2>
            </div>

            <div class="flex flex-col gap-4 text-base leading-relaxed text-ink-muted">
                <p>
                    Halo, saya Maulana Nur Anfajm, mahasiswa Sistem Informasi semester 7 di Universitas Gunadarma,
                    Jakarta. Yang paling saya suka dari sebuah aplikasi justru bagian yang jarang kelihatan oleh
                    pengguna: logika di server dan cara datanya disimpan.
                </p>
                <p>
                    <strong class="font-semibold text-ink">Hii Stranger</strong> adalah proyek capstone tim kami,
                    toko online streetwear untuk klien nyata. Di sana saya memegang backend Go, terutama
                    penguncian stok saat checkout. Proyek pribadi saya, <strong class="font-semibold text-ink">Ruang Rasa</strong>,
                    adalah backend reservasi restoran dengan Rust (Axum) dan PostgreSQL yang masih saya kembangkan
                    di komputer sendiri. Yang ketiga, Laundry Lastri (Laravel), saya buat sebagai bahan Penulisan Ilmiah.
                </p>
            </div>

            <ul class="grid gap-4 sm:grid-cols-2" aria-label="Cara saya bekerja">
                {WAYS.map((w) => (
                    <li class="glass-card lift rounded-2xl p-5" data-reveal>
                        <span class="grid h-10 w-10 place-items-center rounded-xl bg-lavender-soft text-lavender-deep" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-5 w-5"
                            >
                                <path d={w.d} />
                            </svg>
                        </span>
                        <h3 class="mt-4 font-bold text-ink">{w.title}</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{w.desc}</p>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>
