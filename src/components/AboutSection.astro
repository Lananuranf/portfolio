---
// src/components/AboutSection.astro — HTML statis (tanpa JS), mudah dibaca mesin pencari.
const FACTS = [
    { label: "Pendidikan", value: "S1 Sistem Informasi, Universitas Gunadarma (semester 7)" },
    { label: "Domisili", value: "Jakarta, Indonesia" },
    { label: "Sedang dikerjakan", value: "Ruang Rasa, backend reservasi restoran" },
];

const WAYS = [
    {
        title: "Urai masalahnya dulu",
        desc: "Sebelum menulis kode, saya cari tahu dulu data apa yang dibutuhkan dan siapa yang boleh mengaksesnya. Kodenya saya pisah ke handler, service, dan repository supaya tiap bagian tetap kecil.",
        d: "M9.5 3h5M12 3v3m-6.4 2.6L4 7m14.4 1.6L20 7M12 21a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15zm0-11v4l2.5 2",
    },
    {
        title: "Belajar mandiri",
        desc: "Go dan Rust saya pelajari sendiri dari dokumentasi resmi, lalu langsung saya pakai di proyek. Awalnya memang lebih lambat. Tapi dengan begitu saya paham alasan di balik tiap pilihan.",
        d: "M12 6.5C10.3 5 7.9 4.5 4 4.5v13c3.9 0 6.3.5 8 2 1.7-1.5 4.1-2 8-2v-13c-3.9 0-6.3.5-8 2zm0 0v13",
    },
    {
        title: "Menulis supaya bisa diulang",
        desc: "Langkah setup dan deploy saya catat di README supaya proyeknya bisa dijalankan ulang tanpa menebak. Sebagian catatan itu kemudian saya kembangkan jadi artikel di blog ini.",
        d: "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5zm0 0v5h5M9 13h6M9 17h4",
    },
    {
        title: "Disiplin sebagai solo developer",
        desc: "Karena kerja sendiri, saya membiasakan commit kecil dengan pesan yang jelas. Deploy saya serahkan ke GitHub Actions supaya tidak ada langkah manual yang terlewat.",
        d: "M9 12.5l2 2 4-4.5M12 3l7 3v5.5c0 4.3-2.9 8-7 9.5-4.1-1.5-7-5.2-7-9.5V6l7-3z",
    },
];
---

<section id="about" class="glass-scene scene-sky px-5 md:px-12 py-20 md:py-28 bg-white border-y border-line" aria-labelledby="about-heading">
    <div class="max-w-5xl mx-auto grid gap-12 md:grid-cols-[18rem_1fr] md:gap-14">
        <!-- Foto + fakta singkat -->
        <div class="flex flex-col gap-5" data-reveal>
            <img
                src="/about.png"
                alt="Foto setengah badan Maulana Nur Anfajm"
                class="block w-full max-w-sm mx-auto md:max-w-none md:mx-0 aspect-[4/3] object-cover object-top rounded-2xl border border-line bg-white"
                width="586"
                height="426"
                loading="lazy"
                decoding="async"
            />
            <dl class="glass-card rounded-2xl p-5 flex flex-col gap-4 text-sm">
                {FACTS.map((f) => (
                    <div>
                        <dt class="font-mono text-xs uppercase tracking-wider text-ink-muted">{f.label}</dt>
                        <dd class="mt-1 font-medium text-ink">{f.value}</dd>
                    </div>
                ))}
            </dl>
        </div>

        <!-- Teks -->
        <div class="flex flex-col gap-6">
            <div data-reveal>
                <p class="text-xs font-semibold tracking-widest uppercase text-rose-deep mb-2">Tentang saya</p>
                <h2 id="about-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink">
                    Senang di balik layar aplikasi
                </h2>
            </div>

            <div class="flex flex-col gap-4 text-base leading-relaxed text-ink-muted">
                <p>
                    Saya Maulana Nur Anfajm, mahasiswa Sistem Informasi semester 7 di Universitas Gunadarma,
                    Jakarta. Bagian aplikasi yang paling saya suka justru yang jarang dilihat pengguna, yaitu
                    logika di server dan cara datanya disimpan.
                </p>
                <p>
                    Ruang Rasa saya kerjakan sendiri sampai berjalan di VPS Ubuntu. Dua proyek lain berasal dari kuliah:
                    backend toko online Hii Stranger (proyek capstone tim, Go) dan Laundry Lastri (Laravel), yang menjadi bahan Penulisan Ilmiah saya.
                    <strong class="font-semibold text-ink">Ruang Rasa</strong> juga proyek terbaru saya, backend
                    reservasi restoran yang saya tulis dengan Rust (Axum) dan PostgreSQL/PostGIS.
                </p>
            </div>

            <ul class="grid gap-4 sm:grid-cols-2" aria-label="Cara saya bekerja">
                {WAYS.map((w) => (
                    <li class="glass-card lift rounded-2xl p-5" data-reveal>
                        <span class="grid h-10 w-10 place-items-center rounded-xl bg-lavender-soft text-lavender-deep" aria-hidden="true">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-5 w-5"
                            >
                                <path d={w.d} />
                            </svg>
                        </span>
                        <h3 class="mt-4 font-bold text-ink">{w.title}</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{w.desc}</p>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>
