---
// src/components/SkillsSection.astro
// Keahlian backend. Ikon dari src/lib/icons.ts (di-inline saat build).
import { techIcon } from "../lib/icons";

interface Skill { name: string; icon: string; note?: string }
interface Group { title: string; desc: string; skills: Skill[] }

const GROUPS: Group[] = [
  {
    title: "Bahasa & Framework Backend",
    desc: "REST API dan layanan backend yang saya bangun dan rawat sendiri.",
    skills: [
      { name: "Go", icon: "Go" },
      { name: "Fiber", icon: "Go Fiber" },
      { name: "Gin", icon: "Go Gin" },
      { name: "Rust", icon: "Rust" },
      { name: "Axum", icon: "Axum" },
      { name: "Tokio", icon: "Tokio" },
      { name: "PHP", icon: "PHP" },
      { name: "Laravel", icon: "Laravel" },
    ],
  },
  {
    title: "Database",
    desc: "Desain skema relasional, migrasi berversi, dan indeks untuk query.",
    skills: [
      { name: "PostgreSQL", icon: "PostgreSQL" },
      { name: "PostGIS", icon: "PostGIS" },
      { name: "SQLx", icon: "SQLx" },
      { name: "GORM", icon: "GORM" },
      { name: "Redis", icon: "Redis" },
    ],
  },
  {
    title: "Infrastruktur & Deploy",
    desc: "Container, reverse proxy, CI/CD, dan server Linux di cloud.",
    skills: [
      { name: "Docker", icon: "Docker" },
      { name: "Docker Compose", icon: "Docker Compose" },
      { name: "AWS EC2", icon: "AWS EC2" },
      { name: "Nginx", icon: "Nginx" },
      { name: "Caddy", icon: "Caddy" },
      { name: "GitHub Actions", icon: "GitHub Actions" },
      { name: "Linux", icon: "Linux" },
      { name: "Ubuntu", icon: "Ubuntu" },
    ],
  },
  {
    title: "Tools & Integrasi",
    desc: "Kontrol versi, uji API, autentikasi, notifikasi, dan penyimpanan objek.",
    skills: [
      { name: "Git", icon: "Git" },
      { name: "Postman", icon: "Postman" },
      { name: "OpenAPI", icon: "OpenAPI" },
      { name: "WebSocket", icon: "WebSocket" },
      { name: "JWT", icon: "JWT" },
      { name: "FCM", icon: "Firebase Cloud Messaging" },
      { name: "Cloudflare R2", icon: "Cloudflare R2" },
      { name: "MinIO (S3)", icon: "MinIO" },
    ],
  },
];

// Ikon: path SVG outline 24x24 (stroke), sama gaya untuk semua kartu.
const SOFT_SKILLS: { name: string; note: string; icon: string }[] = [
  {
    name: "Manajemen Waktu",
    note: "Kuliah semester 7 sambil menyelesaikan 3 proyek backend",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  },
  {
    name: "Scrum / Agile",
    note: "Ruang Rasa dikerjakan per sprint, satu sprint satu milestone",
    icon: '<path d="M4 12a8 8 0 0 1 14-5.3"/><path d="M18 3v4h-4"/><path d="M20 12a8 8 0 0 1-14 5.3"/><path d="M6 21v-4h4"/>',
  },
  {
    name: "Manajemen Prioritas",
    note: "Scope Ruang Rasa dipangkas sesuai budget, fitur inti dulu",
    icon: '<path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h5"/>',
  },
  {
    name: "Problem Solving",
    note: "250+ test otomatis untuk melacak dan mengunci bug di backend",
    icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  },
  {
    name: "Belajar Mandiri",
    note: "Belajar Go, lalu Rust, dari dokumentasi resmi",
    icon: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 21V5"/>',
  },
  {
    name: "Komunikasi Tertulis",
    note: "README, kontrak API, dan 4 artikel teknis di blog",
    icon: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13 7 4 4"/>',
  },
];
---

<section id="skills" class="glass-scene py-24 px-6 bg-surface" aria-labelledby="skills-heading">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-12" data-reveal>
      <p class="text-xs font-semibold tracking-widest text-rose-deep uppercase mb-2">Yang saya pakai</p>
      <h2 id="skills-heading" class="text-4xl font-extrabold text-ink mb-3">
        <span class="text-gradient-brand">Keahlian</span> Backend
      </h2>
      <p class="text-ink-muted text-sm max-w-xl mx-auto">
        Alat yang saya pakai untuk membangun API, mengelola database,
        dan deploy layanan ke server.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {GROUPS.map((g) => (
        <div class="glass-card lift min-w-0 rounded-2xl p-4 sm:p-6" data-reveal data-tilt>
          <h3 class="font-bold text-ink">{g.title}</h3>
          <p class="text-xs text-ink-muted mt-1 mb-5">{g.desc}</p>
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-2.5 list-none p-0 m-0">
            {g.skills.map((s) => {
              const icon = techIcon(s.icon);
              return (
                <li class="min-w-0 flex items-center gap-2 sm:gap-3 px-2.5 sm:px-3 py-2.5 rounded-xl border border-line bg-white text-[13px] sm:text-sm font-medium text-ink transition-colors hover:border-pink-brand hover:bg-pink-soft/40">
                  {icon ? (
                    <span class="w-7 h-7 sm:w-8 sm:h-8 flex-shrink-0 flex items-center justify-center [&>svg]:w-6 [&>svg]:h-6 sm:[&>svg]:w-7 sm:[&>svg]:h-7" set:html={icon.svg} />
                  ) : (
                    <span class="w-7 h-7 sm:w-8 sm:h-8 flex-shrink-0 rounded-lg bg-lavender-soft" aria-hidden="true" />
                  )}
                  <span class="min-w-0 leading-tight [overflow-wrap:anywhere]">{s.name}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10">
      <p class="text-center text-xs font-semibold tracking-widest text-ink-muted uppercase mb-4">Soft skill</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 list-none p-0 m-0">
        {SOFT_SKILLS.map((s) => (
          <li class="glass-card lift flex items-start gap-3 p-4 rounded-2xl" data-reveal>
            <span class="w-9 h-9 flex-shrink-0 flex items-center justify-center rounded-xl bg-lavender-soft text-lavender-deep" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </span>
            <span class="min-w-0 [overflow-wrap:anywhere]">
              <span class="block text-sm font-bold text-ink leading-tight">{s.name}</span>
              <span class="block text-xs text-ink-muted mt-1 leading-snug">{s.note}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
