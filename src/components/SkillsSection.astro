---
// src/components/SkillsSection.astro
// Ikon brand diambil dari paket `simple-icons` dan di-inline saat build,
// jadi tidak ada request/JS tambahan di browser.
import {
  siJavascript, siTypescript, siReact, siTailwindcss, siVite, siAstro,
  siGo, siPostgresql, siPostman,
  siGit, siDocker, siNginx, siUbuntu, siGithubactions,
  siPython, siPandas, siNumpy, siScikitlearn, siStreamlit, siJupyter,
  siTrivy, siOwasp,
} from "simple-icons";

interface Icon { path: string; hex: string }
interface Skill { name: string; icon?: Icon; fallback?: string; learning?: boolean }
interface Group { title: string; desc: string; skills: Skill[] }

const GROUPS: Group[] = [
  {
    title: "Frontend",
    desc: "Membuat tampilan web yang responsif.",
    skills: [
      { name: "JavaScript", icon: siJavascript },
      { name: "TypeScript", icon: siTypescript },
      { name: "React", icon: siReact },
      { name: "Tailwind CSS", icon: siTailwindcss },
      { name: "Vite", icon: siVite },
      { name: "Astro", icon: siAstro },
    ],
  },
  {
    title: "Backend & Database",
    desc: "REST API sederhana dan desain tabel relasional.",
    skills: [
      { name: "Go (Fiber, Gin)", icon: siGo },
      { name: "PostgreSQL", icon: siPostgresql },
      { name: "Postman", icon: siPostman },
    ],
  },
  {
    title: "Deploy & DevOps",
    desc: "Deploy aplikasi ke server dan otomatisasi CI/CD.",
    skills: [
      { name: "Git", icon: siGit },
      { name: "Docker", icon: siDocker },
      { name: "Linux (Ubuntu)", icon: siUbuntu },
      { name: "Nginx", icon: siNginx },
      { name: "GitHub Actions", icon: siGithubactions },
      { name: "AWS EC2", fallback: "AWS" },
    ],
  },
  {
    title: "Data Science",
    desc: "Olah data, visualisasi, dan model ML dasar.",
    skills: [
      { name: "Python", icon: siPython },
      { name: "Pandas", icon: siPandas },
      { name: "NumPy", icon: siNumpy },
      { name: "scikit-learn", icon: siScikitlearn },
      { name: "Streamlit", icon: siStreamlit },
      { name: "Jupyter", icon: siJupyter },
    ],
  },
  {
    title: "Keamanan (dasar)",
    desc: "Security scanning di pipeline CI/CD — masih terus belajar.",
    skills: [
      { name: "GitLeaks", fallback: "GL", learning: true },
      { name: "Trivy", icon: siTrivy, learning: true },
      { name: "OWASP ZAP", icon: siOwasp, learning: true },
    ],
  },
];
---

<section id="skills" class="py-24 px-6 bg-slate-50" aria-labelledby="skills-heading">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-12">
      <p class="text-xs font-semibold tracking-widest text-slate-400 uppercase mb-2">Yang saya pakai</p>
      <h2 id="skills-heading" class="text-4xl font-extrabold text-slate-900 mb-3">Keahlian</h2>
      <p class="text-slate-500 text-sm max-w-xl mx-auto">
        Teknologi yang sudah saya pakai di proyek kuliah maupun proyek pribadi.
        Yang bertanda <span class="font-semibold text-amber-600">belajar</span> masih saya dalami.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {GROUPS.map((g) => (
        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:last:col-span-2">
          <h3 class="font-bold text-slate-900">{g.title}</h3>
          <p class="text-xs text-slate-500 mt-1 mb-4">{g.desc}</p>
          <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
            {g.skills.map((s) => (
              <li class="flex items-center gap-2 pl-2 pr-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-sm text-slate-700 hover:border-slate-400 transition-colors">
                {s.icon ? (
                  <svg viewBox="0 0 24 24" class="w-4 h-4 flex-shrink-0" fill={`#${s.icon.hex}`} aria-hidden="true">
                    <path d={s.icon.path} />
                  </svg>
                ) : (
                  <span class="w-4 h-4 flex-shrink-0 rounded bg-slate-800 text-[7px] font-bold text-amber-400 flex items-center justify-center leading-none" aria-hidden="true">
                    {s.fallback}
                  </span>
                )}
                {s.name}
                {s.learning && (
                  <span class="text-[10px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 rounded px-1.5 py-0.5">belajar</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>
