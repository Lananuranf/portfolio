---
// src/components/BlogTeaser.astro — 3 artikel terbaru, kartu bento (data dari src/data/posts.ts)
import { POSTS as ALL_POSTS } from "../data/posts";
const POSTS = ALL_POSTS.slice(0, 3);
---

<section id="blog" class="lazy-section glass-scene px-5 md:px-12 py-16 md:py-20" aria-labelledby="blog-heading">
    <div class="max-w-5xl mx-auto">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between mb-6" data-reveal>
            <div>
                <p class="section-eyebrow mb-2">Blog</p>
                <h2 id="blog-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink">
                    Catatan teknis
                </h2>
            </div>
            <a
                href="/blog/"
                class="btn-secondary shrink-0 self-start md:self-auto"
            >
                Semua artikel <span aria-hidden="true">→</span>
            </a>
        </div>

        <ul class="grid gap-4 md:grid-cols-3 md:grid-rows-2">
            {POSTS.map((post, i) => (
                <li
                    data-reveal
                    class:list={[
                        "glass-card bento flex flex-col gap-3",
                        i === 0 ? "lift md:col-span-2 md:row-span-2 md:gap-5 md:p-8" : i === 1 ? "tilt-a" : "tilt-b",
                    ]}
                >
                    <p class="flex flex-wrap items-center gap-2 font-mono text-xs text-ink-muted">
                        {post.tags[0] && <span class="rounded-full bg-pink-soft px-2.5 py-0.5 font-sans font-semibold text-rose-deep">{post.tags[0]}</span>}
                        <span>{post.date}</span>
                        {post.readTime && <span aria-hidden="true">·</span>}
                        {post.readTime && <span>{post.readTime}</span>}
                    </p>
                    <h3 class:list={["font-semibold leading-snug text-ink", i === 0 ? "text-xl md:text-3xl" : "text-base"]}>
                        {post.published ? (
                            <a href={post.slug} class="after:absolute after:inset-0 hover:text-rose-deep transition-colors">
                                {post.title}
                            </a>
                        ) : (
                            <span>{post.title} <span class="ml-1 text-xs font-medium text-ink-muted">(segera terbit)</span></span>
                        )}
                    </h3>
                    {i === 0 && <p class="text-sm leading-relaxed text-ink-muted md:text-lg">{post.excerpt}</p>}
                    {post.published && (
                        <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-rose-deep" aria-hidden="true">Baca <span>→</span></span>
                    )}
                </li>
            ))}
        </ul>
    </div>
</section>
