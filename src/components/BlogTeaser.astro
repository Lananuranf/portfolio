---
// src/components/BlogTeaser.astro — 3 artikel terbaru, daftar ringkas (data dari src/data/posts.ts)
import { POSTS as ALL_POSTS } from "../data/posts";
const POSTS = ALL_POSTS.slice(0, 3);
---

<section id="blog" class="px-5 md:px-12 py-20 md:py-28 bg-surface" aria-labelledby="blog-heading">
    <div class="max-w-5xl mx-auto">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between mb-6">
            <div>
                <p class="text-xs font-semibold tracking-widest uppercase text-rose-deep mb-2">Blog</p>
                <h2 id="blog-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-ink">
                    Catatan teknis
                </h2>
            </div>
            <a
                href="/blog/"
                class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-rose-deep hover:text-ink transition-colors"
            >
                Semua artikel <span aria-hidden="true">→</span>
            </a>
        </div>

        <ul class="divide-y divide-line border-y border-line">
            {POSTS.map((post) => (
                <li class="relative flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                    <h3 class="text-base font-semibold leading-snug text-ink">
                        {post.published ? (
                            <a href={post.slug} class="after:absolute after:inset-0 hover:text-rose-deep transition-colors">
                                {post.title}
                            </a>
                        ) : (
                            <span>{post.title} <span class="ml-1 text-xs font-medium text-ink-muted">(segera terbit)</span></span>
                        )}
                    </h3>
                    <p class="flex shrink-0 items-center gap-2 font-mono text-xs text-ink-muted">
                        <span>{post.date}</span>
                        {post.readTime && <span aria-hidden="true">·</span>}
                        {post.readTime && <span>{post.readTime}</span>}
                    </p>
                </li>
            ))}
        </ul>
    </div>
</section>
