---
// src/components/blog/CodeBlock.astro — blok kode dengan label file & tombol salin.
// Isi kode dirender sebagai teks (otomatis di-escape), jadi aman untuk karakter < > & $.
interface Props { code: string; label?: string }
const { code, label = "Terminal" } = Astro.props;
---

<figure class="not-prose my-5 rounded-2xl overflow-hidden bg-slate-900 shadow-lg shadow-slate-900/10 ring-1 ring-slate-900/10" data-code-block>
  <figcaption class="flex items-center justify-between px-4 py-2 bg-slate-800/80 border-b border-white/5">
    <span class="text-xs font-medium text-slate-300 font-mono">{label}</span>
    <button type="button" data-copy
      class="text-xs font-medium text-slate-300 hover:text-white px-2 py-1 rounded-md hover:bg-white/10 transition-colors">
      Salin
    </button>
  </figcaption>
  <pre class="p-4 overflow-x-auto text-[13px] leading-relaxed text-slate-100"><code>{code}</code></pre>
</figure>
