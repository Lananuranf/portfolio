---
// src/components/blog/ArticleLayout.astro — kerangka semua artikel blog:
// SEO + schema, header, statistik pembaca real-time, dan progres baca.
import BaseLayout from "../../layouts/BaseLayout.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import {
    countWords,
    readingMinutes,
    WORDS_PER_MINUTE,
} from "../../lib/readingTime";

interface Props {
    slug: string; // contoh: "go-fiber-vs-nodejs-performa"
    file: string; // path file halaman, untuk menghitung jumlah kata
    title: string;
    /** Judul pendek untuk <title> (maks. 60 karakter, termasuk " | Lananuranf"). */
    seoTitle?: string;
    desc: string;
    datePublished: string; // YYYY-MM-DD
    dateModified?: string;
    dateLabel: string; // contoh: "28 April 2026"
    category: string;
    tags: string[];
    keywords: string;
}

const {
    slug,
    file,
    title,
    seoTitle,
    desc,
    datePublished,
    dateModified = datePublished,
    dateLabel,
    category,
    tags,
    keywords,
} = Astro.props;
const url = `https://lananuranf.my.id/blog/${slug}/`;
const wordCount = countWords(file);
const readMinutes = readingMinutes(wordCount);

const articleSchema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    // Google menyarankan headline maks. 110 karakter.
    headline: title.length <= 110 ? title : (seoTitle?.replace(/ \| Lananuranf$/, "") ?? title.slice(0, 110)),
    description: desc,
    url: url,
    image: "https://lananuranf.my.id/og-image.png",
    datePublished: datePublished,
    dateModified: dateModified,
    inLanguage: "id",
    author: {
        "@type": "Person",
        name: "Maulana Nur Anfajm",
        alternateName: "Lananuranf",
        url: "https://lananuranf.my.id/",
    },
    publisher: { "@type": "Person", name: "Maulana Nur Anfajm", url: "https://lananuranf.my.id/" },
    isPartOf: { "@type": "Blog", name: "Blog Lananuranf", url: "https://lananuranf.my.id/blog/" },
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    keywords: keywords,
    articleSection: category,
    wordCount: String(wordCount),
    timeRequired: `PT${readMinutes}M`,
});
---

<BaseLayout
    title={seoTitle ?? `${title} | Lananuranf`}
    description={desc}
    canonicalURL={url}
    ogType="article"
    publishedTime={`${datePublished}T08:00:00+07:00`}
    modifiedTime={`${dateModified}T08:00:00+07:00`}
    breadcrumbs={[
        { name: "Blog", url: "https://lananuranf.my.id/blog/" },
        { name: title, url },
    ]}
    extraSchema={articleSchema}
>
    <MainLayout />

    <!-- Progres baca -->
    <div class="fixed top-0 left-0 right-0 h-1 z-60" aria-hidden="true">
        <div
            id="read-progress"
            class="h-full w-0 bg-gradient-brand"
        ></div>
    </div>

    <main id="main-content" class="pt-20 bg-surface min-h-screen">
        <div class="max-w-6xl mx-auto lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-8 lg:px-6">
        <article
            id="article-body"
            data-words={wordCount}
            data-wpm={WORDS_PER_MINUTE}
            data-slug={slug}
            class="max-w-3xl mx-auto px-5 md:px-6 py-12 md:py-14"
        >
            <a
                href="/blog/"
                class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-rose-deep transition-colors mb-8"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-4 h-4"
                    aria-hidden="true"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"
                    />
                </svg>
                Kembali ke Blog
            </a>

            <header class="mb-10">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-4 text-xs text-ink-muted">
                    <span class="font-semibold px-2.5 py-1 rounded-full bg-pink-soft text-rose-deep ring-1 ring-pink-brand/50">
                        {category}
                    </span>
                    <time datetime={datePublished}>{dateLabel}</time>
                    <span aria-hidden="true">·</span>
                    <span title={`${wordCount.toLocaleString("id-ID")} kata`}>
                        {readMinutes} menit baca
                    </span>
                </div>

                <h1 class="text-3xl md:text-[2.5rem] font-extrabold text-ink leading-tight tracking-tight mb-4">
                    {title}
                </h1>
                <p class="text-ink-muted text-base md:text-lg leading-relaxed">
                    {desc}
                </p>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mt-6 pt-6 border-t border-line">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-ink grid place-items-center text-white text-sm font-bold shadow-md shadow-ink/20">
                            L
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-ink">
                                Maulana Nur Anfajm
                            </p>
                            <p class="text-xs text-ink-muted">
                                Backend Engineer
                            </p>
                        </div>
                    </div>

                    <!-- Statistik pembaca real-time (angka "—" bila layanan belum merespons) -->
                    <div
                        id="live-stats"
                        class="flex flex-wrap items-center gap-2 text-xs"
                    >
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white ring-1 ring-line text-ink-muted shadow-sm">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                class="w-3.5 h-3.5"
                                aria-hidden="true"
                            >
                                <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <span>
                                <b data-stat="views" class="text-ink">
                                    —
                                </b>{" "}
                                kali dibaca
                            </span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-lavender-soft ring-1 ring-lavender text-lavender-deep shadow-sm">
                            <span class="relative flex w-2 h-2">
                                <span class="absolute inset-0 rounded-full bg-rose-brand animate-ping opacity-75"></span>
                                <span class="relative w-2 h-2 rounded-full bg-rose-brand"></span>
                            </span>
                            <span>
                                <b data-stat="live">—</b> sedang membaca
                            </span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white ring-1 ring-line text-ink-muted shadow-sm">
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                class="w-3.5 h-3.5"
                                aria-hidden="true"
                            >
                                <circle cx="12" cy="12" r="9" />
                                <path d="M12 7v5l3 2" />
                            </svg>
                            <span>
                                Terakhir dibaca{" "}
                                <b data-stat="last" class="text-ink">
                                    —
                                </b>
                            </span>
                        </span>
                    </div>
                </div>
            </header>

            <!-- Daftar isi (mobile/tablet), diisi oleh skrip dari h2/h3 -->
            <details id="toc-mobile" hidden class="lg:hidden glass-card rounded-2xl mb-8 overflow-hidden">
                <summary class="flex items-center justify-between gap-3 px-4 py-3 cursor-pointer select-none text-sm font-semibold text-ink list-none">
                    Daftar isi
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toc-chevron w-4 h-4 transition-transform motion-reduce:transition-none" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                </summary>
                <ol data-toc-list class="px-2 pb-3 flex flex-col gap-0.5"></ol>
            </details>

            <div
                id="article-prose"
                class="article-prose prose prose-slate max-w-none
                  prose-headings:font-extrabold prose-headings:text-ink prose-headings:tracking-tight
                  prose-h2:mt-12 prose-h2:mb-4 prose-h3:mt-8
                  prose-a:text-rose-deep prose-a:no-underline hover:prose-a:underline
                  prose-code:before:content-none prose-code:after:content-none prose-code:bg-pink-soft prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-medium prose-code:text-ink
                  prose-li:my-1"
            >
                <slot />
            </div>

            <div class="flex flex-wrap gap-2 mt-12 pt-8 border-t border-line">
                {tags.map((t) => (
                    <span class="text-xs font-medium px-3 py-1.5 bg-white ring-1 ring-line text-ink-muted rounded-full">
                        {t}
                    </span>
                ))}
            </div>

        </article>

        <!-- Daftar isi (desktop): sidebar lengket -->
        <aside id="toc-desktop" hidden aria-label="Daftar isi" class="hidden lg:block">
            <div class="sticky top-24 mt-12 md:mt-14 glass-card rounded-2xl p-3 max-h-[calc(100vh-8rem)] overflow-y-auto">
                <p class="px-2.5 pt-1 pb-2 text-xs font-semibold tracking-widest uppercase text-rose-deep">Daftar isi</p>
                <ol data-toc-list class="flex flex-col gap-0.5"></ol>
            </div>
        </aside>
        </div>
    </main>

    <button id="to-top" type="button" aria-label="Kembali ke atas" title="Kembali ke atas"
        class="to-top glass-card fixed right-4 z-40 w-11 h-11 rounded-full grid place-items-center text-rose-deep hover:text-ink">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="w-5 h-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m-6 6 6-6 6 6" /></svg>
    </button>
    <div id="blog-toast" role="status" aria-live="polite"
        class="blog-toast fixed left-1/2 z-[70] px-4 py-2 rounded-full bg-ink text-white text-xs font-medium shadow-lg max-w-[calc(100vw-2rem)]"></div>
</BaseLayout>

<script>
    import { relativeTime, sessionId } from "../../lib/liveStats";

    const article = document.getElementById(
        "article-body",
    ) as HTMLElement | null;

    // ── Garis progres baca di atas layar, dihitung dari posisi scroll ──
    const bar = document.getElementById("read-progress");
    if (article && bar) {
        let ticking = false;
        const update = () => {
            ticking = false;
            const rect = article.getBoundingClientRect();
            const scrollable = rect.height - window.innerHeight;
            const progress =
                scrollable > 0
                    ? Math.min(1, Math.max(0, -rect.top / scrollable))
                    : 1;
            bar.style.width = `${(progress * 100).toFixed(1)}%`;
        };
        const onScroll = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
    }

    // ── Statistik pembaca real-time ──
    const box = document.getElementById("live-stats");
    const slug = article?.dataset.slug;
    if (box && slug) {
        const el = (k: string) =>
            box.querySelector(`[data-stat="${k}"]`) as HTMLElement;
        const sid = sessionId();
        const hitKey = `viewed:${slug}`;
        let lastRead: number | null = null;
        let loaded = false;
        let timer: number | undefined;

        const render = () => {
            el("last").textContent = lastRead ? relativeTime(lastRead) : "—";
        };

        const beat = async () => {
            let hit = false;
            try {
                hit = !sessionStorage.getItem(hitKey);
            } catch {
                hit = true;
            }
            try {
                const r = await fetch("/api/views", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ slug, sid, hit }),
                    keepalive: true,
                });
                const d = await r.json();
                if (!r.ok || !d.enabled) {
                    return false;
                }
                if (hit) {
                    try {
                        sessionStorage.setItem(hitKey, "1");
                    } catch {}
                }
                el("views").textContent = Number(d.views).toLocaleString(
                    "id-ID",
                );
                el("live").textContent = String(Math.max(1, d.live));
                lastRead = d.lastRead;
                render();
                loaded = true;
                return true;
            } catch {
                return false;
            }
        };

        let disabled = false;
        const start = async () => {
            if (timer || disabled) return;
            timer = window.setInterval(beat, 15000);
            if ((await beat()) === false && !loaded) {
                disabled = true;
                stop();
            }
        };
        const stop = () => {
            clearInterval(timer);
            timer = undefined;
        };

        document.addEventListener("visibilitychange", () =>
            document.hidden ? stop() : start(),
        );
        window.setInterval(render, 30000);
        if (!document.hidden) start();
    }

    // ── Tombol salin di blok kode ──
    document
        .querySelectorAll<HTMLElement>("[data-code-block]")
        .forEach((fig) => {
            const btn = fig.querySelector<HTMLButtonElement>("[data-copy]");
            const code = fig.querySelector("code");
            btn?.addEventListener("click", async () => {
                try {
                    await navigator.clipboard.writeText(
                        code?.textContent ?? "",
                    );
                    btn.textContent = "Tersalin ✓";
                } catch {
                    btn.textContent = "Gagal menyalin";
                }
                setTimeout(() => (btn.textContent = "Salin"), 1800);
            });
        });

    // ── Interaksi artikel: daftar isi, jangkar heading, reveal, tombol ke atas ──
    {
        const root = document.documentElement;
        const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const prose = document.getElementById("article-prose");
        const toast = document.getElementById("blog-toast");
        let toastTimer: number | undefined;
        const showToast = (msg: string) => {
            if (!toast) return;
            toast.textContent = msg;
            toast.classList.add("is-shown");
            window.clearTimeout(toastTimer);
            toastTimer = window.setTimeout(() => toast.classList.remove("is-shown"), 1800);
        };

        const headings = prose
            ? Array.from(prose.querySelectorAll<HTMLHeadingElement>("h2, h3"))
            : [];
        const used = new Set<string>();
        const slugify = (t: string) =>
            t.toLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "bagian";

        const tocLinks: HTMLAnchorElement[][] = [];
        const lists = Array.from(document.querySelectorAll<HTMLOListElement>("[data-toc-list]"));
        const mobile = document.getElementById("toc-mobile") as HTMLDetailsElement | null;

        headings.forEach((h) => {
            const text = (h.textContent ?? "").trim();
            if (!h.id) {
                let id = slugify(text), i = 2;
                while (used.has(id) || document.getElementById(id)) id = `${slugify(text)}-${i++}`;
                h.id = id;
            }
            used.add(h.id);

            // Jangkar "#" — klik menyalin tautan ke bagian ini
            const a = document.createElement("a");
            a.href = `#${h.id}`;
            a.className = "h-anchor";
            a.textContent = "#";
            a.setAttribute("aria-label", `Salin tautan ke bagian: ${text}`);
            a.addEventListener("click", async (e) => {
                e.preventDefault();
                const url = `${location.origin}${location.pathname}#${h.id}`;
                history.replaceState(null, "", `#${h.id}`);
                h.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
                try {
                    await navigator.clipboard.writeText(url);
                    showToast("Tautan bagian disalin");
                } catch {
                    showToast("Gagal menyalin tautan");
                }
            });
            h.append(a);

            const group: HTMLAnchorElement[] = [];
            lists.forEach((ol) => {
                const li = document.createElement("li");
                const link = document.createElement("a");
                link.href = `#${h.id}`;
                link.textContent = text;
                link.className = h.tagName === "H3" ? "toc-link toc-sub" : "toc-link";
                link.addEventListener("click", (e) => {
                    e.preventDefault();
                    history.replaceState(null, "", `#${h.id}`);
                    h.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
                    if (mobile && ol.closest("#toc-mobile")) mobile.open = false;
                });
                li.append(link);
                ol.append(li);
                group.push(link);
            });
            tocLinks.push(group);
        });

        if (headings.length >= 2) {
            mobile?.removeAttribute("hidden");
            document.getElementById("toc-desktop")?.removeAttribute("hidden");
        }

        // Sorot bagian aktif
        const setActive = (idx: number) =>
            tocLinks.forEach((g, i) =>
                g.forEach((l) => {
                    l.classList.toggle("is-active", i === idx);
                    if (i === idx) l.setAttribute("aria-current", "location");
                    else l.removeAttribute("aria-current");
                }),
            );
        if (headings.length && "IntersectionObserver" in window) {
            const visible = new Set<Element>();
            const io = new IntersectionObserver(
                (entries) => {
                    for (const en of entries) en.isIntersecting ? visible.add(en.target) : visible.delete(en.target);
                    let idx = -1;
                    if (visible.size) {
                        idx = headings.findIndex((h) => visible.has(h));
                    } else {
                        // tidak ada heading di zona baca: pakai heading terakhir di atas layar
                        headings.forEach((h, i) => { if (h.getBoundingClientRect().top < 120) idx = i; });
                    }
                    if (idx >= 0) setActive(idx);
                },
                { rootMargin: "-88px 0px -60% 0px", threshold: 0 },
            );
            headings.forEach((h) => io.observe(h));
        }

        // Scroll reveal untuk heading, gambar/kode, callout, tabel
        if (prose && root.classList.contains("js-reveal") && "IntersectionObserver" in window) {
            const tableWraps = Array.from(prose.querySelectorAll("table")).map(
                (t) => (t.parentElement && t.parentElement !== prose ? t.parentElement : t) as HTMLElement,
            );
            const targets = Array.from(
                new Set([
                    ...prose.querySelectorAll<HTMLElement>(":scope > h2, :scope > h3, :scope > figure, [data-code-block], [data-callout], :scope > img"),
                    ...tableWraps,
                ]),
            ).filter((el) => !el.hasAttribute("data-reveal"));
            const rio = new IntersectionObserver(
                (entries) => {
                    for (const en of entries) {
                        if (en.isIntersecting) { en.target.classList.add("is-in"); rio.unobserve(en.target); }
                    }
                },
                { rootMargin: "0px 0px -8% 0px", threshold: 0.01 },
            );
            targets.forEach((el) => {
                el.setAttribute("data-reveal", "");
                // yang sudah terlihat (mis. dibuka lewat #jangkar) langsung tampil
                if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add("is-in");
                else rio.observe(el);
            });
        }

        // Tombol kembali ke atas
        const top = document.getElementById("to-top");
        if (top) {
            let ticking = false;
            const check = () => {
                ticking = false;
                top.classList.toggle("is-shown", window.scrollY > 600);
            };
            window.addEventListener("scroll", () => {
                if (!ticking) { ticking = true; requestAnimationFrame(check); }
            }, { passive: true });
            check();
            top.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" });
            });
        }

        // Buka langsung ke #jangkar setelah id dibuat
        if (location.hash) {
            const t = document.getElementById(decodeURIComponent(location.hash.slice(1)));
            if (t && headings.includes(t as HTMLHeadingElement)) t.scrollIntoView({ block: "start" });
        }
    }
</script>
