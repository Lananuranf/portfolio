---
// src/components/blog/Callout.astro — kotak catatan: info, tips, peringatan, atau cek hasil.
interface Props { type?: "info" | "tip" | "warn" | "check"; title?: string }
const { type = "info", title } = Astro.props;
const STYLE = {
  info:  { box: "bg-sky-50 border-sky-200",         head: "text-sky-800",     label: "Catatan" },
  tip:   { box: "bg-violet-50 border-violet-200",   head: "text-violet-800",  label: "Tips" },
  warn:  { box: "bg-amber-50 border-amber-200",     head: "text-amber-800",   label: "Perhatian" },
  check: { box: "bg-emerald-50 border-emerald-200", head: "text-emerald-800", label: "Cek hasilnya" },
}[type];
---

<aside class={`not-prose my-6 rounded-2xl border p-5 text-sm leading-relaxed text-slate-700 ${STYLE.box}`}>
  <p class={`font-semibold mb-1.5 ${STYLE.head}`}>{title ?? STYLE.label}</p>
  <div class="[&_code]:bg-white/70 [&_code]:px-1 [&_code]:rounded [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_p+p]:mt-2"><slot /></div>
</aside>
