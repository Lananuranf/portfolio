---
// src/components/blog/Callout.astro — kotak catatan: info, tips, peringatan, atau cek hasil.
// Dibedakan lewat warna garis kiri + label, semua dari palet brand.
interface Props { type?: "info" | "tip" | "warn" | "check"; title?: string }
const { type = "info", title } = Astro.props;
const STYLE = {
  info:  { box: "bg-lavender-soft/75 border-lavender",     head: "text-lavender-deep", label: "Catatan" },
  tip:   { box: "bg-pink-soft/75 border-pink-brand",       head: "text-rose-deep",     label: "Tips" },
  warn:  { box: "bg-pink-soft/75 border-rose-brand",       head: "text-rose-deep",     label: "Perhatian" },
  check: { box: "bg-white/75 border-lavender-deep",        head: "text-lavender-deep", label: "Cek hasilnya" },
}[type];
---

<aside data-callout class={`callout-glass not-prose my-6 rounded-2xl border border-l-4 p-5 text-sm leading-relaxed text-ink ${STYLE.box}`}>
  <p class={`font-semibold mb-1.5 ${STYLE.head}`}>{title ?? STYLE.label}</p>
  <div class="[&_code]:bg-white/80 [&_code]:px-1 [&_code]:rounded [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_p+p]:mt-2"><slot /></div>
</aside>
