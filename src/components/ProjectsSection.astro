---
// src/components/ProjectsSection.astro — Studi kasus detail, SEO-rich content
import { getRepoProof, formatBulanTahun, GITHUB_USER } from '../lib/github';

const PROJECTS = [
  {
    id: "letta-school",
    num: "01",
    title: "Web Management Letta School",
    subtitle: "Aplikasi Web Fullstack",
    category: "Software Engineering",
    repo: "letta-school" as string | undefined,
    accent: "from-cyan-500 to-blue-600",
    border: "border-cyan-200",
    techBadges: [
      { label:"React",      color:"bg-cyan-50 text-cyan-700 border-cyan-200" },
      { label:"Go Fiber",   color:"bg-sky-50 text-sky-700 border-sky-200" },
      { label:"PostgreSQL", color:"bg-blue-50 text-blue-700 border-blue-200" },
      { label:"Docker",     color:"bg-indigo-50 text-indigo-700 border-indigo-200" },
      { label:"AWS EC2",    color:"bg-orange-50 text-orange-700 border-orange-200" },
      { label:"GitHub Actions", color:"bg-green-50 text-green-700 border-green-200" },
    ],
    summary: "Sistem manajemen sekolah dengan login JWT dan pembagian hak akses (admin, guru, siswa). Di-deploy ke AWS EC2 memakai Docker, dengan pipeline GitHub Actions yang otomatis men-deploy setiap perubahan.",
    problem: "Sekolah Letta membutuhkan platform digital terpadu untuk mengelola data siswa, guru, absensi, dan laporan akademik — sebelumnya masih manual dengan spreadsheet yang rawan error dan tidak aman.",
    solution: "Membuat aplikasi web dengan backend Go Fiber, frontend React, dan database PostgreSQL. Hak akses dibagi menjadi tiga peran: admin, guru, dan siswa.",
    notes: "Middleware Go Fiber memvalidasi token JWT dan memeriksa peran pengguna di setiap endpoint. Setiap push ke branch main otomatis di-build dan di-deploy ke EC2 lewat GitHub Actions.",
  },
  {
    id: "ecommerce",
    num: "02",
    title: "Dockerized E-Commerce App",
    subtitle: "Aplikasi Web Fullstack · Docker",
    category: "Software Engineering",
    repo: "ecommerce-fullstack",
    accent: "from-violet-500 to-purple-600",
    border: "border-violet-200",
    techBadges: [
      { label:"React",      color:"bg-cyan-50 text-cyan-700 border-cyan-200" },
      { label:"Go Gin",     color:"bg-sky-50 text-sky-700 border-sky-200" },
      { label:"GORM",       color:"bg-slate-50 text-slate-700 border-slate-200" },
      { label:"PostgreSQL", color:"bg-blue-50 text-blue-700 border-blue-200" },
      { label:"Docker",     color:"bg-indigo-50 text-indigo-700 border-indigo-200" },
      { label:"Nginx",      color:"bg-green-50 text-green-700 border-green-200" },
      { label:"AWS EC2",    color:"bg-orange-50 text-orange-700 border-orange-200" },
    ],
    summary: "Aplikasi toko online dengan backend Go Gin + GORM, frontend React, dan PostgreSQL. Semua service dijalankan dengan Docker Compose di AWS EC2, dengan Nginx sebagai reverse proxy dan SSL.",
    problem: "Ingin belajar membuat aplikasi yang hasilnya sama persis di laptop maupun di server, tanpa setup manual yang berulang.",
    solution: "Kode backend dibagi menjadi tiga lapisan: handler (HTTP), service (logika bisnis), dan repository (akses database). Seluruh service didefinisikan di docker-compose.yml sehingga cukup satu perintah untuk menjalankannya.",
    notes: "Konfigurasi rahasia disimpan di file .env (tidak di-commit), data PostgreSQL disimpan di volume agar tidak hilang, dan setiap container punya health check.",
  },
  {
    id: "portfolio",
    num: "03",
    title: "Website Portfolio Pribadi",
    subtitle: "Website Statis · Performa & SEO",
    category: "Software Engineering",
    repo: undefined as string | undefined,
    accent: "from-slate-700 to-slate-900",
    border: "border-slate-200",
    techBadges: [
      { label:"Astro",        color:"bg-orange-50 text-orange-700 border-orange-200" },
      { label:"TypeScript",   color:"bg-blue-50 text-blue-700 border-blue-200" },
      { label:"React",        color:"bg-cyan-50 text-cyan-700 border-cyan-200" },
      { label:"Tailwind CSS", color:"bg-sky-50 text-sky-700 border-sky-200" },
      { label:"Vercel",       color:"bg-slate-50 text-slate-700 border-slate-200" },
    ],
    summary: "Website yang sedang Anda buka: portfolio dan blog teknis yang dibangun dengan Astro, React, dan Tailwind CSS, lalu di-deploy ke Vercel.",
    problem: "Butuh satu tempat yang cepat, mudah ditemukan di mesin pencari, dan mudah dirawat untuk menampilkan proyek, keahlian, dan tulisan teknis.",
    solution: "Halaman dirender statis dengan Astro sehingga hampir tanpa JavaScript; React hanya dipakai untuk bagian interaktif. Data proyek diambil dari GitHub API saat build, dan waktu baca artikel dihitung otomatis dari isinya.",
    notes: "Dilengkapi structured data (schema.org), sitemap, dan meta Open Graph. Ikon brand di-inline saat build agar tidak ada request tambahan di browser.",
  },
];

// Bukti kepemilikan diambil dari GitHub API saat build (tanggal repo dibuat & jumlah commit asli).
const proofs = await Promise.all(PROJECTS.map(p => p.repo ? getRepoProof(p.repo) : Promise.resolve(null)));
---

<section
  id="projects"
  class="px-6 py-24"
  style="background: linear-gradient(150deg,#fff1f2 0%,#ffe4e6 15%,#f8fafc 45%,#eff6ff 75%,#dbeafe 100%);"
  aria-labelledby="projects-heading"
>
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-14">
      <p class="text-sm font-semibold tracking-widest text-slate-400 uppercase mb-2">Yang pernah saya buat</p>
      <h2 id="projects-heading" class="text-4xl font-extrabold text-slate-900">Proyek</h2>
      <p class="text-slate-500 mt-2 text-sm max-w-xl mx-auto">
        Beberapa proyek yang saya kerjakan sendiri, lengkap dengan masalah, solusi, dan teknologi yang dipakai.
      </p>
    </div>

    <div class="flex flex-col gap-12">
      {PROJECTS.map((p, idx) => {
        const proof = proofs[idx];
        return (
        <article
          class={`bg-white rounded-3xl border ${p.border} shadow-sm overflow-hidden`}
          aria-labelledby={`project-title-${p.id}`}
        >
          <div class="flex flex-col lg:flex-row">

            <!-- Left: number + title + tech -->
            <div class="lg:w-2/5 p-6 md:p-8 flex flex-col gap-4">
              <div class="flex items-start gap-3">
                <span class={`text-3xl font-black text-transparent bg-clip-text bg-gradient-to-br ${p.accent} leading-none`}>
                  {p.num}
                </span>
                <div>
                  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">{p.category}</p>
                  <h3 id={`project-title-${p.id}`} class="text-xl font-bold text-slate-900 leading-snug mt-0.5">
                    {p.title}
                  </h3>
                  <p class="text-sm text-slate-500 mt-0.5">{p.subtitle}</p>
                </div>
              </div>

              <p class="text-slate-600 text-sm leading-relaxed">{p.summary}</p>

              <!-- Tech badges -->
              <div class="flex flex-wrap gap-1.5">
                {p.techBadges.map(t => (
                  <span class={`text-xs font-medium px-2.5 py-1 rounded-full border ${t.color}`}>{t.label}</span>
                ))}
              </div>

              <!-- Bukti pembuat (data asli dari GitHub) -->
              <div class="mt-auto pt-4 border-t border-slate-100">
                {proof ? (
                  <a href={proof.commitsUrl} target="_blank" rel="noopener noreferrer"
                    class="group flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/60 p-3 hover:border-slate-900 hover:bg-white transition-colors"
                    aria-label={`Riwayat commit ${GITHUB_USER} di repo ${proof.repo}`}>
                    <img src={`https://github.com/${GITHUB_USER}.png?size=80`} alt={`Avatar GitHub ${GITHUB_USER}`}
                      width="36" height="36" loading="lazy" class="w-9 h-9 rounded-full border border-slate-200 flex-shrink-0" />
                    <div class="min-w-0 flex-1">
                      <p class="text-xs font-semibold text-slate-800 truncate">
                        Dibuat oleh <span class="text-slate-900">@{GITHUB_USER}</span>
                        {proof.sharePct !== null && <span class="ml-1 text-emerald-600">· {proof.sharePct}% commit</span>}
                      </p>
                      <p class="text-[11px] text-slate-500 truncate">
                        {[
                          formatBulanTahun(proof.createdAt) && `Sejak ${formatBulanTahun(proof.createdAt)}`,
                          proof.myCommits !== null && `${proof.myCommits} commit`,
                          `github.com/${GITHUB_USER}/${proof.repo}`,
                        ].filter(Boolean).join(" · ")}
                      </p>
                    </div>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4 text-slate-400 group-hover:text-slate-900 flex-shrink-0" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
                  </a>
                ) : (
                  <div class="flex items-center gap-3 rounded-2xl border border-dashed border-slate-200 p-3">
                    <img src={`https://github.com/${GITHUB_USER}.png?size=80`} alt={`Avatar GitHub ${GITHUB_USER}`}
                      width="36" height="36" loading="lazy" class="w-9 h-9 rounded-full border border-slate-200 flex-shrink-0" />
                    <div>
                      <p class="text-xs font-semibold text-slate-800">Dibuat oleh @{GITHUB_USER}</p>
                      <p class="text-[11px] text-slate-500">Repositori privat</p>
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- Right: case study detail -->
            <div class="lg:w-3/5 p-6 md:p-8 bg-slate-50/50 border-t lg:border-t-0 lg:border-l border-slate-100 flex flex-col gap-4">
              <p class="text-xs font-bold tracking-widest text-slate-400 uppercase">Studi Kasus</p>

              <div>
                <p class="text-xs font-semibold text-rose-600 uppercase tracking-wide mb-1">Masalah</p>
                <p class="text-slate-600 text-sm leading-relaxed">{p.problem}</p>
              </div>

              <div>
                <p class="text-xs font-semibold text-emerald-600 uppercase tracking-wide mb-1">Solusi</p>
                <p class="text-slate-600 text-sm leading-relaxed">{p.solution}</p>
              </div>

              <div>
                <p class="text-xs font-semibold text-violet-600 uppercase tracking-wide mb-1">Catatan Teknis</p>
                <p class="text-slate-600 text-sm leading-relaxed">{p.notes}</p>
              </div>
            </div>

          </div>
        </article>
        );
      })}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href="/blog/" class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 text-white font-semibold rounded-xl hover:bg-slate-700 transition-colors text-sm">
        Baca artikel teknis saya →
      </a>
    </div>

  </div>
</section>
