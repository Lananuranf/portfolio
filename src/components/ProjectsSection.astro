---
// src/components/ProjectsSection.astro — Studi kasus proyek backend.
import { getRepoProof, formatBulanTahun, GITHUB_USER } from '../lib/github';
import { techIcon } from '../lib/icons';

interface Project {
  id: string;
  num: string;
  title: string;
  subtitle: string;
  repo?: string;
  detail?: string;
  tech: string[];
  summary: string;
  problem: string;
  built: string;
  result: string;
}

const PROJECTS: Project[] = [
  {
    id: "ruang-rasa",
    num: "01",
    title: "Ruang Rasa API",
    subtitle: "Reservasi & discovery restoran · Rust · VPS Ubuntu",
    repo: "ruang-rasa-app",
    detail: "/projects/ruang-rasa/",
    tech: ["Rust", "Axum", "PostgreSQL", "PostGIS", "WebSocket", "Docker Compose", "Caddy"],
    summary: "Backend untuk aplikasi Android Ruang Rasa yang menangani login OTP, pencarian restoran terdekat, reservasi meja, dan chat real-time.",
    problem: "Dua orang bisa memesan meja yang sama di jam yang sama, dan retry dari HP bisa membuat pesanan ganda.",
    built: "Workspace Rust empat crate di atas PostgreSQL 16 + PostGIS. Chat memakai WebSocket dan Postgres LISTEN/NOTIFY.",
    result: "Reservasi dikunci dengan SELECT … FOR UPDATE dan Idempotency-Key. Dari 50 request paralel untuk kursi terakhir, tepat 1 yang lolos.",
  },
  {
    id: "letta-school",
    num: "02",
    title: "Letta School API",
    subtitle: "Manajemen sekolah · Go Fiber · AWS EC2",
    repo: "letta-school",
    detail: "/projects/letta-school/",
    tech: ["Go Fiber", "PostgreSQL", "JWT", "Docker Compose", "Nginx", "AWS EC2", "GitHub Actions"],
    summary: "REST API manajemen sekolah dengan login JWT dan tiga peran, yaitu admin, guru, dan siswa.",
    problem: "Data siswa, absensi, dan nilai sebelumnya dikelola di spreadsheet tanpa kontrol akses.",
    built: "API Go Fiber dengan PostgreSQL. Middleware memeriksa JWT dan peran sebelum request sampai ke handler.",
    result: "Setiap push ke main ter-deploy ke EC2 lewat GitHub Actions dan Docker Compose. Versi baru aktif dalam 2–3 menit.",
  },
  {
    id: "ecommerce",
    num: "03",
    title: "Toko Online API",
    subtitle: "Backend toko online · Go Gin · AWS EC2",
    repo: "ecommerce-fullstack",
    tech: ["Go Gin", "GORM", "PostgreSQL", "Docker Compose", "Nginx", "AWS EC2"],
    summary: "Backend toko online dengan Go Gin dan GORM di atas PostgreSQL.",
    problem: "Setup manual harus diulang setiap kali pindah dari laptop ke server.",
    built: "Kode dibagi ke handler, service, dan repository. Database, API, dan Nginx ada di satu docker-compose.yml.",
    result: "Health check membuat API menunggu database siap. Seluruh stack menyala dengan satu perintah di laptop maupun di EC2.",
  },
];

const proofs = await Promise.all(PROJECTS.map(p => p.repo ? getRepoProof(p.repo) : Promise.resolve(null)));
---

<section id="projects" class="px-4 sm:px-6 py-24 bg-surface" aria-labelledby="projects-heading">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-12">
      <h2 id="projects-heading" class="text-4xl font-extrabold text-ink">Proyek <span class="text-gradient-brand">Backend</span></h2>
      <p class="text-ink-muted mt-3 text-sm max-w-xl mx-auto leading-relaxed">
        Tiga API yang saya kerjakan sendiri dari skema database sampai deploy.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {PROJECTS.map((p, idx) => {
        const proof = proofs[idx];
        const points = [
          { label: "Masalah", text: p.problem },
          { label: "Yang dibangun", text: p.built },
          { label: "Hasil", text: p.result },
        ];
        return (
        <article class="bg-white rounded-2xl border border-line shadow-sm p-6 flex flex-col gap-4" aria-labelledby={`project-title-${p.id}`}>
          <div class="flex items-start gap-3">
            <span class="text-2xl font-black text-gradient-brand leading-none">{p.num}</span>
            <div>
              <h3 id={`project-title-${p.id}`} class="text-lg font-bold text-ink leading-snug">{p.title}</h3>
              <p class="text-xs text-ink-muted mt-0.5">{p.subtitle}</p>
            </div>
          </div>

          <p class="text-ink-muted text-sm leading-relaxed">{p.summary}</p>

          <dl class="flex flex-col gap-2.5">
            {points.map(pt => (
              <div>
                <dt class="text-[11px] font-semibold text-rose-deep uppercase tracking-wide">{pt.label}</dt>
                <dd class="text-sm text-ink-muted leading-relaxed">{pt.text}</dd>
              </div>
            ))}
          </dl>

          <ul class="flex flex-wrap gap-1.5" aria-label="Teknologi">
            {p.tech.map(label => {
              const icon = techIcon(label);
              return (
                <li class="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full border border-line bg-surface text-ink">
                  {icon && <span class="w-3.5 h-3.5 shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={icon.svg} />}
                  {label}
                </li>
              );
            })}
          </ul>

          <div class="mt-auto pt-4 border-t border-line flex flex-col gap-3">
            {proof ? (
              <a href={proof.commitsUrl} target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-2 text-[11px] text-ink-muted hover:text-rose-deep transition-colors"
                aria-label={`Riwayat commit ${GITHUB_USER} di repo ${proof.repo}`}>
                <img src={`https://github.com/${GITHUB_USER}.png?size=48`} alt="" width="20" height="20" loading="lazy" class="w-5 h-5 rounded-full border border-line shrink-0" />
                <span class="truncate">
                  {[
                    `@${GITHUB_USER}`,
                    proof.myCommits !== null && `${proof.myCommits} commit`,
                    proof.sharePct !== null && `${proof.sharePct}% dari total`,
                    formatBulanTahun(proof.createdAt) && `sejak ${formatBulanTahun(proof.createdAt)}`,
                  ].filter(Boolean).join(" · ")}
                </span>
              </a>
            ) : (
              <p class="flex items-center gap-2 text-[11px] text-ink-muted">
                <img src={`https://github.com/${GITHUB_USER}.png?size=48`} alt="" width="20" height="20" loading="lazy" class="w-5 h-5 rounded-full border border-line shrink-0" />
                @{GITHUB_USER} · repositori privat
              </p>
            )}
            <div class="flex flex-wrap gap-2">
              {p.detail && (
                <a href={p.detail} class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-ink text-white text-xs font-semibold hover:bg-lavender-deep transition-colors">
                  Studi kasus <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </a>
              )}
              {proof && (
                <a href={`https://github.com/${GITHUB_USER}/${proof.repo}`} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-line text-ink text-xs font-semibold hover:border-rose-brand hover:text-rose-deep transition-colors">
                  Repo GitHub <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                </a>
              )}
            </div>
          </div>
        </article>
        );
      })}
    </div>

  </div>
</section>
